DESCRIPTION >
  Girilen oran profiline en benzer geçmiş maçları bulur.

  Similarity modeli:
  - Ham decimal odds profili
  - Normalize edilmiş implied probability profili

  Her market için:
      50% odds distance
      50% probability distance

  Marketler eşit ağırlıklıdır.

  Desteklenen marketler:
  - 1X2
  - O/U
  - BTTS
  - AH

  Kullanıcı tolerance veya min_score vermez.

  Önce coarse candidate seçilir.
  Ardından exact similarity hesaplanır.


NODE odds_similar_matches_query
SQL >
%
WITH

/* ============================================================
   TARGET 1X2
   ============================================================ */

(
    1.0 / {{Float64(home_odds)}}
) AS target_home_raw,

(
    1.0 / {{Float64(draw_odds)}}
) AS target_draw_raw,

(
    1.0 / {{Float64(away_odds)}}
) AS target_away_raw,

(
    target_home_raw
    + target_draw_raw
    + target_away_raw
) AS target_1x2_sum,

target_home_raw / target_1x2_sum AS target_home_p,
target_draw_raw / target_1x2_sum AS target_draw_p,
target_away_raw / target_1x2_sum AS target_away_p,


/* ============================================================
   TARGET O/U
   ============================================================ */

{% if defined(ou_line) %}

(
    1.0 / {{Float64(over_odds)}}
) AS target_ou_over_raw,

(
    1.0 / {{Float64(under_odds)}}
) AS target_ou_under_raw,

(
    target_ou_over_raw
    + target_ou_under_raw
) AS target_ou_sum,

target_ou_over_raw / target_ou_sum AS target_ou_over_p,
target_ou_under_raw / target_ou_sum AS target_ou_under_p,

{% end %}


/* ============================================================
   TARGET BTTS
   ============================================================ */

{% if defined(btts_yes_odds) %}

(
    1.0 / {{Float64(btts_yes_odds)}}
) AS target_btts_yes_raw,

(
    1.0 / {{Float64(btts_no_odds)}}
) AS target_btts_no_raw,

(
    target_btts_yes_raw
    + target_btts_no_raw
) AS target_btts_sum,

target_btts_yes_raw / target_btts_sum AS target_btts_yes_p,
target_btts_no_raw / target_btts_sum AS target_btts_no_p,

{% end %}


/* ============================================================
   TARGET AH
   ============================================================ */

{% if defined(ah_line) %}

(
    1.0 / {{Float64(ah_home_odds)}}
) AS target_ah_home_raw,

(
    1.0 / {{Float64(ah_away_odds)}}
) AS target_ah_away_raw,

(
    target_ah_home_raw
    + target_ah_away_raw
) AS target_ah_sum,

target_ah_home_raw / target_ah_sum AS target_ah_home_p,
target_ah_away_raw / target_ah_sum AS target_ah_away_p,

{% end %}


/* ============================================================
   CANDIDATES
   ============================================================ */

candidates AS
(
    SELECT

        match_id,
        country,
        league,
        season,

        home_team,
        away_team,

        date,
        time,

        ht_home,
        ht_away,

        ft_home,
        ft_away,

        result,
        ht_ft,

        home_odds,
        draw_odds,
        away_odds,

        ou1_5_over,
        ou1_5_under,
        ou2_5_over,
        ou2_5_under,
        ou3_5_over,
        ou3_5_under,
        ou4_5_over,
        ou4_5_under,

        btts_yes,
        btts_no,

        ah_line,
        ah_home,
        ah_away,

        /* ----------------------------------------------------
           HISTORICAL 1X2 PROBABILITY
           ---------------------------------------------------- */

        (
            1.0 / home_odds
        ) AS hist_home_raw,

        (
            1.0 / draw_odds
        ) AS hist_draw_raw,

        (
            1.0 / away_odds
        ) AS hist_away_raw,

        (
            (1.0 / home_odds)
            +
            (1.0 / draw_odds)
            +
            (1.0 / away_odds)
        ) AS hist_1x2_sum

    FROM betexplorer_matches

    PREWHERE
        has_odds = 'True'

        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}

        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}

        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}

    WHERE

        /* ----------------------------------------------------
           REQUIRED 1X2
           ---------------------------------------------------- */

        isNotNull(home_odds)
        AND isNotNull(draw_odds)
        AND isNotNull(away_odds)

        /* ----------------------------------------------------
           O/U
           ---------------------------------------------------- */

        {% if defined(ou_line) %}

        AND
        (
            (
                {{Float64(ou_line)}} = 1.5
                AND isNotNull(ou1_5_over)
                AND isNotNull(ou1_5_under)
            )

            OR

            (
                {{Float64(ou_line)}} = 2.5
                AND isNotNull(ou2_5_over)
                AND isNotNull(ou2_5_under)
            )

            OR

            (
                {{Float64(ou_line)}} = 3.5
                AND isNotNull(ou3_5_over)
                AND isNotNull(ou3_5_under)
            )

            OR

            (
                {{Float64(ou_line)}} = 4.5
                AND isNotNull(ou4_5_over)
                AND isNotNull(ou4_5_under)
            )
        )

        {% end %}

        /* ----------------------------------------------------
           BTTS
           ---------------------------------------------------- */

        {% if defined(btts_yes_odds) %}

        AND isNotNull(btts_yes)
        AND isNotNull(btts_no)

        {% end %}

        /* ----------------------------------------------------
           AH
           ---------------------------------------------------- */

        {% if defined(ah_line) %}

        AND isNotNull(ah_line)
        AND ah_line = {{Float64(ah_line)}}
        AND isNotNull(ah_home)
        AND isNotNull(ah_away)

        {% end %}
),


/* ============================================================
   HISTORICAL PROBABILITIES
   ============================================================ */

probability_candidates AS
(
    SELECT

        *,

        hist_home_raw / hist_1x2_sum AS hist_home_p,
        hist_draw_raw / hist_1x2_sum AS hist_draw_p,
        hist_away_raw / hist_1x2_sum AS hist_away_p

    FROM candidates
),


/* ============================================================
   COARSE 1X2 DISTANCE
   ============================================================ */

coarse_candidates AS
(
    SELECT

        *,

        (
            (
                abs(
                    log(home_odds / {{Float64(home_odds)}})
                )

                +

                abs(
                    log(draw_odds / {{Float64(draw_odds)}})
                )

                +

                abs(
                    log(away_odds / {{Float64(away_odds)}})
                )
            ) / 3
        ) * 0.50

        +

        (
            (
                abs(hist_home_p - target_home_p)
                +
                abs(hist_draw_p - target_draw_p)
                +
                abs(hist_away_p - target_away_p)
            ) / 3
        ) * 0.50

        AS coarse_1x2


    FROM probability_candidates
),


/* ============================================================
   COARSE O/U
   ============================================================ */

coarse_with_ou AS
(
    SELECT

        *,

        {% if defined(ou_line) %}

        CASE

            WHEN {{Float64(ou_line)}} = 1.5 THEN

                (
                    (
                        abs(
                            log(
                                ou1_5_over
                                /
                                {{Float64(over_odds)}}
                            )
                        )

                        +

                        abs(
                            log(
                                ou1_5_under
                                /
                                {{Float64(under_odds)}}
                            )
                        )
                    ) / 2
                ) * 0.50

                +

                (
                    (
                        abs(
                            (
                                (1.0 / ou1_5_over)
                                /
                                (
                                    (1.0 / ou1_5_over)
                                    +
                                    (1.0 / ou1_5_under)
                                )
                            )
                            - target_ou_over_p
                        )

                        +

                        abs(
                            (
                                (1.0 / ou1_5_under)
                                /
                                (
                                    (1.0 / ou1_5_over)
                                    +
                                    (1.0 / ou1_5_under)
                                )
                            )
                            - target_ou_under_p
                        )
                    ) / 2
                ) * 0.50


            WHEN {{Float64(ou_line)}} = 2.5 THEN

                (
                    (
                        abs(
                            log(
                                ou2_5_over
                                /
                                {{Float64(over_odds)}}
                            )
                        )

                        +

                        abs(
                            log(
                                ou2_5_under
                                /
                                {{Float64(under_odds)}}
                            )
                        )
                    ) / 2
                ) * 0.50

                +

                (
                    (
                        abs(
                            (
                                (1.0 / ou2_5_over)
                                /
                                (
                                    (1.0 / ou2_5_over)
                                    +
                                    (1.0 / ou2_5_under)
                                )
                            )
                            - target_ou_over_p
                        )

                        +

                        abs(
                            (
                                (1.0 / ou2_5_under)
                                /
                                (
                                    (1.0 / ou2_5_over)
                                    +
                                    (1.0 / ou2_5_under)
                                )
                            )
                            - target_ou_under_p
                        )
                    ) / 2
                ) * 0.50


            WHEN {{Float64(ou_line)}} = 3.5 THEN

                (
                    (
                        abs(
                            log(
                                ou3_5_over
                                /
                                {{Float64(over_odds)}}
                            )
                        )

                        +

                        abs(
                            log(
                                ou3_5_under
                                /
                                {{Float64(under_odds)}}
                            )
                        )
                    ) / 2
                ) * 0.50

                +

                (
                    (
                        abs(
                            (
                                (1.0 / ou3_5_over)
                                /
                                (
                                    (1.0 / ou3_5_over)
                                    +
                                    (1.0 / ou3_5_under)
                                )
                            )
                            - target_ou_over_p
                        )

                        +

                        abs(
                            (
                                (1.0 / ou3_5_under)
                                /
                                (
                                    (1.0 / ou3_5_over)
                                    +
                                    (1.0 / ou3_5_under)
                                )
                            )
                            - target_ou_under_p
                        )
                    ) / 2
                ) * 0.50


            WHEN {{Float64(ou_line)}} = 4.5 THEN

                (
                    (
                        abs(
                            log(
                                ou4_5_over
                                /
                                {{Float64(over_odds)}}
                            )
                        )

                        +

                        abs(
                            log(
                                ou4_5_under
                                /
                                {{Float64(under_odds)}}
                            )
                        )
                    ) / 2
                ) * 0.50

                +

                (
                    (
                        abs(
                            (
                                (1.0 / ou4_5_over)
                                /
                                (
                                    (1.0 / ou4_5_over)
                                    +
                                    (1.0 / ou4_5_under)
                                )
                            )
                            - target_ou_over_p
                        )

                        +

                        abs(
                            (
                                (1.0 / ou4_5_under)
                                /
                                (
                                    (1.0 / ou4_5_over)
                                    +
                                    (1.0 / ou4_5_under)
                                )
                            )
                            - target_ou_under_p
                        )
                    ) / 2
                ) * 0.50

        END

        {% else %}

        0.0

        {% end %}

        AS coarse_ou

    FROM coarse_candidates
),


/* ============================================================
   COARSE BTTS
   ============================================================ */

coarse_with_btts AS
(
    SELECT

        *,

        {% if defined(btts_yes_odds) %}

        (
            (
                abs(
                    log(
                        btts_yes
                        /
                        {{Float64(btts_yes_odds)}}
                    )
                )

                +

                abs(
                    log(
                        btts_no
                        /
                        {{Float64(btts_no_odds)}}
                    )
                )
            ) / 2
        ) * 0.50

        +

        (
            (
                abs(
                    (
                        (1.0 / btts_yes)
                        /
                        (
                            (1.0 / btts_yes)
                            +
                            (1.0 / btts_no)
                        )
                    )
                    - target_btts_yes_p
                )

                +

                abs(
                    (
                        (1.0 / btts_no)
                        /
                        (
                            (1.0 / btts_yes)
                            +
                            (1.0 / btts_no)
                        )
                    )
                    - target_btts_no_p
                )
            ) / 2
        ) * 0.50

        {% else %}

        0.0

        {% end %}

        AS coarse_btts

    FROM coarse_with_ou
),


/* ============================================================
   COARSE AH
   ============================================================ */

coarse_with_ah AS
(
    SELECT

        *,

        {% if defined(ah_line) %}

        (
            (
                abs(
                    log(
                        ah_home
                        /
                        {{Float64(ah_home_odds)}}
                    )
                )

                +

                abs(
                    log(
                        ah_away
                        /
                        {{Float64(ah_away_odds)}}
                    )
                )
            ) / 2
        ) * 0.50

        +

        (
            (
                abs(
                    (
                        (1.0 / ah_home)
                        /
                        (
                            (1.0 / ah_home)
                            +
                            (1.0 / ah_away)
                        )
                    )
                    - target_ah_home_p
                )

                +

                abs(
                    (
                        (1.0 / ah_away)
                        /
                        (
                            (1.0 / ah_home)
                            +
                            (1.0 / ah_away)
                        )
                    )
                    - target_ah_away_p
                )
            ) / 2
        ) * 0.50

        {% else %}

        0.0

        {% end %}

        AS coarse_ah

    FROM coarse_with_btts
),


/* ============================================================
   COARSE COMPOSITE
   ============================================================ */

top_candidates AS
(
    SELECT

        *,

        (
            coarse_1x2

            {% if defined(ou_line) %}
            + coarse_ou
            {% end %}

            {% if defined(btts_yes_odds) %}
            + coarse_btts
            {% end %}

            {% if defined(ah_line) %}
            + coarse_ah
            {% end %}

        )
        /
        (
            1

            {% if defined(ou_line) %}
            + 1
            {% end %}

            {% if defined(btts_yes_odds) %}
            + 1
            {% end %}

            {% if defined(ah_line) %}
            + 1
            {% end %}
        ) AS coarse_distance

    FROM coarse_with_ah

    ORDER BY coarse_distance ASC

    LIMIT 5000
)


/* ============================================================
   EXACT SIMILARITY
   ============================================================ */

SELECT

    match_id,
    country,
    league,
    season,

    home_team,
    away_team,

    date,
    time,

    ht_home,
    ht_away,

    ft_home,
    ft_away,

    result,
    ht_ft,

    home_odds,
    draw_odds,
    away_odds,

    ou1_5_over,
    ou1_5_under,
    ou2_5_over,
    ou2_5_under,
    ou3_5_over,
    ou3_5_under,
    ou4_5_over,
    ou4_5_under,

    btts_yes,
    btts_no,

    ah_line,
    ah_home,
    ah_away,


    /* ========================================================
       EXACT 1X2 ODDS DISTANCE
       ======================================================== */

    (
        (
            abs(
                log(
                    home_odds
                    /
                    {{Float64(home_odds)}}
                )
            )

            +

            abs(
                log(
                    draw_odds
                    /
                    {{Float64(draw_odds)}}
                )
            )

            +

            abs(
                log(
                    away_odds
                    /
                    {{Float64(away_odds)}}
                )
            )
        ) / 3
    ) AS odds_distance_1x2,


    /* ========================================================
       EXACT 1X2 PROBABILITY DISTANCE
       ======================================================== */

    sqrt(
        (
            pow(hist_home_p - target_home_p, 2)
            +
            pow(hist_draw_p - target_draw_p, 2)
            +
            pow(hist_away_p - target_away_p, 2)
        ) / 3
    ) AS probability_distance_1x2,


    /* ========================================================
       EXACT O/U DISTANCE
       ======================================================== */

    {% if defined(ou_line) %}

    CASE

        WHEN {{Float64(ou_line)}} = 1.5 THEN

            (
                (
                    abs(
                        log(
                            ou1_5_over
                            /
                            {{Float64(over_odds)}}
                        )
                    )

                    +

                    abs(
                        log(
                            ou1_5_under
                            /
                            {{Float64(under_odds)}}
                        )
                    )
                ) / 2
            ) * 0.50

            +

            (
                sqrt(
                    (
                        pow(
                            (
                                (1.0 / ou1_5_over)
                                /
                                (
                                    (1.0 / ou1_5_over)
                                    +
                                    (1.0 / ou1_5_under)
                                )
                            )
                            - target_ou_over_p,
                            2
                        )

                        +

                        pow(
                            (
                                (1.0 / ou1_5_under)
                                /
                                (
                                    (1.0 / ou1_5_over)
                                    +
                                    (1.0 / ou1_5_under)
                                )
                            )
                            - target_ou_under_p,
                            2
                        )
                    ) / 2
                )
            ) * 0.50


        WHEN {{Float64(ou_line)}} = 2.5 THEN

            (
                (
                    abs(
                        log(
                            ou2_5_over
                            /
                            {{Float64(over_odds)}}
                        )
                    )

                    +

                    abs(
                        log(
                            ou2_5_under
                            /
                            {{Float64(under_odds)}}
                        )
                    )
                ) / 2
            ) * 0.50

            +

            (
                sqrt(
                    (
                        pow(
                            (
                                (1.0 / ou2_5_over)
                                /
                                (
                                    (1.0 / ou2_5_over)
                                    +
                                    (1.0 / ou2_5_under)
                                )
                            )
                            - target_ou_over_p,
                            2
                        )

                        +

                        pow(
                            (
                                (1.0 / ou2_5_under)
                                /
                                (
                                    (1.0 / ou2_5_over)
                                    +
                                    (1.0 / ou2_5_under)
                                )
                            )
                            - target_ou_under_p,
                            2
                        )
                    ) / 2
                )
            ) * 0.50


        WHEN {{Float64(ou_line)}} = 3.5 THEN

            (
                (
                    abs(
                        log(
                            ou3_5_over
                            /
                            {{Float64(over_odds)}}
                        )
                    )

                    +

                    abs(
                        log(
                            ou3_5_under
                            /
                            {{Float64(under_odds)}}
                        )
                    )
                ) / 2
            ) * 0.50

            +

            (
                sqrt(
                    (
                        pow(
                            (
                                (1.0 / ou3_5_over)
                                /
                                (
                                    (1.0 / ou3_5_over)
                                    +
                                    (1.0 / ou3_5_under)
                                )
                            )
                            - target_ou_over_p,
                            2
                        )

                        +

                        pow(
                            (
                                (1.0 / ou3_5_under)
                                /
                                (
                                    (1.0 / ou3_5_over)
                                    +
                                    (1.0 / ou3_5_under)
                                )
                            )
                            - target_ou_under_p,
                            2
                        )
                    ) / 2
                )
            ) * 0.50


        WHEN {{Float64(ou_line)}} = 4.5 THEN

            (
                (
                    abs(
                        log(
                            ou4_5_over
                            /
                            {{Float64(over_odds)}}
                        )
                    )

                    +

                    abs(
                        log(
                            ou4_5_under
                            /
                            {{Float64(under_odds)}}
                        )
                    )
                ) / 2
            ) * 0.50

            +

            (
                sqrt(
                    (
                        pow(
                            (
                                (1.0 / ou4_5_over)
                                /
                                (
                                    (1.0 / ou4_5_over)
                                    +
                                    (1.0 / ou4_5_under)
                                )
                            )
                            - target_ou_over_p,
                            2
                        )

                        +

                        pow(
                            (
                                (1.0 / ou4_5_under)
                                /
                                (
                                    (1.0 / ou4_5_over)
                                    +
                                    (1.0 / ou4_5_under)
                                )
                            )
                            - target_ou_under_p,
                            2
                        )
                    ) / 2
                )
            ) * 0.50

    END

    {% else %}

    0.0

    {% end %}

    AS distance_ou,


    /* ========================================================
       EXACT BTTS DISTANCE
       ======================================================== */

    {% if defined(btts_yes_odds) %}

    (
        (
            abs(
                log(
                    btts_yes
                    /
                    {{Float64(btts_yes_odds)}}
                )
            )

            +

            abs(
                log(
                    btts_no
                    /
                    {{Float64(btts_no_odds)}}
                )
            )
        ) / 2
    ) * 0.50

    +

    (
        sqrt(
            (
                pow(
                    (
                        (1.0 / btts_yes)
                        /
                        (
                            (1.0 / btts_yes)
                            +
                            (1.0 / btts_no)
                        )
                    )
                    - target_btts_yes_p,
                    2
                )

                +

                pow(
                    (
                        (1.0 / btts_no)
                        /
                        (
                            (1.0 / btts_yes)
                            +
                            (1.0 / btts_no)
                        )
                    )
                    - target_btts_no_p,
                    2
                )
            ) / 2
        )
    ) * 0.50

    {% else %}

    0.0

    {% end %}

    AS distance_btts,


    /* ========================================================
       EXACT AH DISTANCE
       ======================================================== */

    {% if defined(ah_line) %}

    (
        (
            abs(
                log(
                    ah_home
                    /
                    {{Float64(ah_home_odds)}}
                )
            )

            +

            abs(
                log(
                    ah_away
                    /
                    {{Float64(ah_away_odds)}}
                )
            )
        ) / 2
    ) * 0.50

    +

    (
        sqrt(
            (
                pow(
                    (
                        (1.0 / ah_home)
                        /
                        (
                            (1.0 / ah_home)
                            +
                            (1.0 / ah_away)
                        )
                    )
                    - target_ah_home_p,
                    2
                )

                +

                pow(
                    (
                        (1.0 / ah_away)
                        /
                        (
                            (1.0 / ah_home)
                            +
                            (1.0 / ah_away)
                        )
                    )
                    - target_ah_away_p,
                    2
                )
            ) / 2
        )
    ) * 0.50

    {% else %}

    0.0

    {% end %}

    AS distance_ah,


    /* ========================================================
       COMPOSITE DISTANCE
       ======================================================== */

    (
        (
            (
                (
                    abs(
                        log(
                            home_odds
                            /
                            {{Float64(home_odds)}}
                        )
                    )

                    +

                    abs(
                        log(
                            draw_odds
                            /
                            {{Float64(draw_odds)}}
                        )
                    )

                    +

                    abs(
                        log(
                            away_odds
                            /
                            {{Float64(away_odds)}}
                        )
                    )
                ) / 3
            ) * 0.50

            +

            (
                sqrt(
                    (
                        pow(hist_home_p - target_home_p, 2)
                        +
                        pow(hist_draw_p - target_draw_p, 2)
                        +
                        pow(hist_away_p - target_away_p, 2)
                    ) / 3
                )
            ) * 0.50
        )

        {% if defined(ou_line) %}
        + distance_ou
        {% end %}

        {% if defined(btts_yes_odds) %}
        + distance_btts
        {% end %}

        {% if defined(ah_line) %}
        + distance_ah
        {% end %}

    )
    /
    (
        1

        {% if defined(ou_line) %}
        + 1
        {% end %}

        {% if defined(btts_yes_odds) %}
        + 1
        {% end %}

        {% if defined(ah_line) %}
        + 1
        {% end %}
    ) AS composite_distance,


    /* ========================================================
       SIMILARITY SCORE
       ======================================================== */

    (
        100.0
        *
        exp(
            -5.0
            *
            (
                (
                    (
                        (
                            abs(
                                log(
                                    home_odds
                                    /
                                    {{Float64(home_odds)}}
                                )
                            )

                            +

                            abs(
                                log(
                                    draw_odds
                                    /
                                    {{Float64(draw_odds)}}
                                )
                            )

                            +

                            abs(
                                log(
                                    away_odds
                                    /
                                    {{Float64(away_odds)}}
                                )
                            )
                        ) / 3
                    ) * 0.50

                    +

                    (
                        sqrt(
                            (
                                pow(
                                    hist_home_p
                                    - target_home_p,
                                    2
                                )

                                +

                                pow(
                                    hist_draw_p
                                    - target_draw_p,
                                    2
                                )

                                +

                                pow(
                                    hist_away_p
                                    - target_away_p,
                                    2
                                )
                            ) / 3
                        )
                    ) * 0.50
                )

                {% if defined(ou_line) %}
                + distance_ou
                {% end %}

                {% if defined(btts_yes_odds) %}
                + distance_btts
                {% end %}

                {% if defined(ah_line) %}
                + distance_ah
                {% end %}
            )
            /
            (
                1

                {% if defined(ou_line) %}
                + 1
                {% end %}

                {% if defined(btts_yes_odds) %}
                + 1
                {% end %}

                {% if defined(ah_line) %}
                + 1
                {% end %}
            )
        )
    ) AS similarity_score


FROM top_candidates

ORDER BY composite_distance ASC

LIMIT {{Int32(limit, 50)}}

OFFSET {{Int32(offset, 0)}}

SETTINGS
    optimize_move_to_prewhere = 1,
    query_plan_optimize_lazy_materialization = 1

TYPE ENDPOINT
