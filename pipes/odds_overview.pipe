DESCRIPTION >
  Odds verilerinin lig bazındaki genel kapsamını gösterir.
  has_odds=True olan maçları temel alır ancak her marketin
  kullanılabilirliğini kendi oran kolonlarına göre ayrı hesaplar.

NODE odds_overview_query
SQL >
%
  SELECT
    country,
    league,
    season,

    count() AS total_matches,

    countIf(toString(has_odds) = 'True') AS odds_matches,

    round(
      countIf(toString(has_odds) = 'True') * 100.0 / count(),
      2
    ) AS odds_coverage_pct,

    /* =========================
       1X2
       ========================= */

    countIf(
      toString(has_odds) = 'True'
      AND home_odds > 0
      AND draw_odds > 0
      AND away_odds > 0
    ) AS x12_matches,

    round(
      countIf(
        toString(has_odds) = 'True'
        AND home_odds > 0
        AND draw_odds > 0
        AND away_odds > 0
      ) * 100.0 / count(),
      2
    ) AS x12_coverage_pct,

    /* =========================
       OVER / UNDER 1.5
       ========================= */

    countIf(
      toString(has_odds) = 'True'
      AND ou1.5_over > 0
      AND ou1.5_under > 0
    ) AS ou1_5_matches,

    round(
      countIf(
        toString(has_odds) = 'True'
        AND ou1.5_over > 0
        AND ou1.5_under > 0
      ) * 100.0 / count(),
      2
    ) AS ou1_5_coverage_pct,

    /* =========================
       OVER / UNDER 2.5
       ========================= */

    countIf(
      toString(has_odds) = 'True'
      AND ou2.5_over > 0
      AND ou2.5_under > 0
    ) AS ou2_5_matches,

    round(
      countIf(
        toString(has_odds) = 'True'
        AND ou2.5_over > 0
        AND ou2.5_under > 0
      ) * 100.0 / count(),
      2
    ) AS ou2_5_coverage_pct,

    /* =========================
       OVER / UNDER 3.5
       ========================= */

    countIf(
      toString(has_odds) = 'True'
      AND ou3.5_over > 0
      AND ou3.5_under > 0
    ) AS ou3_5_matches,

    round(
      countIf(
        toString(has_odds) = 'True'
        AND ou3.5_over > 0
        AND ou3.5_under > 0
      ) * 100.0 / count(),
      2
    ) AS ou3_5_coverage_pct,

    /* =========================
       OVER / UNDER 4.5
       ========================= */

    countIf(
      toString(has_odds) = 'True'
      AND ou4.5_over > 0
      AND ou4.5_under > 0
    ) AS ou4_5_matches,

    round(
      countIf(
        toString(has_odds) = 'True'
        AND ou4.5_over > 0
        AND ou4.5_under > 0
      ) * 100.0 / count(),
      2
    ) AS ou4_5_coverage_pct,

    /* =========================
       BTTS
       ========================= */

    countIf(
      toString(has_odds) = 'True'
      AND btts_yes > 0
      AND btts_no > 0
    ) AS btts_matches,

    round(
      countIf(
        toString(has_odds) = 'True'
        AND btts_yes > 0
        AND btts_no > 0
      ) * 100.0 / count(),
      2
    ) AS btts_coverage_pct,

    /* =========================
       ASIAN HANDICAP
       ========================= */

    countIf(
      toString(has_odds) = 'True'
      AND ah_home > 0
      AND ah_away > 0
    ) AS ah_matches,

    round(
      countIf(
        toString(has_odds) = 'True'
        AND ah_home > 0
        AND ah_away > 0
      ) * 100.0 / count(),
      2
    ) AS ah_coverage_pct

  FROM betexplorer_matches

  GROUP BY
    country,
    league,
    season

TYPE ENDPOINT
