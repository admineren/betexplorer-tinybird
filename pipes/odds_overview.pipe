DESCRIPTION >
  Lig ve sezon bazında odds kapsamını analiz eder.
  country, league ve season parametreleri opsiyoneldir.
  has_odds sadece genel odds varlığını gösterir.
  Her market kendi kolonlarının NULL durumuna göre ayrıca hesaplanır.

NODE odds_overview_query
SQL >

%
SELECT
    country,
    league,
    season,

    /* =====================================================
       GENEL
       ===================================================== */

    count() AS total_matches,

    countIf(has_odds = 'True') AS odds_matches,

    round(
        countIf(has_odds = 'True') * 100.0 / count(),
        2
    ) AS odds_coverage_pct,


    /* =====================================================
       1X2
       ===================================================== */

    countIf(
        has_odds = 'True'
        AND isNotNull(home_odds)
        AND isNotNull(draw_odds)
        AND isNotNull(away_odds)
    ) AS x12_matches,

    round(
        countIf(
            has_odds = 'True'
            AND isNotNull(home_odds)
            AND isNotNull(draw_odds)
            AND isNotNull(away_odds)
        ) * 100.0 / count(),
        2
    ) AS x12_coverage_pct,


    /* =====================================================
       OVER / UNDER 1.5
       ===================================================== */

    countIf(
        has_odds = 'True'
        AND isNotNull(ou1_5_over)
        AND isNotNull(ou1_5_under)
    ) AS ou1_5_matches,

    round(
        countIf(
            has_odds = 'True'
            AND isNotNull(ou1_5_over)
            AND isNotNull(ou1_5_under)
        ) * 100.0 / count(),
        2
    ) AS ou1_5_coverage_pct,


    /* =====================================================
       OVER / UNDER 2.5
       ===================================================== */

    countIf(
        has_odds = 'True'
        AND isNotNull(ou2_5_over)
        AND isNotNull(ou2_5_under)
    ) AS ou2_5_matches,

    round(
        countIf(
            has_odds = 'True'
            AND isNotNull(ou2_5_over)
            AND isNotNull(ou2_5_under)
        ) * 100.0 / count(),
        2
    ) AS ou2_5_coverage_pct,


    /* =====================================================
       OVER / UNDER 3.5
       ===================================================== */

    countIf(
        has_odds = 'True'
        AND isNotNull(ou3_5_over)
        AND isNotNull(ou3_5_under)
    ) AS ou3_5_matches,

    round(
        countIf(
            has_odds = 'True'
            AND isNotNull(ou3_5_over)
            AND isNotNull(ou3_5_under)
        ) * 100.0 / count(),
        2
    ) AS ou3_5_coverage_pct,


    /* =====================================================
       OVER / UNDER 4.5
       ===================================================== */

    countIf(
        has_odds = 'True'
        AND isNotNull(ou4_5_over)
        AND isNotNull(ou4_5_under)
    ) AS ou4_5_matches,

    round(
        countIf(
            has_odds = 'True'
            AND isNotNull(ou4_5_over)
            AND isNotNull(ou4_5_under)
        ) * 100.0 / count(),
        2
    ) AS ou4_5_coverage_pct,


    /* =====================================================
       BTTS
       ===================================================== */

    countIf(
        has_odds = 'True'
        AND isNotNull(btts_yes)
        AND isNotNull(btts_no)
    ) AS btts_matches,

    round(
        countIf(
            has_odds = 'True'
            AND isNotNull(btts_yes)
            AND isNotNull(btts_no)
        ) * 100.0 / count(),
        2
    ) AS btts_coverage_pct,


    /* =====================================================
       ASIAN HANDICAP
       ===================================================== */

    countIf(
        has_odds = 'True'
        AND isNotNull(ah_line)
        AND isNotNull(ah_home)
        AND isNotNull(ah_away)
    ) AS ah_matches,

    round(
        countIf(
            has_odds = 'True'
            AND isNotNull(ah_line)
            AND isNotNull(ah_home)
            AND isNotNull(ah_away)
        ) * 100.0 / count(),
        2
    ) AS ah_coverage_pct

FROM betexplorer_matches

WHERE 1 = 1

{% if defined(country) %}
AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
AND season = {{String(season)}}
{% end %}

GROUP BY
    country,
    league,
    season

TYPE ENDPOINT
