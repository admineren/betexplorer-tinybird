DESCRIPTION >
    Lig gol analizi.
    Ligin toplam gol yapısını, ev/deplasman gol dağılımını,
    Over, BTTS, ilk yarı ve ikinci yarı gol profillerini döndürür.

NODE league_goals_query
SQL >
    %

    SELECT

        /* =====================================================
           GENEL
           ===================================================== */

        matches,

        total_goals,

        round(
            if(matches = 0, 0, total_goals * 1.0 / matches),
            2
        ) AS goals_per_match,

        max_total_goals,


        /* =====================================================
           EV / DEPLASMAN GOLLERİ
           ===================================================== */

        home_goals,

        away_goals,

        round(
            if(matches = 0, 0, home_goals * 1.0 / matches),
            2
        ) AS home_goals_avg,

        round(
            if(matches = 0, 0, away_goals * 1.0 / matches),
            2
        ) AS away_goals_avg,


        /* =====================================================
           TOPLAM GOL DAĞILIMI
           ===================================================== */

        total_goals_0_1,

        total_goals_2_3,

        total_goals_4_5,

        total_goals_6_plus,

        round(
            if(matches = 0, 0, total_goals_0_1 * 100.0 / matches),
            2
        ) AS total_goals_0_1_pct,

        round(
            if(matches = 0, 0, total_goals_2_3 * 100.0 / matches),
            2
        ) AS total_goals_2_3_pct,

        round(
            if(matches = 0, 0, total_goals_4_5 * 100.0 / matches),
            2
        ) AS total_goals_4_5_pct,

        round(
            if(matches = 0, 0, total_goals_6_plus * 100.0 / matches),
            2
        ) AS total_goals_6_plus_pct,


        /* =====================================================
           EV SAHİBİ GOL DAĞILIMI
           ===================================================== */

        home_goals_0,

        home_goals_1,

        home_goals_2_3,

        home_goals_4_5,

        home_goals_6_plus,

        round(
            if(matches = 0, 0, home_goals_0 * 100.0 / matches),
            2
        ) AS home_goals_0_pct,

        round(
            if(matches = 0, 0, home_goals_1 * 100.0 / matches),
            2
        ) AS home_goals_1_pct,

        round(
            if(matches = 0, 0, home_goals_2_3 * 100.0 / matches),
            2
        ) AS home_goals_2_3_pct,

        round(
            if(matches = 0, 0, home_goals_4_5 * 100.0 / matches),
            2
        ) AS home_goals_4_5_pct,

        round(
            if(matches = 0, 0, home_goals_6_plus * 100.0 / matches),
            2
        ) AS home_goals_6_plus_pct,


        /* =====================================================
           DEPLASMAN GOL DAĞILIMI
           ===================================================== */

        away_goals_0,

        away_goals_1,

        away_goals_2_3,

        away_goals_4_5,

        away_goals_6_plus,

        round(
            if(matches = 0, 0, away_goals_0 * 100.0 / matches),
            2
        ) AS away_goals_0_pct,

        round(
            if(matches = 0, 0, away_goals_1 * 100.0 / matches),
            2
        ) AS away_goals_1_pct,

        round(
            if(matches = 0, 0, away_goals_2_3 * 100.0 / matches),
            2
        ) AS away_goals_2_3_pct,

        round(
            if(matches = 0, 0, away_goals_4_5 * 100.0 / matches),
            2
        ) AS away_goals_4_5_pct,

        round(
            if(matches = 0, 0, away_goals_6_plus * 100.0 / matches),
            2
        ) AS away_goals_6_plus_pct,


        /* =====================================================
           OVER
           ===================================================== */

        over_0_5,

        over_1_5,

        over_2_5,

        over_3_5,

        over_4_5,

        round(
            if(matches = 0, 0, over_0_5 * 100.0 / matches),
            2
        ) AS over_0_5_pct,

        round(
            if(matches = 0, 0, over_1_5 * 100.0 / matches),
            2
        ) AS over_1_5_pct,

        round(
            if(matches = 0, 0, over_2_5 * 100.0 / matches),
            2
        ) AS over_2_5_pct,

        round(
            if(matches = 0, 0, over_3_5 * 100.0 / matches),
            2
        ) AS over_3_5_pct,

        round(
            if(matches = 0, 0, over_4_5 * 100.0 / matches),
            2
        ) AS over_4_5_pct,


        /* =====================================================
           BTTS
           ===================================================== */

        btts_yes,

        btts_no,

        round(
            if(matches = 0, 0, btts_yes * 100.0 / matches),
            2
        ) AS btts_yes_pct,

        round(
            if(matches = 0, 0, btts_no * 100.0 / matches),
            2
        ) AS btts_no_pct,


        /* =====================================================
           İLK YARI TOPLAM GOL
           ===================================================== */

        ht_matches,

        ht_total_goals_0,

        ht_total_goals_1,

        ht_total_goals_2,

        ht_total_goals_3_plus,

        round(
            if(ht_matches = 0, 0, ht_total_goals_0 * 100.0 / ht_matches),
            2
        ) AS ht_total_goals_0_pct,

        round(
            if(ht_matches = 0, 0, ht_total_goals_1 * 100.0 / ht_matches),
            2
        ) AS ht_total_goals_1_pct,

        round(
            if(ht_matches = 0, 0, ht_total_goals_2 * 100.0 / ht_matches),
            2
        ) AS ht_total_goals_2_pct,

        round(
            if(ht_matches = 0, 0, ht_total_goals_3_plus * 100.0 / ht_matches),
            2
        ) AS ht_total_goals_3_plus_pct,


        /* =====================================================
           İLK YARI OVER
           ===================================================== */

        ht_over_0_5,

        ht_over_1_5,

        ht_over_2_5,

        round(
            if(ht_matches = 0, 0, ht_over_0_5 * 100.0 / ht_matches),
            2
        ) AS ht_over_0_5_pct,

        round(
            if(ht_matches = 0, 0, ht_over_1_5 * 100.0 / ht_matches),
            2
        ) AS ht_over_1_5_pct,

        round(
            if(ht_matches = 0, 0, ht_over_2_5 * 100.0 / ht_matches),
            2
        ) AS ht_over_2_5_pct,


        /* =====================================================
           İKİNCİ YARI TOPLAM GOL
           ===================================================== */

        second_half_total_goals_0,

        second_half_total_goals_1,

        second_half_total_goals_2,

        second_half_total_goals_3_plus,

        round(
            if(matches = 0, 0,
                second_half_total_goals_0 * 100.0 / matches
            ),
            2
        ) AS second_half_total_goals_0_pct,

        round(
            if(matches = 0, 0,
                second_half_total_goals_1 * 100.0 / matches
            ),
            2
        ) AS second_half_total_goals_1_pct,

        round(
            if(matches = 0, 0,
                second_half_total_goals_2 * 100.0 / matches
            ),
            2
        ) AS second_half_total_goals_2_pct,

        round(
            if(matches = 0, 0,
                second_half_total_goals_3_plus * 100.0 / matches
            ),
            2
        ) AS second_half_total_goals_3_plus_pct,


        /* =====================================================
           İKİNCİ YARI OVER
           ===================================================== */

        second_half_over_0_5,

        second_half_over_1_5,

        second_half_over_2_5,

        round(
            if(matches = 0, 0,
                second_half_over_0_5 * 100.0 / matches
            ),
            2
        ) AS second_half_over_0_5_pct,

        round(
            if(matches = 0, 0,
                second_half_over_1_5 * 100.0 / matches
            ),
            2
        ) AS second_half_over_1_5_pct,

        round(
            if(matches = 0, 0,
                second_half_over_2_5 * 100.0 / matches
            ),
            2
        ) AS second_half_over_2_5_pct


    FROM
    (
        SELECT

            /* =================================================
               GENEL
               ================================================= */

            count() AS matches,

            sum(ft_home + ft_away) AS total_goals,

            max(ft_home + ft_away) AS max_total_goals,

            sum(ft_home) AS home_goals,

            sum(ft_away) AS away_goals,


            /* =================================================
               TOPLAM GOL DAĞILIMI
               ================================================= */

            countIf(
                ft_home + ft_away <= 1
            ) AS total_goals_0_1,

            countIf(
                ft_home + ft_away BETWEEN 2 AND 3
            ) AS total_goals_2_3,

            countIf(
                ft_home + ft_away BETWEEN 4 AND 5
            ) AS total_goals_4_5,

            countIf(
                ft_home + ft_away >= 6
            ) AS total_goals_6_plus,


            /* =================================================
               EV SAHİBİ GOL DAĞILIMI
               ================================================= */

            countIf(
                ft_home = 0
            ) AS home_goals_0,

            countIf(
                ft_home = 1
            ) AS home_goals_1,

            countIf(
                ft_home BETWEEN 2 AND 3
            ) AS home_goals_2_3,

            countIf(
                ft_home BETWEEN 4 AND 5
            ) AS home_goals_4_5,

            countIf(
                ft_home >= 6
            ) AS home_goals_6_plus,


            /* =================================================
               DEPLASMAN GOL DAĞILIMI
               ================================================= */

            countIf(
                ft_away = 0
            ) AS away_goals_0,

            countIf(
                ft_away = 1
            ) AS away_goals_1,

            countIf(
                ft_away BETWEEN 2 AND 3
            ) AS away_goals_2_3,

            countIf(
                ft_away BETWEEN 4 AND 5
            ) AS away_goals_4_5,

            countIf(
                ft_away >= 6
            ) AS away_goals_6_plus,


            /* =================================================
               OVER
               ================================================= */

            countIf(
                ft_home + ft_away >= 1
            ) AS over_0_5,

            countIf(
                ft_home + ft_away >= 2
            ) AS over_1_5,

            countIf(
                ft_home + ft_away >= 3
            ) AS over_2_5,

            countIf(
                ft_home + ft_away >= 4
            ) AS over_3_5,

            countIf(
                ft_home + ft_away >= 5
            ) AS over_4_5,


            /* =================================================
               BTTS
               ================================================= */

            countIf(
                ft_home > 0
                AND ft_away > 0
            ) AS btts_yes,

            countIf(
                ft_home = 0
                OR ft_away = 0
            ) AS btts_no,


            /* =================================================
               İLK YARI
               ================================================= */

            count() AS ht_matches,

            countIf(
                ht_home + ht_away = 0
            ) AS ht_total_goals_0,

            countIf(
                ht_home + ht_away = 1
            ) AS ht_total_goals_1,

            countIf(
                ht_home + ht_away = 2
            ) AS ht_total_goals_2,

            countIf(
                ht_home + ht_away >= 3
            ) AS ht_total_goals_3_plus,


            /* =================================================
               İLK YARI OVER
               ================================================= */

            countIf(
                ht_home + ht_away >= 1
            ) AS ht_over_0_5,

            countIf(
                ht_home + ht_away >= 2
            ) AS ht_over_1_5,

            countIf(
                ht_home + ht_away >= 3
            ) AS ht_over_2_5,


            /* =================================================
               İKİNCİ YARI
               ================================================= */

            countIf(
                (ft_home - ht_home)
                +
                (ft_away - ht_away) = 0
            ) AS second_half_total_goals_0,

            countIf(
                (ft_home - ht_home)
                +
                (ft_away - ht_away) = 1
            ) AS second_half_total_goals_1,

            countIf(
                (ft_home - ht_home)
                +
                (ft_away - ht_away) = 2
            ) AS second_half_total_goals_2,

            countIf(
                (ft_home - ht_home)
                +
                (ft_away - ht_away) >= 3
            ) AS second_half_total_goals_3_plus,


            /* =================================================
               İKİNCİ YARI OVER
               ================================================= */

            countIf(
                (ft_home - ht_home)
                +
                (ft_away - ht_away) >= 1
            ) AS second_half_over_0_5,

            countIf(
                (ft_home - ht_home)
                +
                (ft_away - ht_away) >= 2
            ) AS second_half_over_1_5,

            countIf(
                (ft_home - ht_home)
                +
                (ft_away - ht_away) >= 3
            ) AS second_half_over_2_5


        FROM betexplorer_matches

        WHERE

            /* =================================================
               ZORUNLU LİG FİLTRELERİ
               ================================================= */

            country = {{String(country)}}

            AND league = {{String(league)}}


            /* =================================================
               TAMAMLANMIŞ MAÇLAR
               ================================================= */

            AND ft_home IS NOT NULL
            AND ft_away IS NOT NULL


            /* =================================================
               SEZON OPSİYONEL
               ================================================= */

            {% if defined(season) %}
            AND season = {{String(season)}}
            {% end %}


            /* =================================================
               İLK YARI İSTATİSTİKLERİ İÇİN
               HT NULL OLAN MAÇLAR ANA İSTATİSTİKLERİ
               ETKİLEMEZ.
               ================================================= */

    )

TYPE ENDPOINT
