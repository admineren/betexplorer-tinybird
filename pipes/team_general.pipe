DESCRIPTION >
    Takım genel performans özeti.
    Maç, sonuç, gol, ilk yarı ve ikinci yarı istatistiklerini döndürür.

NODE team_general_query
SQL >
%
    SELECT

        /* =====================================================
           MAÇ PERFORMANSI
           ===================================================== */

        count() AS matches,

        countIf(
            (
                home_team = {{String(team)}}
                AND ft_home > ft_away
            )
            OR
            (
                away_team = {{String(team)}}
                AND ft_away > ft_home
            )
        ) AS wins,

        countIf(ft_home = ft_away) AS draws,

        countIf(
            (
                home_team = {{String(team)}}
                AND ft_home < ft_away
            )
            OR
            (
                away_team = {{String(team)}}
                AND ft_away < ft_home
            )
        ) AS losses,


        /* =====================================================
           GOL PERFORMANSI
           ===================================================== */

        sum(
            if(
                home_team = {{String(team)}},
                ft_home,
                ft_away
            )
        ) AS goals_for,

        sum(
            if(
                home_team = {{String(team)}},
                ft_away,
                ft_home
            )
        ) AS goals_against,


        /* =====================================================
           İLK YARI
           ===================================================== */

        sum(
            if(
                home_team = {{String(team)}},
                ht_home,
                ht_away
            )
        ) AS ht_goals_for,

        sum(
            if(
                home_team = {{String(team)}},
                ht_away,
                ht_home
            )
        ) AS ht_goals_against,


        /* =====================================================
           İKİNCİ YARI
           ===================================================== */

        sum(
            if(
                home_team = {{String(team)}},
                ft_home - ht_home,
                ft_away - ht_away
            )
        ) AS second_half_goals_for,

        sum(
            if(
                home_team = {{String(team)}},
                ft_away - ht_away,
                ft_home - ht_home
            )
        ) AS second_half_goals_against


    FROM betexplorer_matches

    WHERE
        (
            home_team = {{String(team)}}
            OR
            away_team = {{String(team)}}
        )

        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}

        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}

        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}

TYPE ENDPOINT
