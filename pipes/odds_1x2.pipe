DESCRIPTION >
    1X2 oran analizi.

    Genel:
    - Toplam 1X2 oranlı maç
    - Home / Draw / Away oran dağılımları
    - Oran bantlarına göre sonuç performansı
    - Favori performansı
    - Sürpriz sonuçlar
    - Yüksek oranlı galibiyetler

    Özel oran analizi:
    - market: home / draw / away
    - odds_min
    - odds_max

    Filtreler:
    - country
    - league
    - season

NODE odds_1x2_query
SQL >
    %

    WITH filtered AS
    (
        SELECT
            match_id,
            date,
            country,
            league,
            season,
            home_team,
            away_team,
            result,

            home_odds,
            draw_odds,
            away_odds,

            least(
                home_odds,
                draw_odds,
                away_odds
            ) AS favorite_odds,

            multiIf(
                home_odds = least(
                    home_odds,
                    draw_odds,
                    away_odds
                ), 'H',

                draw_odds = least(
                    home_odds,
                    draw_odds,
                    away_odds
                ), 'D',

                'A'
            ) AS favorite_type

        FROM betexplorer_matches

        WHERE
            has_odds = 'True'

            AND isNotNull(home_odds)
            AND isNotNull(draw_odds)
            AND isNotNull(away_odds)

            {% if defined(country) %}
            AND country = {{String(country)}}
            {% end %}

            {% if defined(league) %}
            AND league = {{String(league)}}
            {% end %}

            {% if defined(season) %}
            AND season = {{String(season)}}
            {% end %}
    )

    SELECT

        /* =====================================================
           GENEL
           ===================================================== */

        count() AS matches,


        /* =====================================================
           HOME ODDS GENEL
           ===================================================== */

        round(
            avg(home_odds),
            2
        ) AS home_odds_avg,

        min(home_odds) AS home_odds_min,
        max(home_odds) AS home_odds_max,


        /* =====================================================
           DRAW ODDS GENEL
           ===================================================== */

        round(
            avg(draw_odds),
            2
        ) AS draw_odds_avg,

        min(draw_odds) AS draw_odds_min,
        max(draw_odds) AS draw_odds_max,


        /* =====================================================
           AWAY ODDS GENEL
           ===================================================== */

        round(
            avg(away_odds),
            2
        ) AS away_odds_avg,

        min(away_odds) AS away_odds_min,
        max(away_odds) AS away_odds_max,


        /* =====================================================
           HOME ODDS BANTLARI
           ===================================================== */

        countIf(home_odds < 1.30)
            AS home_lt_1_30,

        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
        ) AS home_1_30_1_49,

        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
        ) AS home_1_50_1_79,

        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
        ) AS home_1_80_2_09,

        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
        ) AS home_2_10_2_49,

        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
        ) AS home_2_50_2_99,

        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
        ) AS home_3_00_3_99,

        countIf(home_odds >= 4.00)
            AS home_ge_4_00,


        /* =====================================================
           HOME BANT SONUÇLARI
           ===================================================== */

        countIf(
            home_odds < 1.30
            AND result = 'H'
        ) AS home_lt_1_30_wins,

        countIf(
            home_odds < 1.30
            AND result = 'D'
        ) AS home_lt_1_30_draws,

        countIf(
            home_odds < 1.30
            AND result = 'A'
        ) AS home_lt_1_30_losses,


        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
            AND result = 'H'
        ) AS home_1_30_1_49_wins,

        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
            AND result = 'D'
        ) AS home_1_30_1_49_draws,

        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
            AND result = 'A'
        ) AS home_1_30_1_49_losses,


        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
            AND result = 'H'
        ) AS home_1_50_1_79_wins,

        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
            AND result = 'D'
        ) AS home_1_50_1_79_draws,

        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
            AND result = 'A'
        ) AS home_1_50_1_79_losses,


        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
            AND result = 'H'
        ) AS home_1_80_2_09_wins,

        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
            AND result = 'D'
        ) AS home_1_80_2_09_draws,

        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
            AND result = 'A'
        ) AS home_1_80_2_09_losses,


        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
            AND result = 'H'
        ) AS home_2_10_2_49_wins,

        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
            AND result = 'D'
        ) AS home_2_10_2_49_draws,

        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
            AND result = 'A'
        ) AS home_2_10_2_49_losses,


        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
            AND result = 'H'
        ) AS home_2_50_2_99_wins,

        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
            AND result = 'D'
        ) AS home_2_50_2_99_draws,

        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
            AND result = 'A'
        ) AS home_2_50_2_99_losses,


        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
            AND result = 'H'
        ) AS home_3_00_3_99_wins,

        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
            AND result = 'D'
        ) AS home_3_00_3_99_draws,

        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
            AND result = 'A'
        ) AS home_3_00_3_99_losses,


        countIf(
            home_odds >= 4.00
            AND result = 'H'
        ) AS home_ge_4_00_wins,

        countIf(
            home_odds >= 4.00
            AND result = 'D'
        ) AS home_ge_4_00_draws,

        countIf(
            home_odds >= 4.00
            AND result = 'A'
        ) AS home_ge_4_00_losses,


        /* =====================================================
           DRAW ODDS BANTLARI
           ===================================================== */

        countIf(
            draw_odds < 2.50
        ) AS draw_lt_2_50,

        countIf(
            draw_odds >= 2.50
            AND draw_odds < 3.00
        ) AS draw_2_50_2_99,

        countIf(
            draw_odds >= 3.00
            AND draw_odds < 3.50
        ) AS draw_3_00_3_49,

        countIf(
            draw_odds >= 3.50
            AND draw_odds < 4.00
        ) AS draw_3_50_3_99,

        countIf(
            draw_odds >= 4.00
            AND draw_odds < 4.50
        ) AS draw_4_00_4_49,

        countIf(
            draw_odds >= 4.50
        ) AS draw_ge_4_50,


        /* =====================================================
           DRAW BANT SONUÇLARI
           ===================================================== */

        countIf(
            draw_odds < 2.50
            AND result = 'D'
        ) AS draw_lt_2_50_wins,

        countIf(
            draw_odds >= 2.50
            AND draw_odds < 3.00
            AND result = 'D'
        ) AS draw_2_50_2_99_wins,

        countIf(
            draw_odds >= 3.00
            AND draw_odds < 3.50
            AND result = 'D'
        ) AS draw_3_00_3_49_wins,

        countIf(
            draw_odds >= 3.50
            AND draw_odds < 4.00
            AND result = 'D'
        ) AS draw_3_50_3_99_wins,

        countIf(
            draw_odds >= 4.00
            AND draw_odds < 4.50
            AND result = 'D'
        ) AS draw_4_00_4_49_wins,

        countIf(
            draw_odds >= 4.50
            AND result = 'D'
        ) AS draw_ge_4_50_wins,


        /* =====================================================
           AWAY ODDS BANTLARI
           ===================================================== */

        countIf(away_odds < 1.30)
            AS away_lt_1_30,

        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
        ) AS away_1_30_1_49,

        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
        ) AS away_1_50_1_79,

        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
        ) AS away_1_80_2_09,

        countIf(
            away_odds >= 2.10
            AND away_odds < 2.50
        ) AS away_2_10_2_49,

        countIf(
            away_odds >= 2.50
            AND away_odds < 3.00
        ) AS away_2_50_2_99,

        countIf(
            away_odds >= 3.00
            AND away_odds < 4.00
        ) AS away_3_00_3_99,

        countIf(away_odds >= 4.00)
            AS away_ge_4_00,


        /* =====================================================
           AWAY BANT SONUÇLARI
           ===================================================== */

        countIf(
            away_odds < 1.30
            AND result = 'A'
        ) AS away_lt_1_30_wins,

        countIf(
            away_odds < 1.30
            AND result = 'D'
        ) AS away_lt_1_30_draws,

        countIf(
            away_odds < 1.30
            AND result = 'H'
        ) AS away_lt_1_30_losses,


        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
            AND result = 'A'
        ) AS away_1_30_1_49_wins,

        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
            AND result = 'D'
        ) AS away_1_30_1_49_draws,

        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
            AND result = 'H'
        ) AS away_1_30_1_49_losses,


        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
            AND result = 'A'
        ) AS away_1_50_1_79_wins,

        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
            AND result = 'D'
        ) AS away_1_50_1_79_draws,

        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
            AND result = 'H'
        ) AS away_1_50_1_79_losses,


        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
            AND result = 'A'
        ) AS away_1_80_2_09_wins,

        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
            AND result = 'D'
        ) AS away_1_80_2_09_draws,

        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
            AND result = 'H'
        ) AS away_1_80_2_09_losses,


        countIf(
            away_odds >= 2.10
            AND away_odds < 2.50
            AND result = 'A'
        ) AS away_2_10_2_49_wins,

        countIf(
            away_odds >= 2.10
            AND away_odds < 2.50
            AND result = 'D'
        ) AS away_2_10_2_49_draws,

        countIf(
            away_odds >= 2.10
            AND away_odds < 2.50
            AND result = 'H'
        ) AS away_2_10_2_49_losses,


        countIf(
            away_odds >= 2.50
            AND away_odds < 3.00
            AND result = 'A'
        ) AS away_2_50_2_99_wins,

        countIf(
            away_odds >= 2.50
            AND away_odds < 3.00
            AND result = 'D'
        ) AS away_2_50_2_99_draws,

        countIf(
            away_odds >= 2.50
            AND away_odds < 3.00
            AND result = 'H'
        ) AS away_2_50_2_99_losses,


        countIf(
            away_odds >= 3.00
            AND away_odds < 4.00
            AND result = 'A'
        ) AS away_3_00_3_99_wins,

        countIf(
            away_odds >= 3.00
            AND away_odds < 4.00
            AND result = 'D'
        ) AS away_3_00_3_99_draws,

        countIf(
            away_odds >= 3.00
            AND away_odds < 4.00
            AND result = 'H'
        ) AS away_3_00_3_99_losses,


        countIf(
            away_odds >= 4.00
            AND result = 'A'
        ) AS away_ge_4_00_wins,

        countIf(
            away_odds >= 4.00
            AND result = 'D'
        ) AS away_ge_4_00_draws,

        countIf(
            away_odds >= 4.00
            AND result = 'H'
        ) AS away_ge_4_00_losses,


        /* =====================================================
           FAVORİ
           ===================================================== */

        countIf(favorite_type = 'H')
            AS home_favorite_matches,

        countIf(
            favorite_type = 'H'
            AND result = 'H'
        ) AS home_favorite_wins,

        countIf(favorite_type = 'D')
            AS draw_favorite_matches,

        countIf(
            favorite_type = 'D'
            AND result = 'D'
        ) AS draw_favorite_wins,

        countIf(favorite_type = 'A')
            AS away_favorite_matches,

        countIf(
            favorite_type = 'A'
            AND result = 'A'
        ) AS away_favorite_wins,


        /* =====================================================
           BÜYÜK SÜRPRİZLER
           -----------------------------------------------------
           En az bir sonucun oranı >= 5.00 ve o sonuç gerçekleşmiş.
           ===================================================== */

        countIf(
            home_odds >= 5.00
            AND result = 'H'
        ) AS high_odds_home_wins,

        countIf(
            draw_odds >= 5.00
            AND result = 'D'
        ) AS high_odds_draws,

        countIf(
            away_odds >= 5.00
            AND result = 'A'
        ) AS high_odds_away_wins,


        /* =====================================================
           ÇOK YÜKSEK SÜRPRİZLER
           ===================================================== */

        countIf(
            home_odds >= 7.00
            AND result = 'H'
        ) AS extreme_home_wins,

        countIf(
            draw_odds >= 7.00
            AND result = 'D'
        ) AS extreme_draws,

        countIf(
            away_odds >= 7.00
            AND result = 'A'
        ) AS extreme_away_wins


    FROM filtered

TYPE ENDPOINT
