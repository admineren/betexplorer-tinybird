DESCRIPTION >
  1X2 oran analizi.

  Tek endpoint / tek node.
  Kaynak: betexplorer_matches.

  Bölümler:
  - GENERAL
  - ODDS_BAND: HOME / DRAW / AWAY
  - CUSTOM: market + target_odds/tolerance
  - CUSTOM: market + range_min/range_max

  ODDS_BAND:
  - HOME ve AWAY aynı oran bantlarını kullanır.
  - DRAW için ayrı ve daha detaylı oran bantları kullanılır.
  - DRAW oranları 2.20 civarından başlar.
  - DRAW 3.00-4.00 aralığı daha küçük bantlara ayrılmıştır.
  - 4.00 üzeri oranlar ayrıca ayrılmıştır.
  - band_order ile sayısal sıralama yapılır.
  - Her bantta maç sayısı ve H/D/A adetleri tutulur.
  - H/D/A yüzdeleri ayrıca hesaplanır.


NODE odds_1x2_query
SQL >
%

/* ============================================================
   GENERAL
   ============================================================ */

SELECT
    'GENERAL' AS section,
    'ALL' AS market,
    'ALL' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,

    countIf(
        isNotNull(home_odds)
        AND isNotNull(draw_odds)
        AND isNotNull(away_odds)
    ) AS full_1x2_matches,

    round(avg(home_odds), 2) AS avg_home_odds,
    round(avg(draw_odds), 2) AS avg_draw_odds,
    round(avg(away_odds), 2) AS avg_away_odds,

    toUInt64(0) AS home_wins,
    toUInt64(0) AS draws,
    toUInt64(0) AS away_wins,

    toFloat64(0) AS home_pct,
    toFloat64(0) AS draw_pct,
    toFloat64(0) AS away_pct,

    toFloat64(0) AS target_odds,
    toFloat64(0) AS tolerance,
    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND isNotNull(home_odds)
  AND isNotNull(draw_odds)
  AND isNotNull(away_odds)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}


UNION ALL


/* ============================================================
   HOME ODDS
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,
    'HOME' AS market,

    CASE
        WHEN home_odds < 1.30 THEN '< 1.30'
        WHEN home_odds < 1.50 THEN '1.30-1.49'
        WHEN home_odds < 1.80 THEN '1.50-1.79'
        WHEN home_odds < 2.10 THEN '1.80-2.09'
        WHEN home_odds < 2.50 THEN '2.10-2.49'
        WHEN home_odds < 3.00 THEN '2.50-2.99'
        WHEN home_odds < 4.00 THEN '3.00-3.99'
        ELSE '>= 4.00'
    END AS odds_band,

    CASE
        WHEN home_odds < 1.30 THEN 1
        WHEN home_odds < 1.50 THEN 2
        WHEN home_odds < 1.80 THEN 3
        WHEN home_odds < 2.10 THEN 4
        WHEN home_odds < 2.50 THEN 5
        WHEN home_odds < 3.00 THEN 6
        WHEN home_odds < 4.00 THEN 7
        ELSE 8
    END AS band_order,

    count() AS matches,

    count() AS full_1x2_matches,

    round(avg(home_odds), 2) AS avg_home_odds,
    round(avg(draw_odds), 2) AS avg_draw_odds,
    round(avg(away_odds), 2) AS avg_away_odds,

    countIf(result = 'H') AS home_wins,
    countIf(result = 'D') AS draws,
    countIf(result = 'A') AS away_wins,

    round(countIf(result = 'H') * 100.0 / count(), 2) AS home_pct,
    round(countIf(result = 'D') * 100.0 / count(), 2) AS draw_pct,
    round(countIf(result = 'A') * 100.0 / count(), 2) AS away_pct,

    toFloat64(0) AS target_odds,
    toFloat64(0) AS tolerance,
    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND isNotNull(home_odds)
  AND isNotNull(draw_odds)
  AND isNotNull(away_odds)
  AND isNotNull(result)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

GROUP BY
    odds_band,
    band_order


UNION ALL


/* ============================================================
   DRAW ODDS
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,
    'DRAW' AS market,

    CASE
        WHEN draw_odds < 2.20 THEN '< 2.20'
        WHEN draw_odds < 2.50 THEN '2.20-2.49'
        WHEN draw_odds < 2.75 THEN '2.50-2.74'
        WHEN draw_odds < 3.00 THEN '2.75-2.99'
        WHEN draw_odds < 3.25 THEN '3.00-3.24'
        WHEN draw_odds < 3.50 THEN '3.25-3.49'
        WHEN draw_odds < 3.75 THEN '3.50-3.74'
        WHEN draw_odds < 4.00 THEN '3.75-3.99'
        WHEN draw_odds < 4.50 THEN '4.00-4.49'
        WHEN draw_odds < 5.00 THEN '4.50-4.99'
        ELSE '>= 5.00'
    END AS odds_band,

    CASE
        WHEN draw_odds < 2.20 THEN 1
        WHEN draw_odds < 2.50 THEN 2
        WHEN draw_odds < 2.75 THEN 3
        WHEN draw_odds < 3.00 THEN 4
        WHEN draw_odds < 3.25 THEN 5
        WHEN draw_odds < 3.50 THEN 6
        WHEN draw_odds < 3.75 THEN 7
        WHEN draw_odds < 4.00 THEN 8
        WHEN draw_odds < 4.50 THEN 9
        WHEN draw_odds < 5.00 THEN 10
        ELSE 11
    END AS band_order,

    count() AS matches,

    count() AS full_1x2_matches,

    round(avg(home_odds), 2) AS avg_home_odds,
    round(avg(draw_odds), 2) AS avg_draw_odds,
    round(avg(away_odds), 2) AS avg_away_odds,

    countIf(result = 'H') AS home_wins,
    countIf(result = 'D') AS draws,
    countIf(result = 'A') AS away_wins,

    round(countIf(result = 'H') * 100.0 / count(), 2) AS home_pct,
    round(countIf(result = 'D') * 100.0 / count(), 2) AS draw_pct,
    round(countIf(result = 'A') * 100.0 / count(), 2) AS away_pct,

    toFloat64(0) AS target_odds,
    toFloat64(0) AS tolerance,
    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND isNotNull(home_odds)
  AND isNotNull(draw_odds)
  AND isNotNull(away_odds)
  AND isNotNull(result)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

GROUP BY
    odds_band,
    band_order


UNION ALL


/* ============================================================
   AWAY ODDS
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,
    'AWAY' AS market,

    CASE
        WHEN away_odds < 1.30 THEN '< 1.30'
        WHEN away_odds < 1.50 THEN '1.30-1.49'
        WHEN away_odds < 1.80 THEN '1.50-1.79'
        WHEN away_odds < 2.10 THEN '1.80-2.09'
        WHEN away_odds < 2.50 THEN '2.10-2.49'
        WHEN away_odds < 3.00 THEN '2.50-2.99'
        WHEN away_odds < 4.00 THEN '3.00-3.99'
        ELSE '>= 4.00'
    END AS odds_band,

    CASE
        WHEN away_odds < 1.30 THEN 1
        WHEN away_odds < 1.50 THEN 2
        WHEN away_odds < 1.80 THEN 3
        WHEN away_odds < 2.10 THEN 4
        WHEN away_odds < 2.50 THEN 5
        WHEN away_odds < 3.00 THEN 6
        WHEN away_odds < 4.00 THEN 7
        ELSE 8
    END AS band_order,

    count() AS matches,

    count() AS full_1x2_matches,

    round(avg(home_odds), 2) AS avg_home_odds,
    round(avg(draw_odds), 2) AS avg_draw_odds,
    round(avg(away_odds), 2) AS avg_away_odds,

    countIf(result = 'H') AS home_wins,
    countIf(result = 'D') AS draws,
    countIf(result = 'A') AS away_wins,

    round(countIf(result = 'H') * 100.0 / count(), 2) AS home_pct,
    round(countIf(result = 'D') * 100.0 / count(), 2) AS draw_pct,
    round(countIf(result = 'A') * 100.0 / count(), 2) AS away_pct,

    toFloat64(0) AS target_odds,
    toFloat64(0) AS tolerance,
    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND isNotNull(home_odds)
  AND isNotNull(draw_odds)
  AND isNotNull(away_odds)
  AND isNotNull(result)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

GROUP BY
    odds_band,
    band_order


/* ============================================================
   CUSTOM - TARGET + TOLERANCE
   ============================================================ */

{% if defined(market) %}
{% if defined(target_odds) %}
{% if defined(tolerance) %}

UNION ALL

SELECT
    'CUSTOM' AS section,
    upper({{String(market)}}) AS market,
    'CUSTOM_RANGE' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,
    count() AS full_1x2_matches,

    round(avg(home_odds), 2) AS avg_home_odds,
    round(avg(draw_odds), 2) AS avg_draw_odds,
    round(avg(away_odds), 2) AS avg_away_odds,

    countIf(result = 'H') AS home_wins,
    countIf(result = 'D') AS draws,
    countIf(result = 'A') AS away_wins,

    round(countIf(result = 'H') * 100.0 / count(), 2) AS home_pct,
    round(countIf(result = 'D') * 100.0 / count(), 2) AS draw_pct,
    round(countIf(result = 'A') * 100.0 / count(), 2) AS away_pct,

    {{Float64(target_odds)}} AS target_odds,
    {{Float64(tolerance)}} AS tolerance,

    {{Float64(target_odds)}} - {{Float64(tolerance)}} AS range_min,
    {{Float64(target_odds)}} + {{Float64(tolerance)}} AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND isNotNull(home_odds)
  AND isNotNull(draw_odds)
  AND isNotNull(away_odds)
  AND isNotNull(result)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

AND
(
    (
        lower({{String(market)}}) = 'home'
        AND home_odds BETWEEN
            {{Float64(target_odds)}} - {{Float64(tolerance)}
            AND
            {{Float64(target_odds)}} + {{Float64(tolerance)}}
    )

    OR

    (
        lower({{String(market)}}) = 'draw'
        AND draw_odds BETWEEN
            {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND
            {{Float64(target_odds)}} + {{Float64(tolerance)}}
    )

    OR

    (
        lower({{String(market)}}) = 'away'
        AND away_odds BETWEEN
            {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND
            {{Float64(target_odds)}} + {{Float64(tolerance)}}
    )
)

{% end %}
{% end %}
{% end %}


/* ============================================================
   CUSTOM - DIRECT RANGE
   ============================================================ */

{% if defined(market) %}
{% if defined(range_min) %}
{% if defined(range_max) %}

UNION ALL

SELECT
    'CUSTOM' AS section,
    upper({{String(market)}}) AS market,
    'CUSTOM_RANGE' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,
    count() AS full_1x2_matches,

    round(avg(home_odds), 2) AS avg_home_odds,
    round(avg(draw_odds), 2) AS avg_draw_odds,
    round(avg(away_odds), 2) AS avg_away_odds,

    countIf(result = 'H') AS home_wins,
    countIf(result = 'D') AS draws,
    countIf(result = 'A') AS away_wins,

    round(countIf(result = 'H') * 100.0 / count(), 2) AS home_pct,
    round(countIf(result = 'D') * 100.0 / count(), 2) AS draw_pct,
    round(countIf(result = 'A') * 100.0 / count(), 2) AS away_pct,

    toFloat64(0) AS target_odds,
    toFloat64(0) AS tolerance,

    {{Float64(range_min)}} AS range_min,
    {{Float64(range_max)}} AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND isNotNull(home_odds)
  AND isNotNull(draw_odds)
  AND isNotNull(away_odds)
  AND isNotNull(result)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

AND
(
    (
        lower({{String(market)}}) = 'home'
        AND home_odds BETWEEN
            {{Float64(range_min)}}
            AND
            {{Float64(range_max)}}
    )

    OR

    (
        lower({{String(market)}}) = 'draw'
        AND draw_odds BETWEEN
            {{Float64(range_min)}}
            AND
            {{Float64(range_max)}}
    )

    OR

    (
        lower({{String(market)}}) = 'away'
        AND away_odds BETWEEN
            {{Float64(range_min)}}
            AND
            {{Float64(range_max)}}
    )
)

{% end %}
{% end %}
{% end %}


ORDER BY

    CASE
        WHEN section = 'GENERAL' THEN 0
        WHEN section = 'ODDS_BAND' THEN 1
        WHEN section = 'CUSTOM' THEN 2
        ELSE 9
    END,

    CASE
        WHEN market = 'ALL' THEN 0
        WHEN market = 'HOME' THEN 1
        WHEN market = 'DRAW' THEN 2
        WHEN market = 'AWAY' THEN 3
        ELSE 9
    END,

    band_order


TYPE ENDPOINT
