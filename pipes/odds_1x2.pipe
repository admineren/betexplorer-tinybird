DESCRIPTION >
    1X2 ORAN ANALİZİ

    Genel:
    - 1X2 oranlı maç sayısı
    - Home / Draw / Away ortalama oran
    - Home / Draw / Away gerçekleşme oranı

    Home:
    - Oran dağılımı
    - Oran bandı -> H/D/A sonucu

    Draw:
    - Oran dağılımı
    - Oran bandı -> H/D/A sonucu

    Away:
    - Oran dağılımı
    - Oran bandı -> H/D/A sonucu

    Favoriler:
    - Home favori
    - Draw favori
    - Away favori
    - Favori sonucu

    Sürpriz:
    - >=3
    - >=4
    - >=5
    - >=7

    Kullanıcı özel oran:
    - market = home / draw / away
    - target_odds
    - tolerance

    Örnek:
    market=home
    target_odds=1.25
    tolerance=0.10

    => 1.15 - 1.35 aralığındaki Home oranlarını analiz eder.

    Filtre:
    - country
    - league
    - season


NODE odds_1x2_query
SQL >

    %

    WITH filtered AS
    (
        SELECT
            match_id,
            date,
            country,
            league,
            season,
            home_team,
            away_team,
            result,

            toFloat64OrNull(home_odds) AS home_odds,
            toFloat64OrNull(draw_odds) AS draw_odds,
            toFloat64OrNull(away_odds) AS away_odds

        FROM betexplorer_matches

        WHERE
            has_odds = 'True'

            AND isNotNull(home_odds)
            AND isNotNull(draw_odds)
            AND isNotNull(away_odds)

            {% if defined(country) %}
            AND country = {{String(country)}}
            {% end %}

            {% if defined(league) %}
            AND league = {{String(league)}}
            {% end %}

            {% if defined(season) %}
            AND season = {{String(season)}}
            {% end %}
    ),

    prepared AS
    (
        SELECT
            *,

            least(
                home_odds,
                draw_odds,
                away_odds
            ) AS favorite_odds,

            multiIf(
                home_odds = least(
                    home_odds,
                    draw_odds,
                    away_odds
                ), 'H',

                draw_odds = least(
                    home_odds,
                    draw_odds,
                    away_odds
                ), 'D',

                'A'
            ) AS favorite_type

        FROM filtered
    )

    SELECT

        /* =====================================================
           GENEL
           ===================================================== */

        count() AS matches,

        round(avg(home_odds), 2)
            AS home_odds_avg,

        round(avg(draw_odds), 2)
            AS draw_odds_avg,

        round(avg(away_odds), 2)
            AS away_odds_avg,


        countIf(result = 'H')
            AS home_wins,

        countIf(result = 'D')
            AS draws,

        countIf(result = 'A')
            AS away_wins,


        round(
            countIf(result = 'H') * 100.0 / count(),
            2
        ) AS home_win_pct,

        round(
            countIf(result = 'D') * 100.0 / count(),
            2
        ) AS draw_pct,

        round(
            countIf(result = 'A') * 100.0 / count(),
            2
        ) AS away_win_pct,


        /* =====================================================
           HOME ORAN DAĞILIMI
           ===================================================== */

        countIf(home_odds < 1.30)
            AS home_lt_1_30,

        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
        ) AS home_1_30_1_49,

        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
        ) AS home_1_50_1_79,

        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
        ) AS home_1_80_2_09,

        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
        ) AS home_2_10_2_49,

        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
        ) AS home_2_50_2_99,

        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
        ) AS home_3_00_3_99,

        countIf(
            home_odds >= 4.00
            AND home_odds < 5.00
        ) AS home_4_00_4_99,

        countIf(
            home_odds >= 5.00
            AND home_odds < 7.00
        ) AS home_5_00_6_99,

        countIf(home_odds >= 7.00)
            AS home_ge_7_00,


        /* =====================================================
           HOME ORAN -> SONUÇ
           ===================================================== */

        countIf(
            home_odds < 1.30
            AND result = 'H'
        ) AS home_lt_1_30_H,

        countIf(
            home_odds < 1.30
            AND result = 'D'
        ) AS home_lt_1_30_D,

        countIf(
            home_odds < 1.30
            AND result = 'A'
        ) AS home_lt_1_30_A,


        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
            AND result = 'H'
        ) AS home_1_30_1_49_H,

        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
            AND result = 'D'
        ) AS home_1_30_1_49_D,

        countIf(
            home_odds >= 1.30
            AND home_odds < 1.50
            AND result = 'A'
        ) AS home_1_30_1_49_A,


        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
            AND result = 'H'
        ) AS home_1_50_1_79_H,

        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
            AND result = 'D'
        ) AS home_1_50_1_79_D,

        countIf(
            home_odds >= 1.50
            AND home_odds < 1.80
            AND result = 'A'
        ) AS home_1_50_1_79_A,


        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
            AND result = 'H'
        ) AS home_1_80_2_09_H,

        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
            AND result = 'D'
        ) AS home_1_80_2_09_D,

        countIf(
            home_odds >= 1.80
            AND home_odds < 2.10
            AND result = 'A'
        ) AS home_1_80_2_09_A,


        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
            AND result = 'H'
        ) AS home_2_10_2_49_H,

        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
            AND result = 'D'
        ) AS home_2_10_2_49_D,

        countIf(
            home_odds >= 2.10
            AND home_odds < 2.50
            AND result = 'A'
        ) AS home_2_10_2_49_A,


        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
            AND result = 'H'
        ) AS home_2_50_2_99_H,

        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
            AND result = 'D'
        ) AS home_2_50_2_99_D,

        countIf(
            home_odds >= 2.50
            AND home_odds < 3.00
            AND result = 'A'
        ) AS home_2_50_2_99_A,


        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
            AND result = 'H'
        ) AS home_3_00_3_99_H,

        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
            AND result = 'D'
        ) AS home_3_00_3_99_D,

        countIf(
            home_odds >= 3.00
            AND home_odds < 4.00
            AND result = 'A'
        ) AS home_3_00_3_99_A,


        /* =====================================================
           DRAW ORAN DAĞILIMI
           ===================================================== */

        countIf(draw_odds < 2.50)
            AS draw_lt_2_50,

        countIf(
            draw_odds >= 2.50
            AND draw_odds < 3.00
        ) AS draw_2_50_2_99,

        countIf(
            draw_odds >= 3.00
            AND draw_odds < 3.50
        ) AS draw_3_00_3_49,

        countIf(
            draw_odds >= 3.50
            AND draw_odds < 4.00
        ) AS draw_3_50_3_99,

        countIf(
            draw_odds >= 4.00
            AND draw_odds < 4.50
        ) AS draw_4_00_4_49,

        countIf(draw_odds >= 4.50)
            AS draw_ge_4_50,


        /* =====================================================
           DRAW -> SONUÇ
           ===================================================== */

        countIf(
            draw_odds < 2.50
            AND result = 'D'
        ) AS draw_lt_2_50_D,

        countIf(
            draw_odds >= 2.50
            AND draw_odds < 3.00
            AND result = 'D'
        ) AS draw_2_50_2_99_D,

        countIf(
            draw_odds >= 3.00
            AND draw_odds < 3.50
            AND result = 'D'
        ) AS draw_3_00_3_49_D,

        countIf(
            draw_odds >= 3.50
            AND draw_odds < 4.00
            AND result = 'D'
        ) AS draw_3_50_3_99_D,

        countIf(
            draw_odds >= 4.00
            AND draw_odds < 4.50
            AND result = 'D'
        ) AS draw_4_00_4_49_D,

        countIf(
            draw_odds >= 4.50
            AND result = 'D'
        ) AS draw_ge_4_50_D,


        /* =====================================================
           AWAY ORAN DAĞILIMI
           ===================================================== */

        countIf(away_odds < 1.30)
            AS away_lt_1_30,

        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
        ) AS away_1_30_1_49,

        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
        ) AS away_1_50_1_79,

        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
        ) AS away_1_80_2_09,

        countIf(
            away_odds >= 2.10
            AND away_odds < 2.50
        ) AS away_2_10_2_49,

        countIf(
            away_odds >= 2.50
            AND away_odds < 3.00
        ) AS away_2_50_2_99,

        countIf(
            away_odds >= 3.00
            AND away_odds < 4.00
        ) AS away_3_00_3_99,

        countIf(
            away_odds >= 4.00
            AND away_odds < 5.00
        ) AS away_4_00_4_99,

        countIf(
            away_odds >= 5.00
            AND away_odds < 7.00
        ) AS away_5_00_6_99,

        countIf(away_odds >= 7.00)
            AS away_ge_7_00,


        /* =====================================================
           AWAY -> SONUÇ
           ===================================================== */

        countIf(
            away_odds < 1.30
            AND result = 'A'
        ) AS away_lt_1_30_A,

        countIf(
            away_odds < 1.30
            AND result = 'D'
        ) AS away_lt_1_30_D,

        countIf(
            away_odds < 1.30
            AND result = 'H'
        ) AS away_lt_1_30_H,


        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
            AND result = 'A'
        ) AS away_1_30_1_49_A,

        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
            AND result = 'D'
        ) AS away_1_30_1_49_D,

        countIf(
            away_odds >= 1.30
            AND away_odds < 1.50
            AND result = 'H'
        ) AS away_1_30_1_49_H,


        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
            AND result = 'A'
        ) AS away_1_50_1_79_A,

        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
            AND result = 'D'
        ) AS away_1_50_1_79_D,

        countIf(
            away_odds >= 1.50
            AND away_odds < 1.80
            AND result = 'H'
        ) AS away_1_50_1_79_H,


        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
            AND result = 'A'
        ) AS away_1_80_2_09_A,

        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
            AND result = 'D'
        ) AS away_1_80_2_09_D,

        countIf(
            away_odds >= 1.80
            AND away_odds < 2.10
            AND result = 'H'
        ) AS away_1_80_2_09_H,


        /* =====================================================
           FAVORİ
           ===================================================== */

        countIf(favorite_type = 'H')
            AS home_favorite_matches,

        countIf(
            favorite_type = 'H'
            AND result = 'H'
        ) AS home_favorite_wins,

        countIf(
            favorite_type = 'H'
            AND result = 'D'
        ) AS home_favorite_draws,

        countIf(
            favorite_type = 'H'
            AND result = 'A'
        ) AS home_favorite_losses,


        countIf(favorite_type = 'D')
            AS draw_favorite_matches,

        countIf(
            favorite_type = 'D'
            AND result = 'D'
        ) AS draw_favorite_wins,


        countIf(favorite_type = 'A')
            AS away_favorite_matches,

        countIf(
            favorite_type = 'A'
            AND result = 'A'
        ) AS away_favorite_wins,

        countIf(
            favorite_type = 'A'
            AND result = 'D'
        ) AS away_favorite_draws,

        countIf(
            favorite_type = 'A'
            AND result = 'H'
        ) AS away_favorite_losses,


        /* =====================================================
           YÜKSEK ORAN GALİBİYETLERİ
           ===================================================== */

        countIf(
            home_odds >= 3.00
            AND result = 'H'
        ) AS home_ge_3_wins,

        countIf(
            home_odds >= 4.00
            AND result = 'H'
        ) AS home_ge_4_wins,

        countIf(
            home_odds >= 5.00
            AND result = 'H'
        ) AS home_ge_5_wins,

        countIf(
            home_odds >= 7.00
            AND result = 'H'
        ) AS home_ge_7_wins,


        countIf(
            draw_odds >= 3.00
            AND result = 'D'
        ) AS draw_ge_3_results,

        countIf(
            draw_odds >= 4.00
            AND result = 'D'
        ) AS draw_ge_4_results,

        countIf(
            draw_odds >= 5.00
            AND result = 'D'
        ) AS draw_ge_5_results,

        countIf(
            draw_odds >= 7.00
            AND result = 'D'
        ) AS draw_ge_7_results,


        countIf(
            away_odds >= 3.00
            AND result = 'A'
        ) AS away_ge_3_wins,

        countIf(
            away_odds >= 4.00
            AND result = 'A'
        ) AS away_ge_4_wins,

        countIf(
            away_odds >= 5.00
            AND result = 'A'
        ) AS away_ge_5_wins,

        countIf(
            away_odds >= 7.00
            AND result = 'A'
        ) AS away_ge_7_wins,


        /* =====================================================
           SÜRPRİZ
           ===================================================== */

        countIf(
            favorite_type = 'H'
            AND result = 'A'
        ) AS surprise_away_vs_home_favorite,

        countIf(
            favorite_type = 'A'
            AND result = 'H'
        ) AS surprise_home_vs_away_favorite,

        countIf(
            favorite_type = 'H'
            AND result = 'D'
        ) AS surprise_draw_vs_home_favorite,

        countIf(
            favorite_type = 'A'
            AND result = 'D'
        ) AS surprise_draw_vs_away_favorite,


        /* =====================================================
           KULLANICI ÖZEL ORAN SORGUSU
           ===================================================== */

        {% if defined(market) and defined(target_odds) and defined(tolerance) %}

        {% if defined(market) and market == 'home' %}

        countIf(
            home_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND home_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
        ) AS custom_matches,

        countIf(
            home_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND home_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'H'
        ) AS custom_H,

        countIf(
            home_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND home_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'D'
        ) AS custom_D,

        countIf(
            home_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND home_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'A'
        ) AS custom_A,

        round(
            custom_H * 100.0 / nullIf(custom_matches, 0),
            2
        ) AS custom_H_pct,

        round(
            custom_D * 100.0 / nullIf(custom_matches, 0),
            2
        ) AS custom_D_pct,

        round(
            custom_A * 100.0 / nullIf(custom_matches, 0),
            2
        ) AS custom_A_pct

        {% end %}

        {% if defined(market) and market == 'draw' %}

        countIf(
            draw_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND draw_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
        ) AS custom_matches,

        countIf(
            draw_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND draw_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'D'
        ) AS custom_D,

        countIf(
            draw_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND draw_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'H'
        ) AS custom_H,

        countIf(
            draw_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND draw_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'A'
        ) AS custom_A,

        round(
            custom_D * 100.0 / nullIf(custom_matches, 0),
            2
        ) AS custom_D_pct

        {% end %}

        {% if defined(market) and market == 'away' %}

        countIf(
            away_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND away_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
        ) AS custom_matches,

        countIf(
            away_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND away_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'A'
        ) AS custom_A,

        countIf(
            away_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND away_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'H'
        ) AS custom_H,

        countIf(
            away_odds >= {{Float64(target_odds)}} - {{Float64(tolerance)}}
            AND away_odds <= {{Float64(target_odds)}} + {{Float64(tolerance)}}
            AND result = 'D'
        ) AS custom_D,

        round(
            custom_A * 100.0 / nullIf(custom_matches, 0),
            2
        ) AS custom_A_pct

        {% end %}

        {% end %}

    FROM prepared

TYPE ENDPOINT
