DESCRIPTION >
    1X2 ORAN ANALİZİ

    GENEL
    - Oranlı maç sayısı
    - Tam 1X2 oranı bulunan maç sayısı
    - Home / Draw / Away ortalama oran
    - Gerçekleşen H / D / A dağılımı

    HOME ODDS
    - Sabit oran bantları
    - Her bant için H / D / A sonuçları
    - Yüzdesel dağılım

    DRAW ODDS
    - Sabit oran bantları
    - Her bant için H / D / A sonuçları
    - Yüzdesel dağılım

    AWAY ODDS
    - Sabit oran bantları
    - Her bant için H / D / A sonuçları
    - Yüzdesel dağılım

    ÖZEL ORAN SORGUSU
    - market = home / draw / away
    - target_odds
    - tolerance
    - Eşleşen maç sayısı
    - H / D / A sonuçları
    - İsteğe bağlı maç detayları

    FİLTRELER
    - country
    - league
    - season


NODE odds_1x2_query
SQL >

    %

    SELECT
        match_id,
        date,
        country,
        league,
        season,
        home_team,
        away_team,
        result,

        toFloat64(home_odds) AS home_odds,
        toFloat64(draw_odds) AS draw_odds,
        toFloat64(away_odds) AS away_odds

    FROM betexplorer_matches

    WHERE
        has_odds = 'True'

        AND isNotNull(home_odds)
        AND isNotNull(draw_odds)
        AND isNotNull(away_odds)

        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}

        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}

        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


NODE general_summary
SQL >

    SELECT

        'general' AS row_type,

        '' AS market,

        'GENEL' AS band,

        toUInt8(0) AS band_order,

        count() AS matches,

        count() AS odds_matches,

        count() AS complete_1x2_matches,

        countIf(result = 'H') AS home_wins,

        countIf(result = 'D') AS draws,

        countIf(result = 'A') AS away_wins,

        round(
            countIf(result = 'H') * 100.0 / count(),
            2
        ) AS home_pct,

        round(
            countIf(result = 'D') * 100.0 / count(),
            2
        ) AS draw_pct,

        round(
            countIf(result = 'A') * 100.0 / count(),
            2
        ) AS away_pct,

        round(avg(home_odds), 2)
            AS home_odds_avg,

        round(avg(draw_odds), 2)
            AS draw_odds_avg,

        round(avg(away_odds), 2)
            AS away_odds_avg,

        toFloat64(0) AS target_odds,

        toFloat64(0) AS tolerance,

        toFloat64(0) AS range_min,

        toFloat64(0) AS range_max,

        '' AS match_id,

        toDate('1970-01-01') AS date,

        '' AS home_team,

        '' AS away_team,

        toFloat64(0) AS home_odds,

        toFloat64(0) AS draw_odds,

        toFloat64(0) AS away_odds,

        '' AS result

    FROM filtered_odds


NODE band_rows
SQL >

    SELECT

        'band' AS row_type,

        'home' AS market,

        multiIf(

            home_odds < 1.30,
            '< 1.30',

            home_odds < 1.50,
            '1.30-1.49',

            home_odds < 1.80,
            '1.50-1.79',

            home_odds < 2.10,
            '1.80-2.09',

            home_odds < 2.50,
            '2.10-2.49',

            home_odds < 3.00,
            '2.50-2.99',

            home_odds < 4.00,
            '3.00-3.99',

            '>= 4.00'

        ) AS band,

        multiIf(

            home_odds < 1.30, 1,
            home_odds < 1.50, 2,
            home_odds < 1.80, 3,
            home_odds < 2.10, 4,
            home_odds < 2.50, 5,
            home_odds < 3.00, 6,
            home_odds < 4.00, 7,
            8

        ) AS band_order,

        toFloat64(home_odds) AS selected_odds,

        result

    FROM filtered_odds


    UNION ALL


    SELECT

        'band' AS row_type,

        'draw' AS market,

        multiIf(

            draw_odds < 2.50,
            '< 2.50',

            draw_odds < 3.00,
            '2.50-2.99',

            draw_odds < 3.50,
            '3.00-3.49',

            draw_odds < 4.00,
            '3.50-3.99',

            draw_odds < 4.50,
            '4.00-4.49',

            draw_odds < 5.00,
            '4.50-4.99',

            '>= 5.00'

        ) AS band,

        multiIf(

            draw_odds < 2.50, 1,
            draw_odds < 3.00, 2,
            draw_odds < 3.50, 3,
            draw_odds < 4.00, 4,
            draw_odds < 4.50, 5,
            draw_odds < 5.00, 6,
            7

        ) AS band_order,

        toFloat64(draw_odds) AS selected_odds,

        result

    FROM filtered_odds


    UNION ALL


    SELECT

        'band' AS row_type,

        'away' AS market,

        multiIf(

            away_odds < 1.50,
            '< 1.50',

            away_odds < 1.80,
            '1.50-1.79',

            away_odds < 2.10,
            '1.80-2.09',

            away_odds < 2.50,
            '2.10-2.49',

            away_odds < 3.00,
            '2.50-2.99',

            away_odds < 4.00,
            '3.00-3.99',

            '>= 4.00'

        ) AS band,

        multiIf(

            away_odds < 1.50, 1,
            away_odds < 1.80, 2,
            away_odds < 2.10, 3,
            away_odds < 2.50, 4,
            away_odds < 3.00, 5,
            away_odds < 4.00, 6,
            7

        ) AS band_order,

        toFloat64(away_odds) AS selected_odds,

        result

    FROM filtered_odds


NODE band_summary
SQL >

    SELECT

        'band' AS row_type,

        market,

        band,

        band_order,

        count() AS matches,

        toUInt64(0) AS odds_matches,

        toUInt64(0) AS complete_1x2_matches,

        countIf(result = 'H') AS home_wins,

        countIf(result = 'D') AS draws,

        countIf(result = 'A') AS away_wins,

        round(
            countIf(result = 'H') * 100.0 / count(),
            2
        ) AS home_pct,

        round(
            countIf(result = 'D') * 100.0 / count(),
            2
        ) AS draw_pct,

        round(
            countIf(result = 'A') * 100.0 / count(),
            2
        ) AS away_pct,

        toFloat64(0) AS home_odds_avg,

        toFloat64(0) AS draw_odds_avg,

        toFloat64(0) AS away_odds_avg,

        toFloat64(0) AS target_odds,

        toFloat64(0) AS tolerance,

        min(selected_odds) AS range_min,

        max(selected_odds) AS range_max,

        '' AS match_id,

        toDate('1970-01-01') AS date,

        '' AS home_team,

        '' AS away_team,

        toFloat64(0) AS home_odds,

        toFloat64(0) AS draw_odds,

        toFloat64(0) AS away_odds,

        '' AS result

    FROM band_rows

    GROUP BY
        market,
        band,
        band_order


NODE custom_summary
SQL >

    %

    SELECT

        'custom_summary' AS row_type,

        {{String(market, 'home')}} AS market,

        concat(
            toString(round({{Float64(target_odds)}}, 2)),
            ' ± ',
            toString(round({{Float64(tolerance)}}, 2))
        ) AS band,

        toUInt8(0) AS band_order,

        count() AS matches,

        toUInt64(0) AS odds_matches,

        toUInt64(0) AS complete_1x2_matches,

        countIf(result = 'H') AS home_wins,

        countIf(result = 'D') AS draws,

        countIf(result = 'A') AS away_wins,

        round(
            countIf(result = 'H') * 100.0 / count(),
            2
        ) AS home_pct,

        round(
            countIf(result = 'D') * 100.0 / count(),
            2
        ) AS draw_pct,

        round(
            countIf(result = 'A') * 100.0 / count(),
            2
        ) AS away_pct,

        toFloat64(0) AS home_odds_avg,

        toFloat64(0) AS draw_odds_avg,

        toFloat64(0) AS away_odds_avg,

        {{Float64(target_odds)}} AS target_odds,

        {{Float64(tolerance)}} AS tolerance,

        {{Float64(target_odds)}} -
            {{Float64(tolerance)}} AS range_min,

        {{Float64(target_odds)}} +
            {{Float64(tolerance)}} AS range_max,

        '' AS match_id,

        toDate('1970-01-01') AS date,

        '' AS home_team,

        '' AS away_team,

        toFloat64(0) AS home_odds,

        toFloat64(0) AS draw_odds,

        toFloat64(0) AS away_odds,

        '' AS result

    FROM filtered_odds

    WHERE

        multiIf(

            {{String(market, 'home')}} = 'home',
            home_odds,

            {{String(market, 'home')}} = 'draw',
            draw_odds,

            away_odds

        )

        BETWEEN

            {{Float64(target_odds)}} -
            {{Float64(tolerance)}}

        AND

            {{Float64(target_odds)}} +
            {{Float64(tolerance)}}


NODE custom_matches
SQL >

    %

    SELECT

        'custom_match' AS row_type,

        {{String(market, 'home')}} AS market,

        concat(
            toString(round({{Float64(target_odds)}}, 2)),
            ' ± ',
            toString(round({{Float64(tolerance)}}, 2))
        ) AS band,

        toUInt8(0) AS band_order,

        toUInt64(1) AS matches,

        toUInt64(0) AS odds_matches,

        toUInt64(0) AS complete_1x2_matches,

        if(result = 'H', toUInt64(1), toUInt64(0))
            AS home_wins,

        if(result = 'D', toUInt64(1), toUInt64(0))
            AS draws,

        if(result = 'A', toUInt64(1), toUInt64(0))
            AS away_wins,

        if(result = 'H', 100.0, 0.0)
            AS home_pct,

        if(result = 'D', 100.0, 0.0)
            AS draw_pct,

        if(result = 'A', 100.0, 0.0)
            AS away_pct,

        toFloat64(0) AS home_odds_avg,

        toFloat64(0) AS draw_odds_avg,

        toFloat64(0) AS away_odds_avg,

        {{Float64(target_odds)}} AS target_odds,

        {{Float64(tolerance)}} AS tolerance,

        {{Float64(target_odds)}} -
            {{Float64(tolerance)}} AS range_min,

        {{Float64(target_odds)}} +
            {{Float64(tolerance)}} AS range_max,

        match_id,

        date,

        home_team,

        away_team,

        home_odds,

        draw_odds,

        away_odds,

        result

    FROM filtered_odds

    WHERE

        multiIf(

            {{String(market, 'home')}} = 'home',
            home_odds,

            {{String(market, 'home')}} = 'draw',
            draw_odds,

            away_odds

        )

        BETWEEN

            {{Float64(target_odds)}} -
            {{Float64(tolerance)}}

        AND

            {{Float64(target_odds)}} +
            {{Float64(tolerance)}}

    ORDER BY date DESC

    LIMIT {{Int32(detail_limit, 100) }}


NODE endpoint
SQL >

    %

    {% if defined(market) %}
    {% if market != 'home' and market != 'draw' and market != 'away' %}
    {{error('market must be home, draw or away')}}
    {% end %}
    {% end %}

    {% if defined(target_odds) and not defined(tolerance) %}
    {{error('target_odds and tolerance must be provided together')}}
    {% end %}

    {% if defined(tolerance) and not defined(target_odds) %}
    {{error('target_odds and tolerance must be provided together')}}
    {% end %}

    SELECT
        *
    FROM general_summary

    UNION ALL

    SELECT
        *
    FROM band_summary

    {% if defined(target_odds) and defined(tolerance) %}

    UNION ALL

    SELECT
        *
    FROM custom_summary

    UNION ALL

    SELECT
        *
    FROM custom_matches

    {% end %}

    ORDER BY

        row_type,
        market,
        band_order,
        date DESC

TYPE ENDPOINT
