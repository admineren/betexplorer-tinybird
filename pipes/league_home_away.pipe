DESCRIPTION >
    Lig ev sahibi / deplasman analizi.

    Ligdeki tüm tamamlanmış maçları iki perspektiften inceler:

    EV SAHİBİ:
    - Galibiyet
    - Beraberlik
    - Mağlubiyet
    - Gol
    - Gol ortalaması
    - Yediği gol
    - Yediği gol ortalaması
    - Gol attığı maçlar
    - Clean sheet
    - Attığı gol dağılımı

    DEPLASMAN:
    - Galibiyet
    - Beraberlik
    - Mağlubiyet
    - Gol
    - Gol ortalaması
    - Yediği gol
    - Yediği gol ortalaması
    - Gol attığı maçlar
    - Clean sheet
    - Attığı gol dağılımı

    Parametreler:

    country  : zorunlu
    league   : zorunlu
    season   : opsiyonel


NODE league_home_away_query
SQL >
    %

    SELECT

        /* =====================================================
           GENEL
           ===================================================== */

        matches,


        /* =====================================================
           EV SAHİBİ SONUÇLARI
           ===================================================== */

        home_wins,
        home_draws,
        home_losses,

        round(
            if(matches = 0, 0, home_wins * 100.0 / matches),
            2
        ) AS home_win_pct,

        round(
            if(matches = 0, 0, home_draws * 100.0 / matches),
            2
        ) AS home_draw_pct,

        round(
            if(matches = 0, 0, home_losses * 100.0 / matches),
            2
        ) AS home_loss_pct,


        /* =====================================================
           DEPLASMAN SONUÇLARI
           ===================================================== */

        away_wins,
        away_draws,
        away_losses,

        round(
            if(matches = 0, 0, away_wins * 100.0 / matches),
            2
        ) AS away_win_pct,

        round(
            if(matches = 0, 0, away_draws * 100.0 / matches),
            2
        ) AS away_draw_pct,

        round(
            if(matches = 0, 0, away_losses * 100.0 / matches),
            2
        ) AS away_loss_pct,


        /* =====================================================
           EV SAHİBİ GOLLERİ
           ===================================================== */

        home_goals,

        home_conceded_goals,

        round(
            if(matches = 0, 0, home_goals * 1.0 / matches),
            2
        ) AS home_goals_avg,

        round(
            if(
                matches = 0,
                0,
                home_conceded_goals * 1.0 / matches
            ),
            2
        ) AS home_conceded_avg,


        home_scored_matches,

        round(
            if(
                matches = 0,
                0,
                home_scored_matches * 100.0 / matches
            ),
            2
        ) AS home_scored_pct,


        home_clean_sheets,

        round(
            if(
                matches = 0,
                0,
                home_clean_sheets * 100.0 / matches
            ),
            2
        ) AS home_clean_sheet_pct,


        /* =====================================================
           DEPLASMAN GOLLERİ
           ===================================================== */

        away_goals,

        away_conceded_goals,

        round(
            if(matches = 0, 0, away_goals * 1.0 / matches),
            2
        ) AS away_goals_avg,

        round(
            if(
                matches = 0,
                0,
                away_conceded_goals * 1.0 / matches
            ),
            2
        ) AS away_conceded_avg,


        away_scored_matches,

        round(
            if(
                matches = 0,
                0,
                away_scored_matches * 100.0 / matches
            ),
            2
        ) AS away_scored_pct,


        away_clean_sheets,

        round(
            if(
                matches = 0,
                0,
                away_clean_sheets * 100.0 / matches
            ),
            2
        ) AS away_clean_sheet_pct,


        /* =====================================================
           EV SAHİBİ GOL DAĞILIMI
           ===================================================== */

        home_goals_0,
        home_goals_1,
        home_goals_2_3,
        home_goals_4_5,
        home_goals_6_plus,

        round(
            if(matches = 0, 0, home_goals_0 * 100.0 / matches),
            2
        ) AS home_goals_0_pct,

        round(
            if(matches = 0, 0, home_goals_1 * 100.0 / matches),
            2
        ) AS home_goals_1_pct,

        round(
            if(matches = 0, 0, home_goals_2_3 * 100.0 / matches),
            2
        ) AS home_goals_2_3_pct,

        round(
            if(matches = 0, 0, home_goals_4_5 * 100.0 / matches),
            2
        ) AS home_goals_4_5_pct,

        round(
            if(matches = 0, 0, home_goals_6_plus * 100.0 / matches),
            2
        ) AS home_goals_6_plus_pct,


        /* =====================================================
           DEPLASMAN GOL DAĞILIMI
           ===================================================== */

        away_goals_0,
        away_goals_1,
        away_goals_2_3,
        away_goals_4_5,
        away_goals_6_plus,

        round(
            if(matches = 0, 0, away_goals_0 * 100.0 / matches),
            2
        ) AS away_goals_0_pct,

        round(
            if(matches = 0, 0, away_goals_1 * 100.0 / matches),
            2
        ) AS away_goals_1_pct,

        round(
            if(matches = 0, 0, away_goals_2_3 * 100.0 / matches),
            2
        ) AS away_goals_2_3_pct,

        round(
            if(matches = 0, 0, away_goals_4_5 * 100.0 / matches),
            2
        ) AS away_goals_4_5_pct,

        round(
            if(matches = 0, 0, away_goals_6_plus * 100.0 / matches),
            2
        ) AS away_goals_6_plus_pct


    FROM
    (

        SELECT

            /* =================================================
               GENEL
               ================================================= */

            count() AS matches,


            /* =================================================
               EV SAHİBİ SONUÇLARI
               ================================================= */

            countIf(
                ft_home > ft_away
            ) AS home_wins,

            countIf(
                ft_home = ft_away
            ) AS home_draws,

            countIf(
                ft_home < ft_away
            ) AS home_losses,


            /* =================================================
               DEPLASMAN SONUÇLARI
               ================================================= */

            countIf(
                ft_away > ft_home
            ) AS away_wins,

            countIf(
                ft_home = ft_away
            ) AS away_draws,

            countIf(
                ft_away < ft_home
            ) AS away_losses,


            /* =================================================
               EV SAHİBİ GOLLERİ
               ================================================= */

            sum(ft_home) AS home_goals,

            sum(ft_away) AS home_conceded_goals,

            countIf(
                ft_home > 0
            ) AS home_scored_matches,

            countIf(
                ft_away = 0
            ) AS home_clean_sheets,


            /* =================================================
               DEPLASMAN GOLLERİ
               ================================================= */

            sum(ft_away) AS away_goals,

            sum(ft_home) AS away_conceded_goals,

            countIf(
                ft_away > 0
            ) AS away_scored_matches,

            countIf(
                ft_home = 0
            ) AS away_clean_sheets,


            /* =================================================
               EV SAHİBİ GOL DAĞILIMI
               ================================================= */

            countIf(
                ft_home = 0
            ) AS home_goals_0,

            countIf(
                ft_home = 1
            ) AS home_goals_1,

            countIf(
                ft_home BETWEEN 2 AND 3
            ) AS home_goals_2_3,

            countIf(
                ft_home BETWEEN 4 AND 5
            ) AS home_goals_4_5,

            countIf(
                ft_home >= 6
            ) AS home_goals_6_plus,


            /* =================================================
               DEPLASMAN GOL DAĞILIMI
               ================================================= */

            countIf(
                ft_away = 0
            ) AS away_goals_0,

            countIf(
                ft_away = 1
            ) AS away_goals_1,

            countIf(
                ft_away BETWEEN 2 AND 3
            ) AS away_goals_2_3,

            countIf(
                ft_away BETWEEN 4 AND 5
            ) AS away_goals_4_5,

            countIf(
                ft_away >= 6
            ) AS away_goals_6_plus


        FROM betexplorer_matches

        WHERE

            /* =================================================
               ZORUNLU FİLTRELER
               ================================================= */

            country = {{String(country)}}

            AND league = {{String(league)}}


            /* =================================================
               TAMAMLANMIŞ MAÇLAR
               ================================================= */

            AND ft_home IS NOT NULL
            AND ft_away IS NOT NULL


            /* =================================================
               SEZON OPSİYONEL
               ================================================= */

            {% if defined(season) %}
            AND season = {{String(season)}}
            {% end %}

    )


TYPE ENDPOINT
