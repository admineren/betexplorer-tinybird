DESCRIPTION >
    Takım skor analizi.

    Tüm skorlar analiz edilen takımın perspektifindedir.

    Genel:
    - Maç sonu skorları
    - İlk yarı skorları
    - İkinci yarı skorları
    - HT -> FT skorları

    İç saha:
    - Maç sonu skorları
    - İlk yarı skorları
    - İkinci yarı skorları
    - HT -> FT skorları

    Deplasman:
    - Maç sonu skorları
    - İlk yarı skorları
    - İkinci yarı skorları
    - HT -> FT skorları

    Parametreler:
    team
    country
    league
    season
    limit


NODE team_scores_base
SQL >
    %

    SELECT

        if(
            home_team = {{String(team)}},
            'home',
            'away'
        ) AS venue,

        /* ================================
           MAÇ SONU
           ================================ */

        if(
            home_team = {{String(team)}},
            ft_home,
            ft_away
        ) AS team_ft_goals,

        if(
            home_team = {{String(team)}},
            ft_away,
            ft_home
        ) AS opponent_ft_goals,


        /* ================================
           İLK YARI
           ================================ */

        if(
            home_team = {{String(team)}},
            ht_home,
            ht_away
        ) AS team_ht_goals,

        if(
            home_team = {{String(team)}},
            ht_away,
            ht_home
        ) AS opponent_ht_goals,


        /* ================================
           İKİNCİ YARI
           ================================ */

        if(
            home_team = {{String(team)}},
            ft_home - ht_home,
            ft_away - ht_away
        ) AS team_2h_goals,

        if(
            home_team = {{String(team)}},
            ft_away - ht_away,
            ft_home - ht_home
        ) AS opponent_2h_goals


    FROM betexplorer_matches


    WHERE

        (
            home_team = {{String(team)}}
            OR
            away_team = {{String(team)}}
        )

        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL

        AND ht_home IS NOT NULL
        AND ht_away IS NOT NULL


        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}


        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}


        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


NODE team_scores_grouped
SQL >
    SELECT

        'general' AS scope,
        'ft' AS score_type,

        concat(
            toString(team_ft_goals),
            '-',
            toString(opponent_ft_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    GROUP BY
        team_ft_goals,
        opponent_ft_goals


    UNION ALL


    SELECT

        'general' AS scope,
        'ht' AS score_type,

        concat(
            toString(team_ht_goals),
            '-',
            toString(opponent_ht_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    GROUP BY
        team_ht_goals,
        opponent_ht_goals


    UNION ALL


    SELECT

        'general' AS scope,
        'second_half' AS score_type,

        concat(
            toString(team_2h_goals),
            '-',
            toString(opponent_2h_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    GROUP BY
        team_2h_goals,
        opponent_2h_goals


    UNION ALL


    SELECT

        'general' AS scope,
        'ht_ft' AS score_type,

        concat(

            toString(team_ht_goals),
            '-',
            toString(opponent_ht_goals),

            ' → ',

            toString(team_ft_goals),
            '-',
            toString(opponent_ft_goals)

        ) AS score,

        count() AS score_count

    FROM team_scores_base

    GROUP BY

        team_ht_goals,
        opponent_ht_goals,

        team_ft_goals,
        opponent_ft_goals


    /* =========================================================
       İÇ SAHA
       ========================================================= */


    UNION ALL


    SELECT

        'home' AS scope,
        'ft' AS score_type,

        concat(
            toString(team_ft_goals),
            '-',
            toString(opponent_ft_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'home'

    GROUP BY
        team_ft_goals,
        opponent_ft_goals


    UNION ALL


    SELECT

        'home' AS scope,
        'ht' AS score_type,

        concat(
            toString(team_ht_goals),
            '-',
            toString(opponent_ht_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'home'

    GROUP BY
        team_ht_goals,
        opponent_ht_goals


    UNION ALL


    SELECT

        'home' AS scope,
        'second_half' AS score_type,

        concat(
            toString(team_2h_goals),
            '-',
            toString(opponent_2h_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'home'

    GROUP BY
        team_2h_goals,
        opponent_2h_goals


    UNION ALL


    SELECT

        'home' AS scope,
        'ht_ft' AS score_type,

        concat(

            toString(team_ht_goals),
            '-',
            toString(opponent_ht_goals),

            ' → ',

            toString(team_ft_goals),
            '-',
            toString(opponent_ft_goals)

        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'home'

    GROUP BY

        team_ht_goals,
        opponent_ht_goals,

        team_ft_goals,
        opponent_ft_goals


    /* =========================================================
       DEPLASMAN
       ========================================================= */


    UNION ALL


    SELECT

        'away' AS scope,
        'ft' AS score_type,

        concat(
            toString(team_ft_goals),
            '-',
            toString(opponent_ft_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'away'

    GROUP BY
        team_ft_goals,
        opponent_ft_goals


    UNION ALL


    SELECT

        'away' AS scope,
        'ht' AS score_type,

        concat(
            toString(team_ht_goals),
            '-',
            toString(opponent_ht_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'away'

    GROUP BY
        team_ht_goals,
        opponent_ht_goals


    UNION ALL


    SELECT

        'away' AS scope,
        'second_half' AS score_type,

        concat(
            toString(team_2h_goals),
            '-',
            toString(opponent_2h_goals)
        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'away'

    GROUP BY
        team_2h_goals,
        opponent_2h_goals


    UNION ALL


    SELECT

        'away' AS scope,
        'ht_ft' AS score_type,

        concat(

            toString(team_ht_goals),
            '-',
            toString(opponent_ht_goals),

            ' → ',

            toString(team_ft_goals),
            '-',
            toString(opponent_ft_goals)

        ) AS score,

        count() AS score_count

    FROM team_scores_base

    WHERE venue = 'away'

    GROUP BY

        team_ht_goals,
        opponent_ht_goals,

        team_ft_goals,
        opponent_ft_goals


NODE team_scores_query
SQL >
    %

    SELECT

        scope,
        score_type,
        score,
        score_count,

        sum(score_count) OVER (
            PARTITION BY scope, score_type
        ) AS matches,

        round(
            score_count * 100.0
            /
            sum(score_count) OVER (
                PARTITION BY scope, score_type
            ),
            2
        ) AS pct

    FROM team_scores_grouped

    ORDER BY
        scope,
        score_type,
        score_count DESC

    LIMIT {{Int32(limit, 10)}} BY
        scope,
        score_type


TYPE ENDPOINT
