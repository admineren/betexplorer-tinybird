DESCRIPTION >
    Lig genel analiz özeti.

    Zorunlu parametreler:
    - country
    - league

    Opsiyonel:
    - season

    Genel:
    - Toplam maç
    - Takım sayısı
    - Ev sahibi galibiyet
    - Beraberlik
    - Deplasman galibiyeti
    - Toplam gol
    - Maç başına gol
    - Ev sahibi gol ortalaması
    - Deplasman gol ortalaması
    - Over 1.5
    - Over 2.5
    - BTTS

    İlk yarı:
    - Ev sahibi önde
    - Beraberlik
    - Deplasman önde

    İkinci yarı:
    - Ev sahibi üstün
    - Eşit
    - Deplasman üstün

    Parametreler:
    country
    league
    season


NODE league_general_query
SQL >

    %

    SELECT

        /* =====================================================
           LİG BİLGİSİ
           ===================================================== */

        {{String(country)}} AS country,

        {{String(league)}} AS league,


        /* =====================================================
           GENEL MAÇ
           ===================================================== */

        count() AS matches,


        uniqExact(home_team) AS home_team_count,


        /* =====================================================
           SONUÇLAR
           ===================================================== */

        countIf(
            ft_home > ft_away
        ) AS home_wins,

        countIf(
            ft_home = ft_away
        ) AS draws,

        countIf(
            ft_home < ft_away
        ) AS away_wins,


        round(
            if(
                matches = 0,
                0,
                home_wins * 100.0 / matches
            ),
            2
        ) AS home_win_pct,


        round(
            if(
                matches = 0,
                0,
                draws * 100.0 / matches
            ),
            2
        ) AS draw_pct,


        round(
            if(
                matches = 0,
                0,
                away_wins * 100.0 / matches
            ),
            2
        ) AS away_win_pct,


        /* =====================================================
           GOLLER
           ===================================================== */

        sum(ft_home) AS home_goals,

        sum(ft_away) AS away_goals,

        sum(ft_home + ft_away) AS total_goals,


        round(
            if(
                matches = 0,
                0,
                sum(ft_home + ft_away) * 1.0 / matches
            ),
            2
        ) AS goals_per_match,


        round(
            if(
                matches = 0,
                0,
                sum(ft_home) * 1.0 / matches
            ),
            2
        ) AS home_goals_avg,


        round(
            if(
                matches = 0,
                0,
                sum(ft_away) * 1.0 / matches
            ),
            2
        ) AS away_goals_avg,


        /* =====================================================
           OVER 1.5 / 2.5
           ===================================================== */

        countIf(
            ft_home + ft_away >= 2
        ) AS over_1_5,


        round(
            if(
                matches = 0,
                0,
                over_1_5 * 100.0 / matches
            ),
            2
        ) AS over_1_5_pct,


        countIf(
            ft_home + ft_away >= 3
        ) AS over_2_5,


        round(
            if(
                matches = 0,
                0,
                over_2_5 * 100.0 / matches
            ),
            2
        ) AS over_2_5_pct,


        /* =====================================================
           BTTS
           ===================================================== */

        countIf(
            ft_home > 0
            AND
            ft_away > 0
        ) AS btts_yes,


        countIf(
            ft_home = 0
            OR
            ft_away = 0
        ) AS btts_no,


        round(
            if(
                matches = 0,
                0,
                btts_yes * 100.0 / matches
            ),
            2
        ) AS btts_yes_pct,


        round(
            if(
                matches = 0,
                0,
                btts_no * 100.0 / matches
            ),
            2
        ) AS btts_no_pct,


        /* =====================================================
           İLK YARI
           ===================================================== */

        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
        ) AS ht_matches,


        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND
            ht_home > ht_away
        ) AS ht_home_wins,


        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND
            ht_home = ht_away
        ) AS ht_draws,


        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND
            ht_home < ht_away
        ) AS ht_away_wins,


        round(
            if(
                ht_matches = 0,
                0,
                ht_home_wins * 100.0 / ht_matches
            ),
            2
        ) AS ht_home_win_pct,


        round(
            if(
                ht_matches = 0,
                0,
                ht_draws * 100.0 / ht_matches
            ),
            2
        ) AS ht_draw_pct,


        round(
            if(
                ht_matches = 0,
                0,
                ht_away_wins * 100.0 / ht_matches
            ),
            2
        ) AS ht_away_win_pct,


        /* =====================================================
           İKİNCİ YARI
           ===================================================== */

        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
        ) AS second_half_matches,


        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND
            (ft_home - ht_home) > (ft_away - ht_away)
        ) AS second_half_home_wins,


        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND
            (ft_home - ht_home) = (ft_away - ht_away)
        ) AS second_half_draws,


        countIf(
            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND
            (ft_home - ht_home) < (ft_away - ht_away)
        ) AS second_half_away_wins,


        round(
            if(
                second_half_matches = 0,
                0,
                second_half_home_wins * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_home_win_pct,


        round(
            if(
                second_half_matches = 0,
                0,
                second_half_draws * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_draw_pct,


        round(
            if(
                second_half_matches = 0,
                0,
                second_half_away_wins * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_away_win_pct


    FROM betexplorer_matches


    /* =========================================================
       LİG FİLTRESİ
       ========================================================= */

    WHERE

        country = {{String(country)}}

        AND

        league = {{String(league)}}


        /* =====================================================
           SEASON OPSİYONEL
           ===================================================== */

        {% if defined(season) %}

        AND season = {{String(season)}}

        {% end %}


        /* =====================================================
           SADECE TAMAMLANMIŞ MAÇLAR
           ===================================================== */

        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL


TYPE ENDPOINT
