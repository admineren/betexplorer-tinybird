DESCRIPTION >
    İki takım arasındaki H2H analizi.

    Takım 1 ve Takım 2 perspektifinden hesaplanır.

    Sonuçlar:

    G = Takım 1 galibiyeti
    B = Beraberlik
    M = Takım 1 mağlubiyeti

    Analiz kapsamı:

    - Genel H2H sonucu
    - Takım 1'in sahasındaki sonuçlar
    - Takım 2'nin sahasındaki sonuçlar
    - Takım 1 gol ortalaması
    - Takım 2 gol ortalaması
    - Toplam gol ortalaması
    - Over 1.5
    - Over 2.5
    - BTTS
    - Son H2H maçları

    Opsiyonel filtreler:

    country
    league
    season

    limit:

    Son H2H maçlarında gösterilecek maksimum maç sayısı.


NODE team_h2h_query
SQL >
    %

    /* =========================================================
       GENEL H2H
       ========================================================= */

    SELECT

        'general' AS section,

        count() AS matches,

        countIf(
            (
                home_team = {{String(team1)}}
                AND ft_home > ft_away
            )
            OR
            (
                away_team = {{String(team1)}}
                AND ft_away > ft_home
            )
        ) AS team1_wins,

        countIf(
            ft_home = ft_away
        ) AS draws,

        countIf(
            (
                home_team = {{String(team2)}}
                AND ft_home > ft_away
            )
            OR
            (
                away_team = {{String(team2)}}
                AND ft_away > ft_home
            )
        ) AS team2_wins,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    (
                        home_team = {{String(team1)}}
                        AND ft_home > ft_away
                    )
                    OR
                    (
                        away_team = {{String(team1)}}
                        AND ft_away > ft_home
                    )
                ) * 100.0 / count()
            ),
            2
        ) AS team1_win_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home = ft_away)
                * 100.0 / count()
            ),
            2
        ) AS draw_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    (
                        home_team = {{String(team2)}}
                        AND ft_home > ft_away
                    )
                    OR
                    (
                        away_team = {{String(team2)}}
                        AND ft_away > ft_home
                    )
                ) * 100.0 / count()
            ),
            2
        ) AS team2_win_pct,

        sumIf(
            ft_home,
            home_team = {{String(team1)}}
        )
        +
        sumIf(
            ft_away,
            away_team = {{String(team1)}}
        ) AS team1_goals,

        sumIf(
            ft_away,
            home_team = {{String(team1)}}
        )
        +
        sumIf(
            ft_home,
            away_team = {{String(team1)}}
        ) AS team2_goals,

        round(
            if(
                count() = 0,
                0,
                (
                    sumIf(
                        ft_home,
                        home_team = {{String(team1)}}
                    )
                    +
                    sumIf(
                        ft_away,
                        away_team = {{String(team1)}}
                    )
                ) * 1.0 / count()
            ),
            2
        ) AS team1_goals_avg,

        round(
            if(
                count() = 0,
                0,
                (
                    sumIf(
                        ft_away,
                        home_team = {{String(team1)}}
                    )
                    +
                    sumIf(
                        ft_home,
                        away_team = {{String(team1)}}
                    )
                ) * 1.0 / count()
            ),
            2
        ) AS team2_goals_avg,

        round(
            if(
                count() = 0,
                0,
                sum(ft_home + ft_away) * 1.0 / count()
            ),
            2
        ) AS total_goals_avg,

        countIf(
            ft_home + ft_away > 1
        ) AS over_1_5,

        countIf(
            ft_home + ft_away > 2
        ) AS over_2_5,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home + ft_away > 1)
                * 100.0 / count()
            ),
            2
        ) AS over_1_5_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home + ft_away > 2)
                * 100.0 / count()
            ),
            2
        ) AS over_2_5_pct,

        countIf(
            ft_home > 0
            AND
            ft_away > 0
        ) AS btts_yes,

        countIf(
            ft_home = 0
            OR
            ft_away = 0
        ) AS btts_no,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    ft_home > 0
                    AND
                    ft_away > 0
                ) * 100.0 / count()
            ),
            2
        ) AS btts_yes_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    ft_home = 0
                    OR
                    ft_away = 0
                ) * 100.0 / count()
            ),
            2
        ) AS btts_no_pct,

        '' AS home_team_scope,

        '' AS away_team_scope,

        '' AS match_date,

        '' AS score,

        0 AS match_limit


    FROM betexplorer_matches


    WHERE

        (
            (
                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}
            )
            OR
            (
                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}
            )
        )

        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL


        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}


        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}


        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


    UNION ALL


    /* =========================================================
       TAKIM 1'İN SAHASINDA
       ========================================================= */

    SELECT

        'team1_home' AS section,

        count() AS matches,

        countIf(ft_home > ft_away) AS team1_wins,

        countIf(ft_home = ft_away) AS draws,

        countIf(ft_home < ft_away) AS team2_wins,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home > ft_away)
                * 100.0 / count()
            ),
            2
        ) AS team1_win_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home = ft_away)
                * 100.0 / count()
            ),
            2
        ) AS draw_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home < ft_away)
                * 100.0 / count()
            ),
            2
        ) AS team2_win_pct,

        sum(ft_home) AS team1_goals,

        sum(ft_away) AS team2_goals,

        round(
            if(count() = 0, 0, sum(ft_home) * 1.0 / count()),
            2
        ) AS team1_goals_avg,

        round(
            if(count() = 0, 0, sum(ft_away) * 1.0 / count()),
            2
        ) AS team2_goals_avg,

        round(
            if(
                count() = 0,
                0,
                sum(ft_home + ft_away) * 1.0 / count()
            ),
            2
        ) AS total_goals_avg,

        countIf(ft_home + ft_away > 1) AS over_1_5,

        countIf(ft_home + ft_away > 2) AS over_2_5,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home + ft_away > 1)
                * 100.0 / count()
            ),
            2
        ) AS over_1_5_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home + ft_away > 2)
                * 100.0 / count()
            ),
            2
        ) AS over_2_5_pct,

        countIf(
            ft_home > 0
            AND
            ft_away > 0
        ) AS btts_yes,

        countIf(
            ft_home = 0
            OR
            ft_away = 0
        ) AS btts_no,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    ft_home > 0
                    AND
                    ft_away > 0
                ) * 100.0 / count()
            ),
            2
        ) AS btts_yes_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    ft_home = 0
                    OR
                    ft_away = 0
                ) * 100.0 / count()
            ),
            2
        ) AS btts_no_pct,

        {{String(team1)}} AS home_team_scope,

        {{String(team2)}} AS away_team_scope,

        '' AS match_date,

        '' AS score,

        0 AS match_limit


    FROM betexplorer_matches


    WHERE

        home_team = {{String(team1)}}

        AND away_team = {{String(team2)}}

        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL


        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}


        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}


        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


    UNION ALL


    /* =========================================================
       TAKIM 2'NİN SAHASINDA
       ========================================================= */

    SELECT

        'team2_home' AS section,

        count() AS matches,

        countIf(ft_home < ft_away) AS team1_wins,

        countIf(ft_home = ft_away) AS draws,

        countIf(ft_home > ft_away) AS team2_wins,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home < ft_away)
                * 100.0 / count()
            ),
            2
        ) AS team1_win_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home = ft_away)
                * 100.0 / count()
            ),
            2
        ) AS draw_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home > ft_away)
                * 100.0 / count()
            ),
            2
        ) AS team2_win_pct,

        sum(ft_away) AS team1_goals,

        sum(ft_home) AS team2_goals,

        round(
            if(count() = 0, 0, sum(ft_away) * 1.0 / count()),
            2
        ) AS team1_goals_avg,

        round(
            if(count() = 0, 0, sum(ft_home) * 1.0 / count()),
            2
        ) AS team2_goals_avg,

        round(
            if(
                count() = 0,
                0,
                sum(ft_home + ft_away) * 1.0 / count()
            ),
            2
        ) AS total_goals_avg,

        countIf(ft_home + ft_away > 1) AS over_1_5,

        countIf(ft_home + ft_away > 2) AS over_2_5,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home + ft_away > 1)
                * 100.0 / count()
            ),
            2
        ) AS over_1_5_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(ft_home + ft_away > 2)
                * 100.0 / count()
            ),
            2
        ) AS over_2_5_pct,

        countIf(
            ft_home > 0
            AND
            ft_away > 0
        ) AS btts_yes,

        countIf(
            ft_home = 0
            OR
            ft_away = 0
        ) AS btts_no,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    ft_home > 0
                    AND
                    ft_away > 0
                ) * 100.0 / count()
            ),
            2
        ) AS btts_yes_pct,

        round(
            if(
                count() = 0,
                0,
                countIf(
                    ft_home = 0
                    OR
                    ft_away = 0
                ) * 100.0 / count()
            ),
            2
        ) AS btts_no_pct,

        {{String(team2)}} AS home_team_scope,

        {{String(team1)}} AS away_team_scope,

        '' AS match_date,

        '' AS score,

        0 AS match_limit


    FROM betexplorer_matches


    WHERE

        home_team = {{String(team2)}}

        AND away_team = {{String(team1)}}

        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL


        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}


        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}


        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


    UNION ALL


    /* =========================================================
       SON H2H MAÇLARI
       ========================================================= */

    SELECT

        'recent' AS section,

        1 AS matches,

        0 AS team1_wins,

        0 AS draws,

        0 AS team2_wins,

        0.0 AS team1_win_pct,

        0.0 AS draw_pct,

        0.0 AS team2_win_pct,

        0 AS team1_goals,

        0 AS team2_goals,

        0.0 AS team1_goals_avg,

        0.0 AS team2_goals_avg,

        0.0 AS total_goals_avg,

        0 AS over_1_5,

        0 AS over_2_5,

        0.0 AS over_1_5_pct,

        0.0 AS over_2_5_pct,

        0 AS btts_yes,

        0 AS btts_no,

        0.0 AS btts_yes_pct,

        0.0 AS btts_no_pct,

        home_team AS home_team_scope,

        away_team AS away_team_scope,

        toString(match_date) AS match_date,

        concat(
            toString(ft_home),
            '-',
            toString(ft_away)
        ) AS score,

        {{Int32(limit)}} AS match_limit


    FROM betexplorer_matches


    WHERE

        (
            (
                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}
            )
            OR
            (
                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}
            )
        )

        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL


        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}


        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}


        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


    ORDER BY
        match_date DESC

    LIMIT {{Int32(limit)}}


TYPE ENDPOINT
