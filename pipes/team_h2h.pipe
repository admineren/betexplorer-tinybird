DESCRIPTION >
    İki takım arasındaki H2H analizi.

    Takım 1 ve Takım 2 birbirlerinin rakibi olarak incelenir.

    Bölümler:

    general
    - İki takım arasındaki tüm maçlar

    team1_home
    - Takım 1'in kendi sahasındaki H2H maçları

    team2_home
    - Takım 2'nin kendi sahasındaki H2H maçları

    recent
    - Son H2H maçları

    Takım perspektifinden:

    team1_wins = Takım 1 galibiyetleri
    draws      = beraberlikler
    team2_wins = Takım 2 galibiyetleri

    İlk yarı ve ikinci yarı sonuçları da
    takım perspektifinden hesaplanır.

    Parametreler:

    team1
    team2

    Opsiyonel:

    country
    league
    season
    limit


NODE team_h2h_query
SQL >
    %

    SELECT

        section,


        /* =====================================================
           MAÇ BİLGİSİ
           ===================================================== */

        count() AS matches,


        /* =====================================================
           MAÇ SONUCU
           ===================================================== */

        countIf(

            (
                if(
                    home_team = {{String(team1)}},
                    ft_home,
                    ft_away
                )
                >
                if(
                    home_team = {{String(team1)}},
                    ft_away,
                    ft_home
                )
            )

        ) AS team1_wins,


        countIf(

            ft_home = ft_away

        ) AS draws,


        countIf(

            (
                if(
                    home_team = {{String(team2)}},
                    ft_home,
                    ft_away
                )
                >
                if(
                    home_team = {{String(team2)}},
                    ft_away,
                    ft_home
                )
            )

        ) AS team2_wins,


        round(
            if(
                count() = 0,
                0,
                team1_wins * 100.0 / count()
            ),
            2
        ) AS team1_win_pct,


        round(
            if(
                count() = 0,
                0,
                draws * 100.0 / count()
            ),
            2
        ) AS draw_pct,


        round(
            if(
                count() = 0,
                0,
                team2_wins * 100.0 / count()
            ),
            2
        ) AS team2_win_pct,


        /* =====================================================
           GOLLER
           ===================================================== */

        sum(

            if(
                home_team = {{String(team1)}},
                ft_home,
                ft_away
            )

        ) AS team1_goals,


        sum(

            if(
                home_team = {{String(team2)}},
                ft_home,
                ft_away
            )

        ) AS team2_goals,


        round(

            if(
                count() = 0,
                0,

                sum(
                    if(
                        home_team = {{String(team1)}},
                        ft_home,
                        ft_away
                    )
                ) / count()

            ),

            2

        ) AS team1_goals_avg,


        round(

            if(
                count() = 0,
                0,

                sum(
                    if(
                        home_team = {{String(team2)}},
                        ft_home,
                        ft_away
                    )
                ) / count()

            ),

            2

        ) AS team2_goals_avg,


        round(

            if(
                count() = 0,
                0,
                sum(ft_home + ft_away) / count()
            ),

            2

        ) AS total_goals_avg,


        /* =====================================================
           OVER
           ===================================================== */

        countIf(
            ft_home + ft_away > 1
        ) AS over_1_5,


        countIf(
            ft_home + ft_away > 2
        ) AS over_2_5,


        round(
            if(
                count() = 0,
                0,
                over_1_5 * 100.0 / count()
            ),
            2
        ) AS over_1_5_pct,


        round(
            if(
                count() = 0,
                0,
                over_2_5 * 100.0 / count()
            ),
            2
        ) AS over_2_5_pct,


        /* =====================================================
           BTTS
           ===================================================== */

        countIf(
            ft_home > 0
            AND
            ft_away > 0
        ) AS btts_yes,


        countIf(
            ft_home = 0
            OR
            ft_away = 0
        ) AS btts_no,


        round(
            if(
                count() = 0,
                0,
                btts_yes * 100.0 / count()
            ),
            2
        ) AS btts_yes_pct,


        round(
            if(
                count() = 0,
                0,
                btts_no * 100.0 / count()
            ),
            2
        ) AS btts_no_pct,


        /* =====================================================
           İLK YARI
           ===================================================== */

        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND

            (
                if(
                    home_team = {{String(team1)}},
                    ht_home,
                    ht_away
                )
                >
                if(
                    home_team = {{String(team1)}},
                    ht_away,
                    ht_home
                )
            )

        ) AS ht_team1_wins,


        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND
            ht_home = ht_away

        ) AS ht_draws,


        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL
            AND

            (
                if(
                    home_team = {{String(team2)}},
                    ht_home,
                    ht_away
                )
                >
                if(
                    home_team = {{String(team2)}},
                    ht_away,
                    ht_home
                )
            )

        ) AS ht_team2_wins,


        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL

        ) AS ht_matches,


        round(
            if(
                ht_matches = 0,
                0,
                ht_team1_wins * 100.0 / ht_matches
            ),
            2
        ) AS ht_team1_win_pct,


        round(
            if(
                ht_matches = 0,
                0,
                ht_draws * 100.0 / ht_matches
            ),
            2
        ) AS ht_draw_pct,


        round(
            if(
                ht_matches = 0,
                0,
                ht_team2_wins * 100.0 / ht_matches
            ),
            2
        ) AS ht_team2_win_pct,


        /* =====================================================
           İKİNCİ YARI
           ===================================================== */

        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL

            AND

            (
                (
                    if(
                        home_team = {{String(team1)}},
                        ft_home - ht_home,
                        ft_away - ht_away
                    )
                )
                >
                (
                    if(
                        home_team = {{String(team1)}},
                        ft_away - ht_away,
                        ft_home - ht_home
                    )
                )
            )

        ) AS second_half_team1_wins,


        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL

            AND

            (
                ft_home - ht_home
            )
            =
            (
                ft_away - ht_away
            )

        ) AS second_half_draws,


        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL

            AND

            (
                (
                    if(
                        home_team = {{String(team2)}},
                        ft_home - ht_home,
                        ft_away - ht_away
                    )
                )
                >
                (
                    if(
                        home_team = {{String(team2)}},
                        ft_away - ht_away,
                        ft_home - ht_home
                    )
                )
            )

        ) AS second_half_team2_wins,


        countIf(

            ht_home IS NOT NULL
            AND
            ht_away IS NOT NULL

        ) AS second_half_matches,


        round(
            if(
                second_half_matches = 0,
                0,
                second_half_team1_wins * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_team1_win_pct,


        round(
            if(
                second_half_matches = 0,
                0,
                second_half_draws * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_draw_pct,


        round(
            if(
                second_half_matches = 0,
                0,
                second_half_team2_wins * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_team2_win_pct,


        /* =====================================================
           SON H2H MAÇ BİLGİSİ
           ===================================================== */

        if(
            section = 'recent',
            toString(any(date)),
            ''
        ) AS match_date,


        if(
            section = 'recent',
            any(home_team),
            ''
        ) AS home_team,


        if(
            section = 'recent',
            any(away_team),
            ''
        ) AS away_team,


        if(
            section = 'recent',
            concat(
                toString(any(ft_home)),
                '-',
                toString(any(ft_away))
            ),
            ''
        ) AS score,


        if(
            section = 'recent',
            toString(any(match_id)),
            ''
        ) AS match_id


    FROM betexplorer_matches


    /* =========================================================
       AYNI MAÇI FARKLI H2H KAPSAMLARINDA İNCELE
       ========================================================= */

    ARRAY JOIN
        [
            'general',
            'team1_home',
            'team2_home',
            'recent'
        ] AS section


    WHERE

        (
            (
                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}
            )

            OR

            (
                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}
            )
        )


        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL


        /* Takım 1 kendi sahası */

        AND

        (
            section = 'general'

            OR

            section = 'recent'

            OR

            (
                section = 'team1_home'
                AND
                home_team = {{String(team1)}}
            )

            OR

            (
                section = 'team2_home'
                AND
                home_team = {{String(team2)}}
            )
        )


        /* =====================================================
           OPSİYONEL FİLTRELER
           ===================================================== */

        {% if defined(country) %}
        AND country = {{String(country)}}
        {% end %}


        {% if defined(league) %}
        AND league = {{String(league)}}
        {% end %}


        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


    GROUP BY

        section,

        if(
            section = 'recent',
            match_id,
            toUInt64(0)
        )


    ORDER BY

        if(section = 'general', 1,
            if(section = 'team1_home', 2,
                if(section = 'team2_home', 3, 4)
            )
        ),

        match_date DESC


    LIMIT {{Int32(limit, 10)}} BY section


TYPE ENDPOINT
