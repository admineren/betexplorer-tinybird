DESCRIPTION >
    İki takım arasındaki H2H analizi.

    Genel:
    - Toplam maç
    - Takım 1 galibiyet
    - Beraberlik
    - Takım 2 galibiyet
    - Takım 1 / Takım 2 golleri
    - Gol ortalamaları
    - Over 1.5 / 2.5
    - BTTS

    Takım 1 sahasında:
    - Maç
    - G / B / M
    - Goller
    - Gol ortalamaları

    Takım 2 sahasında:
    - Maç
    - G / B / M
    - Goller
    - Gol ortalamaları

    İlk yarı:
    - Takım 1 önde
    - Beraberlik
    - Takım 2 önde

    İkinci yarı:
    - Takım 1 üstün
    - Eşit
    - Takım 2 üstün

    Son H2H maçları:
    - Tarih
    - Ev sahibi
    - Deplasman
    - Skor
    - Match ID

    Parametreler:
    team1
    team2
    country
    league
    season
    limit


NODE team_h2h_query
SQL >
    %

    SELECT

        /* =====================================================
           GENEL
           ===================================================== */

        matches,

        team1_wins,
        draws,
        team2_wins,

        round(
            if(matches = 0, 0, team1_wins * 100.0 / matches),
            2
        ) AS team1_win_pct,

        round(
            if(matches = 0, 0, draws * 100.0 / matches),
            2
        ) AS draw_pct,

        round(
            if(matches = 0, 0, team2_wins * 100.0 / matches),
            2
        ) AS team2_win_pct,


        team1_goals,
        team2_goals,

        team1_goals - team2_goals AS goal_difference,


        round(
            if(matches = 0, 0, team1_goals * 1.0 / matches),
            2
        ) AS team1_goals_avg,

        round(
            if(matches = 0, 0, team2_goals * 1.0 / matches),
            2
        ) AS team2_goals_avg,

        round(
            if(
                matches = 0,
                0,
                (team1_goals + team2_goals) * 1.0 / matches
            ),
            2
        ) AS total_goals_avg,


        /* =====================================================
           OVER / BTTS
           ===================================================== */

        over_1_5,
        over_2_5,

        round(
            if(matches = 0, 0, over_1_5 * 100.0 / matches),
            2
        ) AS over_1_5_pct,

        round(
            if(matches = 0, 0, over_2_5 * 100.0 / matches),
            2
        ) AS over_2_5_pct,


        btts_yes,
        btts_no,

        round(
            if(matches = 0, 0, btts_yes * 100.0 / matches),
            2
        ) AS btts_yes_pct,

        round(
            if(matches = 0, 0, btts_no * 100.0 / matches),
            2
        ) AS btts_no_pct,


        /* =====================================================
           İLK YARI
           ===================================================== */

        ht_matches,

        ht_team1_wins,
        ht_draws,
        ht_team2_wins,

        round(
            if(
                ht_matches = 0,
                0,
                ht_team1_wins * 100.0 / ht_matches
            ),
            2
        ) AS ht_team1_win_pct,

        round(
            if(
                ht_matches = 0,
                0,
                ht_draws * 100.0 / ht_matches
            ),
            2
        ) AS ht_draw_pct,

        round(
            if(
                ht_matches = 0,
                0,
                ht_team2_wins * 100.0 / ht_matches
            ),
            2
        ) AS ht_team2_win_pct,


        /* =====================================================
           İKİNCİ YARI
           ===================================================== */

        second_half_matches,

        second_half_team1_wins,
        second_half_draws,
        second_half_team2_wins,

        round(
            if(
                second_half_matches = 0,
                0,
                second_half_team1_wins * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_team1_win_pct,

        round(
            if(
                second_half_matches = 0,
                0,
                second_half_draws * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_draw_pct,

        round(
            if(
                second_half_matches = 0,
                0,
                second_half_team2_wins * 100.0
                / second_half_matches
            ),
            2
        ) AS second_half_team2_win_pct,


        /* =====================================================
           TEAM 1 SAHASINDA
           ===================================================== */

        team1_home_matches,
        team1_home_wins,
        team1_home_draws,
        team1_home_losses,

        round(
            if(
                team1_home_matches = 0,
                0,
                team1_home_wins * 100.0
                / team1_home_matches
            ),
            2
        ) AS team1_home_win_pct,


        team1_home_goals,
        team1_home_conceded,


        round(
            if(
                team1_home_matches = 0,
                0,
                team1_home_goals * 1.0
                / team1_home_matches
            ),
            2
        ) AS team1_home_goals_avg,


        round(
            if(
                team1_home_matches = 0,
                0,
                team1_home_conceded * 1.0
                / team1_home_matches
            ),
            2
        ) AS team1_home_conceded_avg,


        /* =====================================================
           TEAM 2 SAHASINDA
           ===================================================== */

        team2_home_matches,
        team2_home_wins,
        team2_home_draws,
        team2_home_losses,

        round(
            if(
                team2_home_matches = 0,
                0,
                team2_home_wins * 100.0
                / team2_home_matches
            ),
            2
        ) AS team2_home_win_pct,


        team2_home_goals,
        team2_home_conceded,


        round(
            if(
                team2_home_matches = 0,
                0,
                team2_home_goals * 1.0
                / team2_home_matches
            ),
            2
        ) AS team2_home_goals_avg,


        round(
            if(
                team2_home_matches = 0,
                0,
                team2_home_conceded * 1.0
                / team2_home_matches
            ),
            2
        ) AS team2_home_conceded_avg


    FROM
    (

        SELECT


            /* =================================================
               GENEL MAÇ SAYISI
               ================================================= */

            count() AS matches,


            /* =================================================
               GENEL SONUÇ
               ================================================= */

            countIf(

                (
                    home_team = {{String(team1)}}
                    AND ft_home > ft_away
                )

                OR

                (
                    away_team = {{String(team1)}}
                    AND ft_away > ft_home
                )

            ) AS team1_wins,


            countIf(
                ft_home = ft_away
            ) AS draws,


            countIf(

                (
                    home_team = {{String(team2)}}
                    AND ft_home > ft_away
                )

                OR

                (
                    away_team = {{String(team2)}}
                    AND ft_away > ft_home
                )

            ) AS team2_wins,


            /* =================================================
               GOLLER
               ================================================= */

            sum(

                if(
                    home_team = {{String(team1)}},
                    ft_home,
                    ft_away
                )

            ) AS team1_goals,


            sum(

                if(
                    home_team = {{String(team2)}},
                    ft_home,
                    ft_away
                )

            ) AS team2_goals,


            /* =================================================
               OVER
               ================================================= */

            countIf(
                ft_home + ft_away >= 2
            ) AS over_1_5,


            countIf(
                ft_home + ft_away >= 3
            ) AS over_2_5,


            /* =================================================
               BTTS
               ================================================= */

            countIf(
                ft_home > 0
                AND
                ft_away > 0
            ) AS btts_yes,


            countIf(
                ft_home = 0
                OR
                ft_away = 0
            ) AS btts_no,


            /* =================================================
               İLK YARI
               ================================================= */

            countIf(
                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL
            ) AS ht_matches,


            countIf(

                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL

                AND

                (
                    (
                        home_team = {{String(team1)}}
                        AND ht_home > ht_away
                    )

                    OR

                    (
                        away_team = {{String(team1)}}
                        AND ht_away > ht_home
                    )
                )

            ) AS ht_team1_wins,


            countIf(
                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL
                AND
                ht_home = ht_away
            ) AS ht_draws,


            countIf(

                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL

                AND

                (
                    (
                        home_team = {{String(team2)}}
                        AND ht_home > ht_away
                    )

                    OR

                    (
                        away_team = {{String(team2)}}
                        AND ht_away > ht_home
                    )
                )

            ) AS ht_team2_wins,


            /* =================================================
               İKİNCİ YARI
               ================================================= */

            countIf(

                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL

            ) AS second_half_matches,


            countIf(

                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL

                AND

                (
                    (
                        home_team = {{String(team1)}}
                        AND
                        (
                            ft_home - ht_home
                            >
                            ft_away - ht_away
                        )
                    )

                    OR

                    (
                        away_team = {{String(team1)}}
                        AND
                        (
                            ft_away - ht_away
                            >
                            ft_home - ht_home
                        )
                    )
                )

            ) AS second_half_team1_wins,


            countIf(

                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL

                AND

                (
                    ft_home - ht_home
                )
                =
                (
                    ft_away - ht_away
                )

            ) AS second_half_draws,


            countIf(

                ht_home IS NOT NULL
                AND
                ht_away IS NOT NULL

                AND

                (
                    (
                        home_team = {{String(team2)}}
                        AND
                        (
                            ft_home - ht_home
                            >
                            ft_away - ht_away
                        )
                    )

                    OR

                    (
                        away_team = {{String(team2)}}
                        AND
                        (
                            ft_away - ht_away
                            >
                            ft_home - ht_home
                        )
                    )
                )

            ) AS second_half_team2_wins,


            /* =================================================
               TEAM 1 SAHASINDA
               ================================================= */

            countIf(
                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}
            ) AS team1_home_matches,


            countIf(

                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}
                AND
                ft_home > ft_away

            ) AS team1_home_wins,


            countIf(

                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}
                AND
                ft_home = ft_away

            ) AS team1_home_draws,


            countIf(

                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}
                AND
                ft_home < ft_away

            ) AS team1_home_losses,


            sumIf(
                ft_home,

                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}

            ) AS team1_home_goals,


            sumIf(
                ft_away,

                home_team = {{String(team1)}}
                AND
                away_team = {{String(team2)}}

            ) AS team1_home_conceded,


            /* =================================================
               TEAM 2 SAHASINDA
               ================================================= */

            countIf(
                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}
            ) AS team2_home_matches,


            countIf(

                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}
                AND
                ft_away > ft_home

            ) AS team2_home_wins,


            countIf(

                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}
                AND
                ft_home = ft_away

            ) AS team2_home_draws,


            countIf(

                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}
                AND
                ft_away < ft_home

            ) AS team2_home_losses,


            sumIf(
                ft_home,

                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}

            ) AS team2_home_goals,


            sumIf(
                ft_away,

                home_team = {{String(team2)}}
                AND
                away_team = {{String(team1)}}

            ) AS team2_home_conceded


        FROM betexplorer_matches


        WHERE

            (
                (
                    home_team = {{String(team1)}}
                    AND
                    away_team = {{String(team2)}}
                )

                OR

                (
                    home_team = {{String(team2)}}
                    AND
                    away_team = {{String(team1)}}
                )
            )


            AND ft_home IS NOT NULL
            AND ft_away IS NOT NULL


            {% if defined(country) %}
            AND country = {{String(country)}}
            {% end %}


            {% if defined(league) %}
            AND league = {{String(league)}}
            {% end %}


            {% if defined(season) %}
            AND season = {{String(season)}}
            {% end %}

    )


TYPE ENDPOINT
