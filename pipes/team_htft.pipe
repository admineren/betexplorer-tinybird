DESCRIPTION >
    Takım HT / FT analizi.

    Takımın ilk yarı sonucunun maç sonucuna nasıl dönüştüğünü
    takımın kendi perspektifinden hesaplar.

    G = İlk yarıda takım galibiyet durumunda / önde
    B = İlk yarı beraberlik
    M = İlk yarıda takım mağlubiyet durumunda / geride

    Aynı mantık maç sonucu için de uygulanır.

    Ev sahibi ve deplasman maçları takım perspektifine çevrilir.

    Örnek:

    G → G = İlk yarı önde → maçı kazandı
    G → B = İlk yarı önde → berabere kaldı
    G → M = İlk yarı önde → maçı kaybetti

    B → G = İlk yarı beraber → maçı kazandı
    B → B = İlk yarı beraber → berabere kaldı
    B → M = İlk yarı beraber → maçı kaybetti

    M → G = İlk yarı geride → maçı kazandı
    M → B = İlk yarı geride → berabere kaldı
    M → M = İlk yarı geride → maçı kaybetti

    Opsiyonel filtreler:
    country
    league
    season


NODE team_htft_query
SQL >
    %

    SELECT

        matches,

        /* =====================================================
           9 HT / FT KOMBİNASYONU

           G = Galibiyet / takım önde
           B = Beraberlik
           M = Mağlubiyet / takım geride
           ===================================================== */

        ht_g_ft_g,
        ht_g_ft_b,
        ht_g_ft_m,

        ht_b_ft_g,
        ht_b_ft_b,
        ht_b_ft_m,

        ht_m_ft_g,
        ht_m_ft_b,
        ht_m_ft_m,


        /* =====================================================
           YÜZDELER
           ===================================================== */

        round(
            if(matches = 0, 0, ht_g_ft_g * 100.0 / matches),
            2
        ) AS ht_g_ft_g_pct,

        round(
            if(matches = 0, 0, ht_g_ft_b * 100.0 / matches),
            2
        ) AS ht_g_ft_b_pct,

        round(
            if(matches = 0, 0, ht_g_ft_m * 100.0 / matches),
            2
        ) AS ht_g_ft_m_pct,


        round(
            if(matches = 0, 0, ht_b_ft_g * 100.0 / matches),
            2
        ) AS ht_b_ft_g_pct,

        round(
            if(matches = 0, 0, ht_b_ft_b * 100.0 / matches),
            2
        ) AS ht_b_ft_b_pct,

        round(
            if(matches = 0, 0, ht_b_ft_m * 100.0 / matches),
            2
        ) AS ht_b_ft_m_pct,


        round(
            if(matches = 0, 0, ht_m_ft_g * 100.0 / matches),
            2
        ) AS ht_m_ft_g_pct,

        round(
            if(matches = 0, 0, ht_m_ft_b * 100.0 / matches),
            2
        ) AS ht_m_ft_b_pct,

        round(
            if(matches = 0, 0, ht_m_ft_m * 100.0 / matches),
            2
        ) AS ht_m_ft_m_pct,


        /* =====================================================
           İLK YARI DURUMU
           ===================================================== */

        ht_wins,
        ht_draws,
        ht_losses,


        round(
            if(matches = 0, 0, ht_wins * 100.0 / matches),
            2
        ) AS ht_wins_pct,

        round(
            if(matches = 0, 0, ht_draws * 100.0 / matches),
            2
        ) AS ht_draws_pct,

        round(
            if(matches = 0, 0, ht_losses * 100.0 / matches),
            2
        ) AS ht_losses_pct,


        /* =====================================================
           GERİ DÖNÜŞLER

           M → G = İlk yarı geride → maç sonunda galibiyet
           M → B = İlk yarı geride → maç sonunda beraberlik
           ===================================================== */

        ht_m_ft_g AS comeback_win,
        ht_m_ft_b AS comeback_draw,

        (
            ht_m_ft_g + ht_m_ft_b
        ) AS comeback_total,


        round(
            if(
                ht_losses = 0,
                0,
                ht_m_ft_g * 100.0 / ht_losses
            ),
            2
        ) AS comeback_win_pct,


        round(
            if(
                ht_losses = 0,
                0,
                ht_m_ft_b * 100.0 / ht_losses
            ),
            2
        ) AS comeback_draw_pct,


        /* =====================================================
           ÖNDEYKEN PUAN KAYBI

           G → B = İlk yarı önde → maç sonunda beraberlik
           G → M = İlk yarı önde → maç sonunda mağlubiyet
           ===================================================== */

        ht_g_ft_b AS lead_lost_draw,
        ht_g_ft_m AS lead_lost_loss,

        (
            ht_g_ft_b + ht_g_ft_m
        ) AS lead_lost_total,


        round(
            if(
                ht_wins = 0,
                0,
                ht_g_ft_b * 100.0 / ht_wins
            ),
            2
        ) AS lead_lost_draw_pct,


        round(
            if(
                ht_wins = 0,
                0,
                ht_g_ft_m * 100.0 / ht_wins
            ),
            2
        ) AS lead_lost_loss_pct,


        /* =====================================================
           İLK YARIDA ÖNDEYKEN MAÇI KAZANMA

           G → G
           ===================================================== */

        ht_g_ft_g AS lead_to_win,

        round(
            if(
                ht_wins = 0,
                0,
                ht_g_ft_g * 100.0 / ht_wins
            ),
            2
        ) AS lead_to_win_pct,


        /* =====================================================
           İLK YARIDA GERİDEYKEN MAÇI KAZANMA

           M → G
           ===================================================== */

        ht_m_ft_g AS behind_to_win,

        round(
            if(
                ht_losses = 0,
                0,
                ht_m_ft_g * 100.0 / ht_losses
            ),
            2
        ) AS behind_to_win_pct


    FROM
    (

        SELECT

            count() AS matches,


            /* =================================================
               HT → FT

               G = takım ilk yarıda önde
               B = beraberlik
               M = takım ilk yarıda geride
               ================================================= */


            /* =================================================
               HT G → FT G
               ================================================= */

            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home > ht_away
                    AND ft_home > ft_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away > ht_home
                    AND ft_away > ft_home
                )

            ) AS ht_g_ft_g,


            /* =================================================
               HT G → FT B
               ================================================= */

            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home > ht_away
                    AND ft_home = ft_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away > ht_home
                    AND ft_home = ft_away
                )

            ) AS ht_g_ft_b,


            /* =================================================
               HT G → FT M
               ================================================= */

            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home > ht_away
                    AND ft_home < ft_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away > ht_home
                    AND ft_away < ft_home
                )

            ) AS ht_g_ft_m,


            /* =================================================
               HT B → FT G
               ================================================= */

            countIf(

                ht_home = ht_away

                AND

                (
                    (
                        home_team = {{String(team)}}
                        AND ft_home > ft_away
                    )

                    OR

                    (
                        away_team = {{String(team)}}
                        AND ft_away > ft_home
                    )
                )

            ) AS ht_b_ft_g,


            /* =================================================
               HT B → FT B
               ================================================= */

            countIf(

                ht_home = ht_away
                AND ft_home = ft_away

            ) AS ht_b_ft_b,


            /* =================================================
               HT B → FT M
               ================================================= */

            countIf(

                ht_home = ht_away

                AND

                (
                    (
                        home_team = {{String(team)}}
                        AND ft_home < ft_away
                    )

                    OR

                    (
                        away_team = {{String(team)}}
                        AND ft_away < ft_home
                    )
                )

            ) AS ht_b_ft_m,


            /* =================================================
               HT M → FT G
               ================================================= */

            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home < ht_away
                    AND ft_home > ft_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away < ht_home
                    AND ft_away > ft_home
                )

            ) AS ht_m_ft_g,


            /* =================================================
               HT M → FT B
               ================================================= */

            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home < ht_away
                    AND ft_home = ft_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away < ht_home
                    AND ft_home = ft_away
                )

            ) AS ht_m_ft_b,


            /* =================================================
               HT M → FT M
               ================================================= */

            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home < ht_away
                    AND ft_home < ft_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away < ht_home
                    AND ft_away < ft_home
                )

            ) AS ht_m_ft_m,


            /* =================================================
               İLK YARI GENEL DURUMU
               ================================================= */

            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home > ht_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away > ht_home
                )

            ) AS ht_wins,


            countIf(
                ht_home = ht_away
            ) AS ht_draws,


            countIf(

                (
                    home_team = {{String(team)}}
                    AND ht_home < ht_away
                )

                OR

                (
                    away_team = {{String(team)}}
                    AND ht_away < ht_home
                )

            ) AS ht_losses


        FROM betexplorer_matches


        WHERE

            (
                home_team = {{String(team)}}
                OR
                away_team = {{String(team)}}
            )

            /* Tamamlanmış maç */

            AND ft_home IS NOT NULL
            AND ft_away IS NOT NULL

            /* İlk yarı skorunun da olması */

            AND ht_home IS NOT NULL
            AND ht_away IS NOT NULL


            /* =================================================
               OPSİYONEL FİLTRELER
               ================================================= */

            {% if defined(country) %}
            AND country = {{String(country)}}
            {% end %}


            {% if defined(league) %}
            AND league = {{String(league)}}
            {% end %}


            {% if defined(season) %}
            AND season = {{String(season)}}
            {% end %}

    )


TYPE ENDPOINT
