DESCRIPTION >
    İki farklı ligi istatistiksel olarak karşılaştırır.
    Genel sonuçlar, gol yapısı, Over/Under, BTTS ve ilk yarı
    istatistiklerini iki lig arasında karşılaştırmalı olarak döndürür.

NODE league_comparison_query
SQL >

    %

    SELECT

        /* =====================================================
           LİG BİLGİLERİ
           ===================================================== */

        l1.country AS league1_country,
        l1.league  AS league1,

        l2.country AS league2_country,
        l2.league  AS league2,


        /* =====================================================
           GENEL
           ===================================================== */

        l1.matches AS league1_matches,
        l2.matches AS league2_matches,

        l1.teams AS league1_teams,
        l2.teams AS league2_teams,

        round(
            l1.matches * 100.0 /
            nullIf(l1.matches + l2.matches, 0),
            2
        ) AS league1_match_share_pct,

        round(
            l2.matches * 100.0 /
            nullIf(l1.matches + l2.matches, 0),
            2
        ) AS league2_match_share_pct,


        /* =====================================================
           SONUÇLAR
           ===================================================== */

        l1.home_wins AS league1_home_wins,
        l2.home_wins AS league2_home_wins,

        l1.draws AS league1_draws,
        l2.draws AS league2_draws,

        l1.away_wins AS league1_away_wins,
        l2.away_wins AS league2_away_wins,

        l1.home_win_pct AS league1_home_win_pct,
        l2.home_win_pct AS league2_home_win_pct,

        l1.draw_pct AS league1_draw_pct,
        l2.draw_pct AS league2_draw_pct,

        l1.away_win_pct AS league1_away_win_pct,
        l2.away_win_pct AS league2_away_win_pct,

        round(
            l1.home_win_pct - l2.home_win_pct,
            2
        ) AS home_win_pct_diff,

        round(
            l1.draw_pct - l2.draw_pct,
            2
        ) AS draw_pct_diff,

        round(
            l1.away_win_pct - l2.away_win_pct,
            2
        ) AS away_win_pct_diff,


        /* =====================================================
           GOLLER
           ===================================================== */

        l1.home_goals AS league1_home_goals,
        l2.home_goals AS league2_home_goals,

        l1.away_goals AS league1_away_goals,
        l2.away_goals AS league2_away_goals,

        l1.total_goals AS league1_total_goals,
        l2.total_goals AS league2_total_goals,

        l1.goals_per_match AS league1_goals_per_match,
        l2.goals_per_match AS league2_goals_per_match,

        round(
            l1.goals_per_match -
            l2.goals_per_match,
            2
        ) AS goals_per_match_diff,

        l1.home_goals_avg AS league1_home_goals_avg,
        l2.home_goals_avg AS league2_home_goals_avg,

        l1.away_goals_avg AS league1_away_goals_avg,
        l2.away_goals_avg AS league2_away_goals_avg,

        round(
            l1.home_goals_avg -
            l2.home_goals_avg,
            2
        ) AS home_goals_avg_diff,

        round(
            l1.away_goals_avg -
            l2.away_goals_avg,
            2
        ) AS away_goals_avg_diff,


        /* =====================================================
           TOPLAM GOL DAĞILIMI
           ===================================================== */

        l1.total_goals_0_1 AS league1_goals_0_1,
        l2.total_goals_0_1 AS league2_goals_0_1,

        l1.total_goals_2_3 AS league1_goals_2_3,
        l2.total_goals_2_3 AS league2_goals_2_3,

        l1.total_goals_4_5 AS league1_goals_4_5,
        l2.total_goals_4_5 AS league2_goals_4_5,

        l1.total_goals_6_plus AS league1_goals_6_plus,
        l2.total_goals_6_plus AS league2_goals_6_plus,

        l1.total_goals_0_1_pct AS league1_goals_0_1_pct,
        l2.total_goals_0_1_pct AS league2_goals_0_1_pct,

        l1.total_goals_2_3_pct AS league1_goals_2_3_pct,
        l2.total_goals_2_3_pct AS league2_goals_2_3_pct,

        l1.total_goals_4_5_pct AS league1_goals_4_5_pct,
        l2.total_goals_4_5_pct AS league2_goals_4_5_pct,

        l1.total_goals_6_plus_pct AS league1_goals_6_plus_pct,
        l2.total_goals_6_plus_pct AS league2_goals_6_plus_pct,


        /* =====================================================
           OVER
           ===================================================== */

        l1.over_0_5 AS league1_over_0_5,
        l2.over_0_5 AS league2_over_0_5,

        l1.over_1_5 AS league1_over_1_5,
        l2.over_1_5 AS league2_over_1_5,

        l1.over_2_5 AS league1_over_2_5,
        l2.over_2_5 AS league2_over_2_5,

        l1.over_3_5 AS league1_over_3_5,
        l2.over_3_5 AS league2_over_3_5,

        l1.over_4_5 AS league1_over_4_5,
        l2.over_4_5 AS league2_over_4_5,

        l1.over_0_5_pct AS league1_over_0_5_pct,
        l2.over_0_5_pct AS league2_over_0_5_pct,

        l1.over_1_5_pct AS league1_over_1_5_pct,
        l2.over_1_5_pct AS league2_over_1_5_pct,

        l1.over_2_5_pct AS league1_over_2_5_pct,
        l2.over_2_5_pct AS league2_over_2_5_pct,

        l1.over_3_5_pct AS league1_over_3_5_pct,
        l2.over_3_5_pct AS league2_over_3_5_pct,

        l1.over_4_5_pct AS league1_over_4_5_pct,
        l2.over_4_5_pct AS league2_over_4_5_pct,

        round(
            l1.over_0_5_pct -
            l2.over_0_5_pct,
            2
        ) AS over_0_5_pct_diff,

        round(
            l1.over_1_5_pct -
            l2.over_1_5_pct,
            2
        ) AS over_1_5_pct_diff,

        round(
            l1.over_2_5_pct -
            l2.over_2_5_pct,
            2
        ) AS over_2_5_pct_diff,

        round(
            l1.over_3_5_pct -
            l2.over_3_5_pct,
            2
        ) AS over_3_5_pct_diff,

        round(
            l1.over_4_5_pct -
            l2.over_4_5_pct,
            2
        ) AS over_4_5_pct_diff,


        /* =====================================================
           BTTS
           ===================================================== */

        l1.btts_yes AS league1_btts_yes,
        l2.btts_yes AS league2_btts_yes,

        l1.btts_no AS league1_btts_no,
        l2.btts_no AS league2_btts_no,

        l1.btts_yes_pct AS league1_btts_yes_pct,
        l2.btts_yes_pct AS league2_btts_yes_pct,

        l1.btts_no_pct AS league1_btts_no_pct,
        l2.btts_no_pct AS league2_btts_no_pct,

        round(
            l1.btts_yes_pct -
            l2.btts_yes_pct,
            2
        ) AS btts_yes_pct_diff,

        round(
            l1.btts_no_pct -
            l2.btts_no_pct,
            2
        ) AS btts_no_pct_diff,


        /* =====================================================
           İLK YARI
           ===================================================== */

        l1.ht_matches AS league1_ht_matches,
        l2.ht_matches AS league2_ht_matches,

        l1.ht_total_goals_0_pct
            AS league1_ht_0_goal_pct,

        l2.ht_total_goals_0_pct
            AS league2_ht_0_goal_pct,

        l1.ht_total_goals_1_pct
            AS league1_ht_1_goal_pct,

        l2.ht_total_goals_1_pct
            AS league2_ht_1_goal_pct,

        l1.ht_total_goals_2_pct
            AS league1_ht_2_goal_pct,

        l2.ht_total_goals_2_pct
            AS league2_ht_2_goal_pct,

        l1.ht_total_goals_3_plus_pct
            AS league1_ht_3_plus_goal_pct,

        l2.ht_total_goals_3_plus_pct
            AS league2_ht_3_plus_goal_pct,

        l1.ht_over_0_5_pct
            AS league1_ht_over_0_5_pct,

        l2.ht_over_0_5_pct
            AS league2_ht_over_0_5_pct,

        l1.ht_over_1_5_pct
            AS league1_ht_over_1_5_pct,

        l2.ht_over_1_5_pct
            AS league2_ht_over_1_5_pct,

        l1.ht_over_2_5_pct
            AS league1_ht_over_2_5_pct,

        l2.ht_over_2_5_pct
            AS league2_ht_over_2_5_pct,


        /* =====================================================
           İKİNCİ YARI
           ===================================================== */

        l1.second_half_over_0_5_pct
            AS league1_2h_over_0_5_pct,

        l2.second_half_over_0_5_pct
            AS league2_2h_over_0_5_pct,

        l1.second_half_over_1_5_pct
            AS league1_2h_over_1_5_pct,

        l2.second_half_over_1_5_pct
            AS league2_2h_over_1_5_pct,

        l1.second_half_over_2_5_pct
            AS league1_2h_over_2_5_pct,

        l2.second_half_over_2_5_pct
            AS league2_2h_over_2_5_pct


    FROM
    (

        /* =====================================================
           LİG 1
           ===================================================== */

        SELECT

            any(country) AS country,
            any(league) AS league,

            count() AS matches,

            uniqExact(home_team) +
            uniqExact(away_team) AS teams,

            countIf(
                ft_home > ft_away
            ) AS home_wins,

            countIf(
                ft_home = ft_away
            ) AS draws,

            countIf(
                ft_home < ft_away
            ) AS away_wins,

            round(
                countIf(ft_home > ft_away)
                * 100.0 / count(),
                2
            ) AS home_win_pct,

            round(
                countIf(ft_home = ft_away)
                * 100.0 / count(),
                2
            ) AS draw_pct,

            round(
                countIf(ft_home < ft_away)
                * 100.0 / count(),
                2
            ) AS away_win_pct,


            /* GOLLER */

            sum(ft_home) AS home_goals,

            sum(ft_away) AS away_goals,

            sum(ft_home + ft_away)
                AS total_goals,

            round(
                avg(ft_home + ft_away),
                2
            ) AS goals_per_match,

            round(
                avg(ft_home),
                2
            ) AS home_goals_avg,

            round(
                avg(ft_away),
                2
            ) AS away_goals_avg,


            /* GOL DAĞILIMI */

            countIf(
                ft_home + ft_away <= 1
            ) AS total_goals_0_1,

            countIf(
                ft_home + ft_away BETWEEN 2 AND 3
            ) AS total_goals_2_3,

            countIf(
                ft_home + ft_away BETWEEN 4 AND 5
            ) AS total_goals_4_5,

            countIf(
                ft_home + ft_away >= 6
            ) AS total_goals_6_plus,

            round(
                countIf(ft_home + ft_away <= 1)
                * 100.0 / count(),
                2
            ) AS total_goals_0_1_pct,

            round(
                countIf(
                    ft_home + ft_away BETWEEN 2 AND 3
                ) * 100.0 / count(),
                2
            ) AS total_goals_2_3_pct,

            round(
                countIf(
                    ft_home + ft_away BETWEEN 4 AND 5
                ) * 100.0 / count(),
                2
            ) AS total_goals_4_5_pct,

            round(
                countIf(ft_home + ft_away >= 6)
                * 100.0 / count(),
                2
            ) AS total_goals_6_plus_pct,


            /* OVER */

            countIf(ft_home + ft_away >= 1)
                AS over_0_5,

            countIf(ft_home + ft_away >= 2)
                AS over_1_5,

            countIf(ft_home + ft_away >= 3)
                AS over_2_5,

            countIf(ft_home + ft_away >= 4)
                AS over_3_5,

            countIf(ft_home + ft_away >= 5)
                AS over_4_5,

            round(
                countIf(ft_home + ft_away >= 1)
                * 100.0 / count(),
                2
            ) AS over_0_5_pct,

            round(
                countIf(ft_home + ft_away >= 2)
                * 100.0 / count(),
                2
            ) AS over_1_5_pct,

            round(
                countIf(ft_home + ft_away >= 3)
                * 100.0 / count(),
                2
            ) AS over_2_5_pct,

            round(
                countIf(ft_home + ft_away >= 4)
                * 100.0 / count(),
                2
            ) AS over_3_5_pct,

            round(
                countIf(ft_home + ft_away >= 5)
                * 100.0 / count(),
                2
            ) AS over_4_5_pct,


            /* BTTS */

            countIf(
                ft_home > 0
                AND ft_away > 0
            ) AS btts_yes,

            countIf(
                ft_home = 0
                OR ft_away = 0
            ) AS btts_no,

            round(
                countIf(
                    ft_home > 0
                    AND ft_away > 0
                ) * 100.0 / count(),
                2
            ) AS btts_yes_pct,

            round(
                countIf(
                    ft_home = 0
                    OR ft_away = 0
                ) * 100.0 / count(),
                2
            ) AS btts_no_pct,


            /* İLK YARI */

            count() AS ht_matches,

            round(
                countIf(ht_home + ht_away = 0)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_0_pct,

            round(
                countIf(ht_home + ht_away = 1)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_1_pct,

            round(
                countIf(ht_home + ht_away = 2)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_2_pct,

            round(
                countIf(ht_home + ht_away >= 3)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_3_plus_pct,

            round(
                countIf(ht_home + ht_away >= 1)
                * 100.0 / count(),
                2
            ) AS ht_over_0_5_pct,

            round(
                countIf(ht_home + ht_away >= 2)
                * 100.0 / count(),
                2
            ) AS ht_over_1_5_pct,

            round(
                countIf(ht_home + ht_away >= 3)
                * 100.0 / count(),
                2
            ) AS ht_over_2_5_pct,


            /* İKİNCİ YARI */

            round(
                countIf(
                    (ft_home - ht_home)
                    +
                    (ft_away - ht_away) >= 1
                ) * 100.0 / count(),
                2
            ) AS second_half_over_0_5_pct,

            round(
                countIf(
                    (ft_home - ht_home)
                    +
                    (ft_away - ht_away) >= 2
                ) * 100.0 / count(),
                2
            ) AS second_half_over_1_5_pct,

            round(
                countIf(
                    (ft_home - ht_home)
                    +
                    (ft_away - ht_away) >= 3
                ) * 100.0 / count(),
                2
            ) AS second_half_over_2_5_pct


        FROM betexplorer_matches

        WHERE
            country = {{String(country1)}}

            AND league = {{String(league1)}}

            AND ft_home IS NOT NULL
            AND ft_away IS NOT NULL

            {% if defined(season1) %}
            AND season = {{String(season1)}}
            {% end %}

    ) AS l1


CROSS JOIN
    (

        /* =====================================================
           LİG 2
           ===================================================== */

        SELECT

            any(country) AS country,
            any(league) AS league,

            count() AS matches,

            uniqExact(home_team) +
            uniqExact(away_team) AS teams,

            countIf(ft_home > ft_away)
                AS home_wins,

            countIf(ft_home = ft_away)
                AS draws,

            countIf(ft_home < ft_away)
                AS away_wins,

            round(
                countIf(ft_home > ft_away)
                * 100.0 / count(),
                2
            ) AS home_win_pct,

            round(
                countIf(ft_home = ft_away)
                * 100.0 / count(),
                2
            ) AS draw_pct,

            round(
                countIf(ft_home < ft_away)
                * 100.0 / count(),
                2
            ) AS away_win_pct,


            sum(ft_home) AS home_goals,

            sum(ft_away) AS away_goals,

            sum(ft_home + ft_away)
                AS total_goals,

            round(
                avg(ft_home + ft_away),
                2
            ) AS goals_per_match,

            round(
                avg(ft_home),
                2
            ) AS home_goals_avg,

            round(
                avg(ft_away),
                2
            ) AS away_goals_avg,


            countIf(
                ft_home + ft_away <= 1
            ) AS total_goals_0_1,

            countIf(
                ft_home + ft_away BETWEEN 2 AND 3
            ) AS total_goals_2_3,

            countIf(
                ft_home + ft_away BETWEEN 4 AND 5
            ) AS total_goals_4_5,

            countIf(
                ft_home + ft_away >= 6
            ) AS total_goals_6_plus,

            round(
                countIf(ft_home + ft_away <= 1)
                * 100.0 / count(),
                2
            ) AS total_goals_0_1_pct,

            round(
                countIf(
                    ft_home + ft_away BETWEEN 2 AND 3
                ) * 100.0 / count(),
                2
            ) AS total_goals_2_3_pct,

            round(
                countIf(
                    ft_home + ft_away BETWEEN 4 AND 5
                ) * 100.0 / count(),
                2
            ) AS total_goals_4_5_pct,

            round(
                countIf(ft_home + ft_away >= 6)
                * 100.0 / count(),
                2
            ) AS total_goals_6_plus_pct,


            countIf(ft_home + ft_away >= 1)
                AS over_0_5,

            countIf(ft_home + ft_away >= 2)
                AS over_1_5,

            countIf(ft_home + ft_away >= 3)
                AS over_2_5,

            countIf(ft_home + ft_away >= 4)
                AS over_3_5,

            countIf(ft_home + ft_away >= 5)
                AS over_4_5,

            round(
                countIf(ft_home + ft_away >= 1)
                * 100.0 / count(),
                2
            ) AS over_0_5_pct,

            round(
                countIf(ft_home + ft_away >= 2)
                * 100.0 / count(),
                2
            ) AS over_1_5_pct,

            round(
                countIf(ft_home + ft_away >= 3)
                * 100.0 / count(),
                2
            ) AS over_2_5_pct,

            round(
                countIf(ft_home + ft_away >= 4)
                * 100.0 / count(),
                2
            ) AS over_3_5_pct,

            round(
                countIf(ft_home + ft_away >= 5)
                * 100.0 / count(),
                2
            ) AS over_4_5_pct,


            countIf(
                ft_home > 0
                AND ft_away > 0
            ) AS btts_yes,

            countIf(
                ft_home = 0
                OR ft_away = 0
            ) AS btts_no,

            round(
                countIf(
                    ft_home > 0
                    AND ft_away > 0
                ) * 100.0 / count(),
                2
            ) AS btts_yes_pct,

            round(
                countIf(
                    ft_home = 0
                    OR ft_away = 0
                ) * 100.0 / count(),
                2
            ) AS btts_no_pct,


            count() AS ht_matches,

            round(
                countIf(ht_home + ht_away = 0)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_0_pct,

            round(
                countIf(ht_home + ht_away = 1)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_1_pct,

            round(
                countIf(ht_home + ht_away = 2)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_2_pct,

            round(
                countIf(ht_home + ht_away >= 3)
                * 100.0 / count(),
                2
            ) AS ht_total_goals_3_plus_pct,

            round(
                countIf(ht_home + ht_away >= 1)
                * 100.0 / count(),
                2
            ) AS ht_over_0_5_pct,

            round(
                countIf(ht_home + ht_away >= 2)
                * 100.0 / count(),
                2
            ) AS ht_over_1_5_pct,

            round(
                countIf(ht_home + ht_away >= 3)
                * 100.0 / count(),
                2
            ) AS ht_over_2_5_pct,


            round(
                countIf(
                    (ft_home - ht_home)
                    +
                    (ft_away - ht_away) >= 1
                ) * 100.0 / count(),
                2
            ) AS second_half_over_0_5_pct,

            round(
                countIf(
                    (ft_home - ht_home)
                    +
                    (ft_away - ht_away) >= 2
                ) * 100.0 / count(),
                2
            ) AS second_half_over_1_5_pct,

            round(
                countIf(
                    (ft_home - ht_home)
                    +
                    (ft_away - ht_away) >= 3
                ) * 100.0 / count(),
                2
            ) AS second_half_over_2_5_pct


        FROM betexplorer_matches

        WHERE
            country = {{String(country2)}}

            AND league = {{String(league2)}}

            AND ft_home IS NOT NULL
            AND ft_away IS NOT NULL

            {% if defined(season2) %}
            AND season = {{String(season2)}}
            {% end %}

    ) AS l2

TYPE ENDPOINT
