DESCRIPTION >
    Asian Handicap odds distribution API.

    Source:
    betexplorer_matches

    Supported lines:
    -1.5
    -2.5
    -3.5

    Supported sides:
    HOME
    AWAY

    Filters:
    country
    league
    season
    line
    side

    Custom range:
    line + side + range_min + range_max

    has_odds is fixed to 'True' and is not an API parameter.


NODE odds_ah_query

SQL >
%

/* ============================================================
   GENERAL
   ============================================================ */

SELECT
    'GENERAL' AS section,
    toFloat32(0) AS line,
    'ALL' AS side,
    'ALL' AS odds_band,
    toUInt8(0) AS band_order,

    count() AS matches,

    toFloat64(100.00) AS percentage,

    round(
        (
            toFloat64(avg(ah_home))
            +
            toFloat64(avg(ah_away))
        ) / 2.0,
        2
    ) AS avg_odds,

    toFloat64(least(min(ah_home), min(ah_away))) AS min_odds,

    toFloat64(greatest(max(ah_home), max(ah_away))) AS max_odds,

    toFloat64(0) AS range_min,

    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'

  AND ah_line IS NOT NULL

  AND isNotNull(ah_home)
  AND isNotNull(ah_away)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}


UNION ALL


/* ============================================================
   -1.5 HOME
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,

    toFloat32(-1.5) AS line,

    'HOME' AS side,

    CASE
        WHEN ah_home < 1.20 THEN '<1.20'
        WHEN ah_home < 1.40 THEN '1.20-1.39'
        WHEN ah_home < 1.60 THEN '1.40-1.59'
        WHEN ah_home < 1.80 THEN '1.60-1.79'
        WHEN ah_home < 2.00 THEN '1.80-1.99'
        WHEN ah_home < 2.20 THEN '2.00-2.19'
        WHEN ah_home < 2.40 THEN '2.20-2.39'
        WHEN ah_home < 2.60 THEN '2.40-2.59'
        WHEN ah_home < 2.80 THEN '2.60-2.79'
        WHEN ah_home < 3.00 THEN '2.80-2.99'
        WHEN ah_home < 3.50 THEN '3.00-3.49'
        WHEN ah_home < 4.00 THEN '3.50-3.99'
        WHEN ah_home < 5.00 THEN '4.00-4.99'
        WHEN ah_home < 6.00 THEN '5.00-5.99'
        WHEN ah_home < 8.00 THEN '6.00-7.99'
        WHEN ah_home < 10.00 THEN '8.00-9.99'
        WHEN ah_home < 15.00 THEN '10.00-14.99'
        ELSE '>=15'
    END AS odds_band,

    CASE
        WHEN ah_home < 1.20 THEN 1
        WHEN ah_home < 1.40 THEN 2
        WHEN ah_home < 1.60 THEN 3
        WHEN ah_home < 1.80 THEN 4
        WHEN ah_home < 2.00 THEN 5
        WHEN ah_home < 2.20 THEN 6
        WHEN ah_home < 2.40 THEN 7
        WHEN ah_home < 2.60 THEN 8
        WHEN ah_home < 2.80 THEN 9
        WHEN ah_home < 3.00 THEN 10
        WHEN ah_home < 3.50 THEN 11
        WHEN ah_home < 4.00 THEN 12
        WHEN ah_home < 5.00 THEN 13
        WHEN ah_home < 6.00 THEN 14
        WHEN ah_home < 8.00 THEN 15
        WHEN ah_home < 10.00 THEN 16
        WHEN ah_home < 15.00 THEN 17
        ELSE 18
    END AS band_order,

    count() AS matches,

    round(
        count() * 100.0 / sum(count()) OVER (),
        2
    ) AS percentage,

    round(
        toFloat64(avg(ah_home)),
        2
    ) AS avg_odds,

    toFloat64(min(ah_home)) AS min_odds,

    toFloat64(max(ah_home)) AS max_odds,

    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND ah_line IS NOT NULL
  AND ah_line = toFloat32(-1.5)
  AND isNotNull(ah_home)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

{% if defined(line) %}
  AND {{Float32(line)}} = toFloat32(-1.5)
{% end %}

{% if defined(side) %}
  AND upper({{String(side)}}) = 'HOME'
{% end %}

GROUP BY
    odds_band,
    band_order


UNION ALL


/* ============================================================
   -1.5 AWAY
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,

    toFloat32(-1.5) AS line,

    'AWAY' AS side,

    CASE
        WHEN ah_away < 1.20 THEN '<1.20'
        WHEN ah_away < 1.40 THEN '1.20-1.39'
        WHEN ah_away < 1.60 THEN '1.40-1.59'
        WHEN ah_away < 1.80 THEN '1.60-1.79'
        WHEN ah_away < 2.00 THEN '1.80-1.99'
        WHEN ah_away < 2.20 THEN '2.00-2.19'
        WHEN ah_away < 2.40 THEN '2.20-2.39'
        WHEN ah_away < 2.60 THEN '2.40-2.59'
        WHEN ah_away < 2.80 THEN '2.60-2.79'
        WHEN ah_away < 3.00 THEN '2.80-2.99'
        WHEN ah_away < 3.50 THEN '3.00-3.49'
        WHEN ah_away < 4.00 THEN '3.50-3.99'
        WHEN ah_away < 5.00 THEN '4.00-4.99'
        WHEN ah_away < 6.00 THEN '5.00-5.99'
        WHEN ah_away < 8.00 THEN '6.00-7.99'
        WHEN ah_away < 10.00 THEN '8.00-9.99'
        WHEN ah_away < 15.00 THEN '10.00-14.99'
        ELSE '>=15'
    END AS odds_band,

    CASE
        WHEN ah_away < 1.20 THEN 1
        WHEN ah_away < 1.40 THEN 2
        WHEN ah_away < 1.60 THEN 3
        WHEN ah_away < 1.80 THEN 4
        WHEN ah_away < 2.00 THEN 5
        WHEN ah_away < 2.20 THEN 6
        WHEN ah_away < 2.40 THEN 7
        WHEN ah_away < 2.60 THEN 8
        WHEN ah_away < 2.80 THEN 9
        WHEN ah_away < 3.00 THEN 10
        WHEN ah_away < 3.50 THEN 11
        WHEN ah_away < 4.00 THEN 12
        WHEN ah_away < 5.00 THEN 13
        WHEN ah_away < 6.00 THEN 14
        WHEN ah_away < 8.00 THEN 15
        WHEN ah_away < 10.00 THEN 16
        WHEN ah_away < 15.00 THEN 17
        ELSE 18
    END AS band_order,

    count() AS matches,

    round(
        count() * 100.0 / sum(count()) OVER (),
        2
    ) AS percentage,

    round(
        toFloat64(avg(ah_away)),
        2
    ) AS avg_odds,

    toFloat64(min(ah_away)) AS min_odds,

    toFloat64(max(ah_away)) AS max_odds,

    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND ah_line IS NOT NULL
  AND ah_line = toFloat32(-1.5)
  AND isNotNull(ah_away)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

{% if defined(line) %}
  AND {{Float32(line)}} = toFloat32(-1.5)
{% end %}

{% if defined(side) %}
  AND upper({{String(side)}}) = 'AWAY'
{% end %}

GROUP BY
    odds_band,
    band_order


UNION ALL


/* ============================================================
   -2.5 HOME
   ============================================================ */

