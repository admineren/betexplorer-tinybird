        WHEN ah_home < 2.40 THEN 6
        WHEN ah_home < 3.00 THEN 7
        WHEN ah_home < 4.00 THEN 8
        WHEN ah_home < 5.00 THEN 9
        WHEN ah_home < 6.00 THEN 10
        WHEN ah_home < 8.00 THEN 11
        WHEN ah_home < 10.00 THEN 12
