/* ============================================================
   -3.5 HOME
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,

    toFloat32(-3.5) AS line,

    'HOME' AS side,

    CASE
        WHEN ah_home < 1.20 THEN '<1.20'
        WHEN ah_home < 1.40 THEN '1.20-1.39'
        WHEN ah_home < 1.60 THEN '1.40-1.59'
        WHEN ah_home < 1.80 THEN '1.60-1.79'
        WHEN ah_home < 2.00 THEN '1.80-1.99'
        WHEN ah_home < 2.40 THEN '2.00-2.39'
        WHEN ah_home < 3.00 THEN '2.40-2.99'
        WHEN ah_home < 4.00 THEN '3.00-3.99'
        WHEN ah_home < 6.00 THEN '4.00-5.99'
        WHEN ah_home < 10.00 THEN '6.00-9.99'
        ELSE '>=10'
    END AS odds_band,

    CASE
        WHEN ah_home < 1.20 THEN 1
        WHEN ah_home < 1.40 THEN 2
        WHEN ah_home < 1.60 THEN 3
        WHEN ah_home < 1.80 THEN 4
        WHEN ah_home < 2.00 THEN 5
        WHEN ah_home < 2.40 THEN 6
        WHEN ah_home < 3.00 THEN 7
        WHEN ah_home < 4.00 THEN 8
        WHEN ah_home < 6.00 THEN 9
        WHEN ah_home < 10.00 THEN 10
        ELSE 11
    END AS band_order,

    count() AS matches,

    round(
        count() * 100.0 / sum(count()) OVER (),
        2
    ) AS percentage,

    round(
        toFloat64(avg(ah_home)),
        2
