DESCRIPTION >
  Asian Handicap odds distribution API.

  Supported AH lines:
  -1.5
  -2.5
  -3.5

  Supported sides:
  HOME
  AWAY

  Optional filters:
  country
  league
  season

  Optional custom odds range:
  odds_min
  odds_max

  has_odds is intentionally fixed to 'True'
  and is NOT an API parameter.

NODE odds_ah_query
SQL >
%

WITH base AS
(
    SELECT
        country,
        league,
        season,
        ah_line,

        if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
        ) AS ah_odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'

      AND ah_line IS NOT NULL

      AND ah_line = {{Float32(ah_line, -1.5)}}

      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) IS NOT NULL

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}

{% if defined(odds_min) %}
      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) >= {{Float32(odds_min)}}
{% end %}

{% if defined(odds_max) %}
      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) <= {{Float32(odds_max)}}
{% end %}
),

total AS
(
    SELECT
        count() AS total_matches
    FROM base
),

classified AS
(
    SELECT
        ah_odds,

        multiIf(

            /* =================================================
               AH -1.5
               ================================================= */

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 1.20,
                '<1.20',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 1.40,
                '1.20-1.39',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 1.60,
                '1.40-1.59',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 1.80,
                '1.60-1.79',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 2.00,
                '1.80-1.99',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 2.20,
                '2.00-2.19',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 2.40,
                '2.20-2.39',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 2.60,
                '2.40-2.59',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 2.80,
                '2.60-2.79',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 3.00,
                '2.80-2.99',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 3.50,
                '3.00-3.49',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 4.00,
                '3.50-3.99',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 5.00,
                '4.00-4.99',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 6.00,
                '5.00-5.99',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 8.00,
                '6.00-7.99',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 10.00,
                '8.00-9.99',

            {{Float32(ah_line, -1.5)}} = -1.5
            AND ah_odds < 15.00,
                '10.00-14.99',

            {{Float32(ah_line, -1.5)}} = -1.5,
                '>=15',


            /* =================================================
               AH -2.5
               ================================================= */

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 1.20,
                '<1.20',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 1.40,
                '1.20-1.39',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 1.60,
                '1.40-1.59',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 1.80,
                '1.60-1.79',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 2.00,
                '1.80-1.99',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 2.40,
                '2.00-2.39',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 3.00,
                '2.40-2.99',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 4.00,
                '3.00-3.99',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 5.00,
                '4.00-4.99',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 6.00,
                '5.00-5.99',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 8.00,
                '6.00-7.99',

            {{Float32(ah_line, -1.5)}} = -2.5
            AND ah_odds < 10.00,
                '8.00-9.99',

            {{Float32(ah_line, -1.5)}} = -2.5,
                '>=10',


            /* =================================================
               AH -3.5
               ================================================= */

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 1.20,
                '<1.20',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 1.40,
                '1.20-1.39',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 1.60,
                '1.40-1.59',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 1.80,
                '1.60-1.79',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 2.00,
                '1.80-1.99',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 2.40,
                '2.00-2.39',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 3.00,
                '2.40-2.99',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 4.00,
                '3.00-3.99',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 6.00,
                '4.00-5.99',

            {{Float32(ah_line, -1.5)}} = -3.5
            AND ah_odds < 10.00,
                '6.00-9.99',

            {{Float32(ah_line, -1.5)}} = -3.5,
                '>=10',

            'OTHER'

        ) AS odds_band

    FROM base
),

bands AS
(
    SELECT
        odds_band,

        count() AS matches,

        round(
            count() * 100.0 / any(total.total_matches),
            2
        ) AS percentage,

        round(avg(ah_odds), 2) AS avg_odds,

        min(ah_odds) AS min_odds,
        max(ah_odds) AS max_odds

    FROM classified

    CROSS JOIN total

    GROUP BY
        odds_band
),

ordered_bands AS
(
    SELECT
        odds_band,
        matches,
        percentage,
        avg_odds,
        min_odds,
        max_odds,

        multiIf(

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '<1.20', 1,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '1.20-1.39', 2,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '1.40-1.59', 3,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '1.60-1.79', 4,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '1.80-1.99', 5,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '2.00-2.19', 6,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '2.20-2.39', 7,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '2.40-2.59', 8,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '2.60-2.79', 9,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '2.80-2.99', 10,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '3.00-3.49', 11,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '3.50-3.99', 12,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '4.00-4.99', 13,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '5.00-5.99', 14,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '6.00-7.99', 15,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '8.00-9.99', 16,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '10.00-14.99', 17,

            {{Float32(ah_line, -1.5)}} = -1.5
            AND odds_band = '>=15', 18,


            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '<1.20', 1,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '1.20-1.39', 2,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '1.40-1.59', 3,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '1.60-1.79', 4,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '1.80-1.99', 5,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '2.00-2.39', 6,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '2.40-2.99', 7,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '3.00-3.99', 8,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '4.00-4.99', 9,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '5.00-5.99', 10,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '6.00-7.99', 11,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '8.00-9.99', 12,

            {{Float32(ah_line, -1.5)}} = -2.5
            AND odds_band = '>=10', 13,


            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '<1.20', 1,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '1.20-1.39', 2,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '1.40-1.59', 3,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '1.60-1.79', 4,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '1.80-1.99', 5,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '2.00-2.39', 6,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '2.40-2.99', 7,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '3.00-3.99', 8,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '4.00-5.99', 9,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '6.00-9.99', 10,

            {{Float32(ah_line, -1.5)}} = -3.5
            AND odds_band = '>=10', 11,

            999
        ) AS band_order

    FROM bands
)

SELECT
    '{{String(side, 'HOME')}}' AS side,
    {{Float32(ah_line, -1.5)}} AS ah_line,

    odds_band AS bucket,

    matches,
    percentage,

    avg_odds,
    min_odds,
    max_odds

FROM ordered_bands

WHERE odds_band != 'OTHER'

ORDER BY
    band_order

TYPE ENDPOINT
