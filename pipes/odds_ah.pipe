{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

{% if defined(line) %}
