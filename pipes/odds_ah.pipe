DESCRIPTION >
  Asian Handicap oran band analizi.

  Kaynak:
  betexplorer_matches

  Çizgiler:
  - -1.5
  - -2.5
  - -3.5

  Her çizgide:
  - HOME
  - AWAY
  - Oran bandı
  - Maç sayısı
  - Yüzde
  - Ortalama oran
  - Minimum oran
  - Maksimum oran

  Parametreler:
  country
  league
  season
  ah_line
  market
  range_min
  range_max

  has_odds = 'True' SQL içinde sabittir.


NODE odds_ah_query
SQL >
%

WITH normalized AS
(
    /* ============================================================
       AH -1.5 HOME
       ============================================================ */

    SELECT
        -1.5 AS line,
        'HOME' AS market,
        toFloat64(ah_home) AS odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_home)
      AND isNotNull(ah_line)
      AND toFloat64(ah_line) = -1.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -1.5 AWAY
       ============================================================ */

    SELECT
        -1.5 AS line,
        'AWAY' AS market,
        toFloat64(ah_away) AS odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_away)
      AND isNotNull(ah_line)
      AND toFloat64(ah_line) = -1.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -2.5 HOME
       ============================================================ */

    SELECT
        -2.5 AS line,
        'HOME' AS market,
        toFloat64(ah_home) AS odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_home)
      AND isNotNull(ah_line)
      AND toFloat64(ah_line) = -2.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -2.5 AWAY
       ============================================================ */

    SELECT
        -2.5 AS line,
        'AWAY' AS market,
        toFloat64(ah_away) AS odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_away)
      AND isNotNull(ah_line)
      AND toFloat64(ah_line) = -2.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -3.5 HOME
       ============================================================ */

    SELECT
        -3.5 AS line,
        'HOME' AS market,
        toFloat64(ah_home) AS odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_home)
      AND isNotNull(ah_line)
      AND toFloat64(ah_line) = -3.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -3.5 AWAY
       ============================================================ */

    SELECT
        -3.5 AS line,
        'AWAY' AS market,
        toFloat64(ah_away) AS odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_away)
      AND isNotNull(ah_line)
      AND toFloat64(ah_line) = -3.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}
)


/* ================================================================
   ORAN BAND ANALİZİ
   ================================================================ */

SELECT

    'ODDS_BAND' AS section,

    line,

    market,


    /* ============================================================
       ORAN BANDI
       ============================================================ */

    CASE

        /* ========================================================
           -1.5
           ======================================================== */

        WHEN line = -1.5 THEN
            CASE
                WHEN odds < 1.20 THEN '< 1.20'
                WHEN odds < 1.40 THEN '1.20-1.39'
                WHEN odds < 1.60 THEN '1.40-1.59'
                WHEN odds < 1.80 THEN '1.60-1.79'
                WHEN odds < 2.00 THEN '1.80-1.99'
                WHEN odds < 2.20 THEN '2.00-2.19'
                WHEN odds < 2.40 THEN '2.20-2.39'
                WHEN odds < 2.60 THEN '2.40-2.59'
                WHEN odds < 2.80 THEN '2.60-2.79'
                WHEN odds < 3.00 THEN '2.80-2.99'
                WHEN odds < 3.50 THEN '3.00-3.49'
                WHEN odds < 4.00 THEN '3.50-3.99'
                WHEN odds < 5.00 THEN '4.00-4.99'
                WHEN odds < 6.00 THEN '5.00-5.99'
                WHEN odds < 8.00 THEN '6.00-7.99'
                WHEN odds < 10.00 THEN '8.00-9.99'
                WHEN odds < 15.00 THEN '10.00-14.99'
                ELSE '>= 15'
            END


        /* ========================================================
           -2.5
           ======================================================== */

        WHEN line = -2.5 THEN
            CASE
                WHEN odds < 1.20 THEN '< 1.20'
                WHEN odds < 1.40 THEN '1.20-1.39'
                WHEN odds < 1.60 THEN '1.40-1.59'
                WHEN odds < 1.80 THEN '1.60-1.79'
                WHEN odds < 2.00 THEN '1.80-1.99'
                WHEN odds < 2.40 THEN '2.00-2.39'
                WHEN odds < 3.00 THEN '2.40-2.99'
                WHEN odds < 4.00 THEN '3.00-3.99'
                WHEN odds < 5.00 THEN '4.00-4.99'
                WHEN odds < 6.00 THEN '5.00-5.99'
                WHEN odds < 8.00 THEN '6.00-7.99'
                WHEN odds < 10.00 THEN '8.00-9.99'
                ELSE '>= 10'
            END


        /* ========================================================
           -3.5
           ======================================================== */

        WHEN line = -3.5 THEN
            CASE
                WHEN odds < 1.20 THEN '< 1.20'
                WHEN odds < 1.40 THEN '1.20-1.39'
                WHEN odds < 1.60 THEN '1.40-1.59'
                WHEN odds < 1.80 THEN '1.60-1.79'
                WHEN odds < 2.00 THEN '1.80-1.99'
                WHEN odds < 2.40 THEN '2.00-2.39'
                WHEN odds < 3.00 THEN '2.40-2.99'
                WHEN odds < 4.00 THEN '3.00-3.99'
                WHEN odds < 6.00 THEN '4.00-5.99'
                WHEN odds < 10.00 THEN '6.00-9.99'
                ELSE '>= 10'
            END

        ELSE 'UNKNOWN'

    END AS odds_band,


    /* ============================================================
       BAND ORDER
       ============================================================ */

    CASE

        /* ========================================================
           -1.5
           ======================================================== */

        WHEN line = -1.5 THEN
            CASE
                WHEN odds < 1.20 THEN 1
                WHEN odds < 1.40 THEN 2
                WHEN odds < 1.60 THEN 3
                WHEN odds < 1.80 THEN 4
                WHEN odds < 2.00 THEN 5
                WHEN odds < 2.20 THEN 6
                WHEN odds < 2.40 THEN 7
                WHEN odds < 2.60 THEN 8
                WHEN odds < 2.80 THEN 9
                WHEN odds < 3.00 THEN 10
                WHEN odds < 3.50 THEN 11
                WHEN odds < 4.00 THEN 12
                WHEN odds < 5.00 THEN 13
                WHEN odds < 6.00 THEN 14
                WHEN odds < 8.00 THEN 15
                WHEN odds < 10.00 THEN 16
                WHEN odds < 15.00 THEN 17
                ELSE 18
            END


        /* ========================================================
           -2.5
           ======================================================== */

        WHEN line = -2.5 THEN
            CASE
                WHEN odds < 1.20 THEN 1
                WHEN odds < 1.40 THEN 2
                WHEN odds < 1.60 THEN 3
                WHEN odds < 1.80 THEN 4
                WHEN odds < 2.00 THEN 5
                WHEN odds < 2.40 THEN 6
                WHEN odds < 3.00 THEN 7
                WHEN odds < 4.00 THEN 8
                WHEN odds < 5.00 THEN 9
                WHEN odds < 6.00 THEN 10
                WHEN odds < 8.00 THEN 11
                WHEN odds < 10.00 THEN 12
                ELSE 13
            END


        /* ========================================================
           -3.5
           ======================================================== */

        WHEN line = -3.5 THEN
            CASE
                WHEN odds < 1.20 THEN 1
                WHEN odds < 1.40 THEN 2
                WHEN odds < 1.60 THEN 3
                WHEN odds < 1.80 THEN 4
                WHEN odds < 2.00 THEN 5
                WHEN odds < 2.40 THEN 6
                WHEN odds < 3.00 THEN 7
                WHEN odds < 4.00 THEN 8
                WHEN odds < 6.00 THEN 9
                WHEN odds < 10.00 THEN 10
                ELSE 11
            END

        ELSE 0

    END AS band_order,


    /* ============================================================
       İSTATİSTİKLER
       ============================================================ */

    count() AS matches,

    round(
        count() * 100.0 /
        sum(count()) OVER
        (
            PARTITION BY line, market
        ),
        2
    ) AS percentage,

    round(avg(odds), 2) AS avg_odds,

    min(odds) AS min_odds,

    max(odds) AS max_odds,


    toFloat64(0) AS range_min,

    toFloat64(0) AS range_max


FROM normalized

WHERE 1 = 1


/* ================================================================
   MANUEL LINE
   ================================================================ */

{% if defined(ah_line) %}
  AND line = {{Float64(ah_line)}}
{% end %}


/* ================================================================
   MANUEL MARKET
   ================================================================ */

{% if defined(market) %}
  AND market = upper({{String(market)}})
{% end %}


/* ================================================================
   MANUEL ORAN ARALIĞI
   ================================================================ */

{% if defined(range_min) %}
  AND odds >= {{Float64(range_min)}}
{% end %}

{% if defined(range_max) %}
  AND odds <= {{Float64(range_max)}}
{% end %}


GROUP BY
    line,
    market,
    odds_band,
    band_order


/* ================================================================
   SIRALAMA
   ================================================================ */

ORDER BY
    line,
    CASE
        WHEN market = 'HOME' THEN 1
        WHEN market = 'AWAY' THEN 2
        ELSE 3
    END,
    band_order

TYPE ENDPOINT
