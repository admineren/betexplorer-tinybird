DESCRIPTION >
  Asian Handicap oran band ve sonuç analizi.

  Kaynak:
  betexplorer_matches

  Çizgiler:
  - -1.5
  - -2.5
  - -3.5

  Her çizgide:
  HOME
  AWAY

  HOME karşılığı:
  - -1.5
  - -2.5
  - -3.5

  AWAY karşılığı:
  - +1.5
  - +2.5
  - +3.5

  Her oran bandında:
  - maç sayısı
  - +2 veya üzeri fark
  - +1 fark
  - beraberlik
  - -1 fark
  - -2 veya daha fazla fark
  - AH kazanan maç sayısı
  - AH kaybeden maç sayısı
  - AH kazanma yüzdesi

  Standart filtreler:
  - country
  - league
  - season

  Manuel filtreler:
  - ah_line
  - market
  - range_min
  - range_max

  has_odds = 'True' SQL içinde sabittir.


NODE odds_ah_query
SQL >
%

WITH normalized AS
(
    /* ============================================================
       AH -1.5 HOME
       ============================================================ */

    SELECT
        -1.5 AS line,
        'HOME' AS market,
        toFloat64(ah_home) AS odds,
        toInt32(ft_home) AS ft_home,
        toInt32(ft_away) AS ft_away

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_home)
      AND isNotNull(ah_line)
      AND isNotNull(ft_home)
      AND isNotNull(ft_away)
      AND toFloat64(ah_line) = -1.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -1.5 AWAY
       ============================================================ */

    SELECT
        -1.5 AS line,
        'AWAY' AS market,
        toFloat64(ah_away) AS odds,
        toInt32(ft_home) AS ft_home,
        toInt32(ft_away) AS ft_away

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_away)
      AND isNotNull(ah_line)
      AND isNotNull(ft_home)
      AND isNotNull(ft_away)
      AND toFloat64(ah_line) = -1.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -2.5 HOME
       ============================================================ */

    SELECT
        -2.5 AS line,
        'HOME' AS market,
        toFloat64(ah_home) AS odds,
        toInt32(ft_home) AS ft_home,
        toInt32(ft_away) AS ft_away

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_home)
      AND isNotNull(ah_line)
      AND isNotNull(ft_home)
      AND isNotNull(ft_away)
      AND toFloat64(ah_line) = -2.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -2.5 AWAY
       ============================================================ */

    SELECT
        -2.5 AS line,
        'AWAY' AS market,
        toFloat64(ah_away) AS odds,
        toInt32(ft_home) AS ft_home,
        toInt32(ft_away) AS ft_away

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_away)
      AND isNotNull(ah_line)
      AND isNotNull(ft_home)
      AND isNotNull(ft_away)
      AND toFloat64(ah_line) = -2.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -3.5 HOME
       ============================================================ */

    SELECT
        -3.5 AS line,
        'HOME' AS market,
        toFloat64(ah_home) AS odds,
        toInt32(ft_home) AS ft_home,
        toInt32(ft_away) AS ft_away

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_home)
      AND isNotNull(ah_line)
      AND isNotNull(ft_home)
      AND isNotNull(ft_away)
      AND toFloat64(ah_line) = -3.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}


    UNION ALL


    /* ============================================================
       AH -3.5 AWAY
       ============================================================ */

    SELECT
        -3.5 AS line,
        'AWAY' AS market,
        toFloat64(ah_away) AS odds,
        toInt32(ft_home) AS ft_home,
        toInt32(ft_away) AS ft_away

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_away)
      AND isNotNull(ah_line)
      AND isNotNull(ft_home)
      AND isNotNull(ft_away)
      AND toFloat64(ah_line) = -3.5

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}
),


/* ================================================================
   BANDLAR
   ================================================================ */

bands AS
(
    SELECT

        line,
        market,
        odds,
        ft_home,
        ft_away,

        /* ========================================================
           MARKET ORDER
           ======================================================== */

        CASE
            WHEN market = 'HOME' THEN 1
            WHEN market = 'AWAY' THEN 2
            ELSE 3
        END AS market_order,


        /* ========================================================
           GERÇEK FARK
           
           HOME:
             ft_home - ft_away

           AWAY:
             ft_away - ft_home
           ======================================================== */

        CASE
            WHEN market = 'HOME'
                THEN ft_home - ft_away

            WHEN market = 'AWAY'
                THEN ft_away - ft_home

            ELSE 0
        END AS goal_difference,


        /* ========================================================
           ODDS BAND
           ======================================================== */

        CASE

            /* ----------------------------------------------------
               -1.5
               ---------------------------------------------------- */

            WHEN line = -1.5 THEN
                CASE
                    WHEN odds < 1.20 THEN '< 1.20'
                    WHEN odds < 1.40 THEN '1.20-1.39'
                    WHEN odds < 1.60 THEN '1.40-1.59'
                    WHEN odds < 1.80 THEN '1.60-1.79'
                    WHEN odds < 2.00 THEN '1.80-1.99'
                    WHEN odds < 2.20 THEN '2.00-2.19'
                    WHEN odds < 2.40 THEN '2.20-2.39'
                    WHEN odds < 2.60 THEN '2.40-2.59'
                    WHEN odds < 2.80 THEN '2.60-2.79'
                    WHEN odds < 3.00 THEN '2.80-2.99'
                    WHEN odds < 3.50 THEN '3.00-3.49'
                    WHEN odds < 4.00 THEN '3.50-3.99'
                    WHEN odds < 5.00 THEN '4.00-4.99'
                    WHEN odds < 6.00 THEN '5.00-5.99'
                    WHEN odds < 8.00 THEN '6.00-7.99'
                    WHEN odds < 10.00 THEN '8.00-9.99'
                    WHEN odds < 15.00 THEN '10.00-14.99'
                    ELSE '>= 15'
                END


            /* ----------------------------------------------------
               -2.5
               ---------------------------------------------------- */

            WHEN line = -2.5 THEN
                CASE
                    WHEN odds < 1.20 THEN '< 1.20'
                    WHEN odds < 1.40 THEN '1.20-1.39'
                    WHEN odds < 1.60 THEN '1.40-1.59'
                    WHEN odds < 1.80 THEN '1.60-1.79'
                    WHEN odds < 2.00 THEN '1.80-1.99'
                    WHEN odds < 2.40 THEN '2.00-2.39'
                    WHEN odds < 3.00 THEN '2.40-2.99'
                    WHEN odds < 4.00 THEN '3.00-3.99'
                    WHEN odds < 5.00 THEN '4.00-4.99'
                    WHEN odds < 6.00 THEN '5.00-5.99'
                    WHEN odds < 8.00 THEN '6.00-7.99'
                    WHEN odds < 10.00 THEN '8.00-9.99'
                    ELSE '>= 10'
                END


            /* ----------------------------------------------------
               -3.5
               ---------------------------------------------------- */

            WHEN line = -3.5 THEN
                CASE
                    WHEN odds < 1.20 THEN '< 1.20'
                    WHEN odds < 1.40 THEN '1.20-1.39'
                    WHEN odds < 1.60 THEN '1.40-1.59'
                    WHEN odds < 1.80 THEN '1.60-1.79'
                    WHEN odds < 2.00 THEN '1.80-1.99'
                    WHEN odds < 2.40 THEN '2.00-2.39'
                    WHEN odds < 3.00 THEN '2.40-2.99'
                    WHEN odds < 4.00 THEN '3.00-3.99'
                    WHEN odds < 6.00 THEN '4.00-5.99'
                    WHEN odds < 10.00 THEN '6.00-9.99'
                    ELSE '>= 10'
                END

            ELSE 'UNKNOWN'

        END AS odds_band,


        /* ========================================================
           BAND ORDER
           ======================================================== */

        CASE

            WHEN line = -1.5 THEN
                CASE
                    WHEN odds < 1.20 THEN 1
                    WHEN odds < 1.40 THEN 2
                    WHEN odds < 1.60 THEN 3
                    WHEN odds < 1.80 THEN 4
                    WHEN odds < 2.00 THEN 5
                    WHEN odds < 2.20 THEN 6
                    WHEN odds < 2.40 THEN 7
                    WHEN odds < 2.60 THEN 8
                    WHEN odds < 2.80 THEN 9
                    WHEN odds < 3.00 THEN 10
                    WHEN odds < 3.50 THEN 11
                    WHEN odds < 4.00 THEN 12
                    WHEN odds < 5.00 THEN 13
                    WHEN odds < 6.00 THEN 14
                    WHEN odds < 8.00 THEN 15
                    WHEN odds < 10.00 THEN 16
                    WHEN odds < 15.00 THEN 17
                    ELSE 18
                END


            WHEN line = -2.5 THEN
                CASE
                    WHEN odds < 1.20 THEN 1
                    WHEN odds < 1.40 THEN 2
                    WHEN odds < 1.60 THEN 3
                    WHEN odds < 1.80 THEN 4
                    WHEN odds < 2.00 THEN 5
                    WHEN odds < 2.40 THEN 6
                    WHEN odds < 3.00 THEN 7
                    WHEN odds < 4.00 THEN 8
                    WHEN odds < 5.00 THEN 9
                    WHEN odds < 6.00 THEN 10
                    WHEN odds < 8.00 THEN 11
                    WHEN odds < 10.00 THEN 12
                    ELSE 13
                END


            WHEN line = -3.5 THEN
                CASE
                    WHEN odds < 1.20 THEN 1
                    WHEN odds < 1.40 THEN 2
                    WHEN odds < 1.60 THEN 3
                    WHEN odds < 1.80 THEN 4
                    WHEN odds < 2.00 THEN 5
                    WHEN odds < 2.40 THEN 6
                    WHEN odds < 3.00 THEN 7
                    WHEN odds < 4.00 THEN 8
                    WHEN odds < 6.00 THEN 9
                    WHEN odds < 10.00 THEN 10
                    ELSE 11
                END

            ELSE 0

        END AS band_order

    FROM normalized
)


/* ================================================================
   SONUÇ
   ================================================================ */

SELECT

    'ODDS_BAND' AS section,

    line,

    market,

    odds_band,

    band_order,

    count() AS matches,


    /* ============================================================
       GERÇEK MAÇ SONUCU DAĞILIMI

       +2_PLUS:
         seçilen takım 2 veya daha fazla farkla kazandı

       PLUS_1:
         seçilen takım 1 farkla kazandı

       DRAW:
         beraberlik

       MINUS_1:
         seçilen takım 1 farkla kaybetti

       MINUS_2_PLUS:
         seçilen takım 2 veya daha fazla farkla kaybetti
       ============================================================ */

    countIf(goal_difference >= 2) AS plus_2_plus,

    countIf(goal_difference = 1) AS plus_1,

    countIf(goal_difference = 0) AS draw,

    countIf(goal_difference = -1) AS minus_1,

    countIf(goal_difference <= -2) AS minus_2_plus,


    /* ============================================================
       ASIAN HANDICAP KAZANANLAR

       HOME -1.5:
         fark >= 2

       AWAY +1.5:
         fark >= -1

       Aynı mantık -2.5 ve -3.5 için de geçerlidir.
       ============================================================ */

    countIf(

        (
            market = 'HOME'
            AND goal_difference > abs(line)
        )

        OR

        (
            market = 'AWAY'
            AND goal_difference > -abs(line)
        )

    ) AS wins,


    /* ============================================================
       ASIAN HANDICAP KAYBEDENLER
       ============================================================ */

    countIf(

        NOT
        (
            (
                market = 'HOME'
                AND goal_difference > abs(line)
            )

            OR

            (
                market = 'AWAY'
                AND goal_difference > -abs(line)
            )
        )

    ) AS losses,


    /* ============================================================
       AH KAZANMA YÜZDESİ
       ============================================================ */

    round(

        countIf(

            (
                market = 'HOME'
                AND goal_difference > abs(line)
            )

            OR

            (
                market = 'AWAY'
                AND goal_difference > -abs(line)
            )

        ) * 100.0 / count(),

        2

    ) AS win_percentage,


    toFloat64(0) AS range_min,

    toFloat64(0) AS range_max


FROM bands

WHERE 1 = 1


/* ================================================================
   MANUEL AH LINE
   ================================================================ */

{% if defined(ah_line) %}
  AND line = {{Float64(ah_line)}}
{% end %}


/* ================================================================
   MANUEL MARKET
   ================================================================ */

{% if defined(market) %}
  AND market = upper({{String(market)}})
{% end %}


/* ================================================================
   MANUEL ORAN ARALIĞI
   ================================================================ */

{% if defined(range_min) %}
  AND odds >= {{Float64(range_min)}}
{% end %}

{% if defined(range_max) %}
  AND odds <= {{Float64(range_max)}}
{% end %}


GROUP BY
    line,
    market,
    odds_band,
    band_order


ORDER BY
    line,
    min(market_order),
    band_order

TYPE ENDPOINT
