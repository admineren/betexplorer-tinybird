DESCRIPTION >
    Asian Handicap odds distribution API.

    Kaynak:
    betexplorer_matches

    AH lines:
    -1.5
    -2.5
    -3.5

    Market:
    HOME
    AWAY

    Genel yapı:
    - GENERAL
    - ODDS_BAND
    - CUSTOM

    ODDS_BAND:
    - Her line icin farkli oran araliklari
    - HOME ve AWAY ayri analiz edilir
    - band_order ile dogru siralama yapilir
    - mac sayisi
    - yuzde
    - ortalama oran
    - minimum oran
    - maksimum oran

    CUSTOM:
    - line
    - side
    - range_min
    - range_max

    Filtreler:
    - country
    - league
    - season

    has_odds:
    Sabit olarak 'True' kullanilir.
    API parametresi degildir.


NODE odds_ah_query
SQL >

%

WITH base AS
(
    SELECT
        ah_line,

        if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
        ) AS ah_odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'

      AND ah_line IS NOT NULL

      AND ah_line = {{Float32(line, -1.5)}}

      AND upper({{String(side, 'HOME')}})
          IN ('HOME', 'AWAY')

      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) IS NOT NULL

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}
),

total AS
(
    SELECT
        count() AS total_matches
    FROM base
),

classified AS
(
    SELECT
        ah_line,
        ah_odds,

        /* =====================================================
           ODDS BAND
           ===================================================== */

        CASE

            /* =================================================
               -1.5
               ================================================= */

            WHEN ah_line = -1.5 THEN

                CASE
                    WHEN ah_odds < 1.20
                        THEN '< 1.20'

                    WHEN ah_odds < 1.40
                        THEN '1.20-1.39'

                    WHEN ah_odds < 1.60
                        THEN '1.40-1.59'

                    WHEN ah_odds < 1.80
                        THEN '1.60-1.79'

                    WHEN ah_odds < 2.00
                        THEN '1.80-1.99'

                    WHEN ah_odds < 2.20
                        THEN '2.00-2.19'

                    WHEN ah_odds < 2.40
                        THEN '2.20-2.39'

                    WHEN ah_odds < 2.60
                        THEN '2.40-2.59'

                    WHEN ah_odds < 2.80
                        THEN '2.60-2.79'

                    WHEN ah_odds < 3.00
                        THEN '2.80-2.99'

                    WHEN ah_odds < 3.50
                        THEN '3.00-3.49'

                    WHEN ah_odds < 4.00
                        THEN '3.50-3.99'

                    WHEN ah_odds < 5.00
                        THEN '4.00-4.99'

                    WHEN ah_odds < 6.00
                        THEN '5.00-5.99'

                    WHEN ah_odds < 8.00
                        THEN '6.00-7.99'

                    WHEN ah_odds < 10.00
                        THEN '8.00-9.99'

                    WHEN ah_odds < 15.00
                        THEN '10.00-14.99'

                    ELSE '>= 15'
                END


            /* =================================================
               -2.5
               ================================================= */

            WHEN ah_line = -2.5 THEN

                CASE
                    WHEN ah_odds < 1.20
                        THEN '< 1.20'

                    WHEN ah_odds < 1.40
                        THEN '1.20-1.39'

                    WHEN ah_odds < 1.60
                        THEN '1.40-1.59'

                    WHEN ah_odds < 1.80
                        THEN '1.60-1.79'

                    WHEN ah_odds < 2.00
                        THEN '1.80-1.99'

                    WHEN ah_odds < 2.40
                        THEN '2.00-2.39'

                    WHEN ah_odds < 3.00
                        THEN '2.40-2.99'

                    WHEN ah_odds < 4.00
                        THEN '3.00-3.99'

                    WHEN ah_odds < 5.00
                        THEN '4.00-4.99'

                    WHEN ah_odds < 6.00
                        THEN '5.00-5.99'

                    WHEN ah_odds < 8.00
                        THEN '6.00-7.99'

                    WHEN ah_odds < 10.00
                        THEN '8.00-9.99'

                    ELSE '>= 10'
                END


            /* =================================================
               -3.5
               ================================================= */

            WHEN ah_line = -3.5 THEN

                CASE
                    WHEN ah_odds < 1.20
                        THEN '< 1.20'

                    WHEN ah_odds < 1.40
                        THEN '1.20-1.39'

                    WHEN ah_odds < 1.60
                        THEN '1.40-1.59'

                    WHEN ah_odds < 1.80
                        THEN '1.60-1.79'

                    WHEN ah_odds < 2.00
                        THEN '1.80-1.99'

                    WHEN ah_odds < 2.40
                        THEN '2.00-2.39'

                    WHEN ah_odds < 3.00
                        THEN '2.40-2.99'

                    WHEN ah_odds < 4.00
                        THEN '3.00-3.99'

                    WHEN ah_odds < 6.00
                        THEN '4.00-5.99'

                    WHEN ah_odds < 10.00
                        THEN '6.00-9.99'

                    ELSE '>= 10'
                END

            ELSE 'UNKNOWN'

        END AS odds_band,


        /* =====================================================
           BAND ORDER
           ===================================================== */

        CASE

            /* =================================================
               -1.5
               ================================================= */

            WHEN ah_line = -1.5 THEN

                CASE
                    WHEN ah_odds < 1.20 THEN 1
                    WHEN ah_odds < 1.40 THEN 2
                    WHEN ah_odds < 1.60 THEN 3
                    WHEN ah_odds < 1.80 THEN 4
                    WHEN ah_odds < 2.00 THEN 5
                    WHEN ah_odds < 2.20 THEN 6
                    WHEN ah_odds < 2.40 THEN 7
                    WHEN ah_odds < 2.60 THEN 8
                    WHEN ah_odds < 2.80 THEN 9
                    WHEN ah_odds < 3.00 THEN 10
                    WHEN ah_odds < 3.50 THEN 11
                    WHEN ah_odds < 4.00 THEN 12
                    WHEN ah_odds < 5.00 THEN 13
                    WHEN ah_odds < 6.00 THEN 14
                    WHEN ah_odds < 8.00 THEN 15
                    WHEN ah_odds < 10.00 THEN 16
                    WHEN ah_odds < 15.00 THEN 17
                    ELSE 18
                END


            /* =================================================
               -2.5
               ================================================= */

            WHEN ah_line = -2.5 THEN

                CASE
                    WHEN ah_odds < 1.20 THEN 1
                    WHEN ah_odds < 1.40 THEN 2
                    WHEN ah_odds < 1.60 THEN 3
                    WHEN ah_odds < 1.80 THEN 4
                    WHEN ah_odds < 2.00 THEN 5
                    WHEN ah_odds < 2.40 THEN 6
                    WHEN ah_odds < 3.00 THEN 7
                    WHEN ah_odds < 4.00 THEN 8
                    WHEN ah_odds < 5.00 THEN 9
                    WHEN ah_odds < 6.00 THEN 10
                    WHEN ah_odds < 8.00 THEN 11
                    WHEN ah_odds < 10.00 THEN 12
                    ELSE 13
                END


            /* =================================================
               -3.5
               ================================================= */

            WHEN ah_line = -3.5 THEN

                CASE
                    WHEN ah_odds < 1.20 THEN 1
                    WHEN ah_odds < 1.40 THEN 2
                    WHEN ah_odds < 1.60 THEN 3
                    WHEN ah_odds < 1.80 THEN 4
                    WHEN ah_odds < 2.00 THEN 5
                    WHEN ah_odds < 2.40 THEN 6
                    WHEN ah_odds < 3.00 THEN 7
                    WHEN ah_odds < 4.00 THEN 8
                    WHEN ah_odds < 6.00 THEN 9
                    WHEN ah_odds < 10.00 THEN 10
                    ELSE 11
                END

            ELSE 0

        END AS band_order

    FROM base
),

band_stats AS
(
    SELECT
        odds_band,
        band_order,

        count() AS matches,

        round(
            count() * 100.0
            / any(total.total_matches),
            2
        ) AS percentage,

        round(
            avg(ah_odds),
            2
        ) AS avg_odds,

        min(ah_odds) AS min_odds,

        max(ah_odds) AS max_odds

    FROM classified

    CROSS JOIN total

    GROUP BY
        odds_band,
        band_order
)


/* =============================================================
   GENERAL
   ============================================================= */

SELECT
    'GENERAL' AS section,

    {{Float32(line, -1.5)}} AS line,

    upper({{String(side, 'HOME')}}) AS side,

    'ALL' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,

    toFloat64(100.00) AS percentage,

    round(avg(ah_odds), 2) AS avg_odds,

    min(ah_odds) AS min_odds,

    max(ah_odds) AS max_odds,

    toFloat64(0) AS range_min,

    toFloat64(0) AS range_max

FROM base


UNION ALL


/* =============================================================
   ODDS BAND
   ============================================================= */

SELECT
    'ODDS_BAND' AS section,

    {{Float32(line, -1.5)}} AS line,

    upper({{String(side, 'HOME')}}) AS side,

    odds_band,

    toUInt8(band_order) AS band_order,

    matches,

    percentage,

    avg_odds,

    min_odds,

    max_odds,

    toFloat64(0) AS range_min,

    toFloat64(0) AS range_max

FROM band_stats


/* =============================================================
   CUSTOM RANGE
   ============================================================= */

{% if defined(range_min) and defined(range_max) %}

UNION ALL

SELECT
    'CUSTOM' AS section,

    {{Float32(line, -1.5)}} AS line,

    upper({{String(side, 'HOME')}}) AS side,

    'CUSTOM_RANGE' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,

    round(
        count() * 100.0
        / any(total.total_matches),
        2
    ) AS percentage,

    round(avg(base.ah_odds), 2) AS avg_odds,

    min(base.ah_odds) AS min_odds,

    max(base.ah_odds) AS max_odds,

    toFloat64({{Float32(range_min)}}) AS range_min,

    toFloat64({{Float32(range_max)}}) AS range_max

FROM base

CROSS JOIN total

WHERE base.ah_odds >= {{Float32(range_min)}}
  AND base.ah_odds <= {{Float32(range_max)}}

{% end %}


/* =============================================================
   ORDER
   ============================================================= */

ORDER BY
    CASE
        WHEN section = 'GENERAL' THEN 0
        WHEN section = 'ODDS_BAND' THEN 1
        WHEN section = 'CUSTOM' THEN 2
        ELSE 9
    END,

    band_order


TYPE ENDPOINT
