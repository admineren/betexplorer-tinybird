    toFloat64(min(ah_home)) AS min_odds,

    toFloat64(max(ah_home)) AS max_odds,

    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND ah_line IS NOT NULL
  AND ah_line = toFloat32(-3.5)
  AND isNotNull(ah_home)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

{% if defined(line) %}
  AND {{Float32(line)}} = toFloat32(-3.5)
{% end %}

{% if defined(side) %}
  AND upper({{String(side)}}) = 'HOME'
{% end %}

GROUP BY
    odds_band,
    band_order


UNION ALL


/* ============================================================
   -3.5 AWAY
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,

    toFloat32(-3.5) AS line,

    'AWAY' AS side,

    CASE
        WHEN ah_away < 1.20 THEN '<1.20'
        WHEN ah_away < 1.40 THEN '1.20-1.39'
        WHEN ah_away < 1.60 THEN '1.40-1.59'
        WHEN ah_away < 1.80 THEN '1.60-1.79'
        WHEN ah_away < 2.00 THEN '1.80-1.99'
        WHEN ah_away < 2.40 THEN '2.00-2.39'
        WHEN ah_away < 3.00 THEN '2.40-2.99'
        WHEN ah_away < 4.00 THEN '3.00-3.99'
        WHEN ah_away < 6.00 THEN '4.00-5.99'
        WHEN ah_away < 10.00 THEN '6.00-9.99'
        ELSE '>=10'
    END AS odds_band,

    CASE
        WHEN ah_away < 1.20 THEN 1
        WHEN ah_away < 1.40 THEN 2
        WHEN ah_away < 1.60 THEN 3
        WHEN ah_away < 1.80 THEN 4
        WHEN ah_away < 2.00 THEN 5
        WHEN ah_away < 2.40 THEN 6
        WHEN ah_away < 3.00 THEN 7
        WHEN ah_away < 4.00 THEN 8
        WHEN ah_away < 6.00 THEN 9
        WHEN ah_away < 10.00 THEN 10
        ELSE 11
    END AS band_order,

    count() AS matches,

    round(
        count() * 100.0 / sum(count()) OVER (),
        2
    ) AS percentage,

    round(
        toFloat64(avg(ah_away)),
        2
    ) AS avg_odds,

    toFloat64(min(ah_away)) AS min_odds,

    toFloat64(max(ah_away)) AS max_odds,

    toFloat64(0) AS range_min,
    toFloat64(0) AS range_max

FROM betexplorer_matches

WHERE has_odds = 'True'
  AND ah_line IS NOT NULL
  AND ah_line = toFloat32(-3.5)
  AND isNotNull(ah_away)

{% if defined(country) %}
  AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
  AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
  AND season = {{String(season)}}
{% end %}

{% if defined(line) %}
  AND {{Float32(line)}} = toFloat32(-3.5)
{% end %}

{% if defined(side) %}
  AND upper({{String(side)}}) = 'AWAY'
{% end %}

GROUP BY
    odds_band,
    band_order


/* ============================================================
   CUSTOM DIRECT RANGE

   Required:
   line
   side
   range_min
   range_max
   ============================================================ */

{% if defined(line) %}
{% if defined(side) %}
{% if defined(range_min) %}
{% if defined(range_max) %}

UNION ALL

SELECT
    'CUSTOM' AS section,

    toFloat32({{Float32(line)}}) AS line,

    upper({{String(side)}}) AS side,

    'CUSTOM_RANGE' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,

    toFloat64(100.00) AS percentage,

    round(
        toFloat64(avg(ah_odds)),
        2
    ) AS avg_odds,

    toFloat64(min(ah_odds)) AS min_odds,

    toFloat64(max(ah_odds)) AS max_odds,

    toFloat64({{Float64(range_min)}}) AS range_min,

    toFloat64({{Float64(range_max)}}) AS range_max

FROM
(
    SELECT
        if(
            upper({{String(side)}}) = 'HOME',
            ah_home,
            ah_away
        ) AS ah_odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'

      AND ah_line IS NOT NULL

      AND ah_line =
          toFloat32({{Float32(line)}})

      AND upper({{String(side)}})
          IN ('HOME', 'AWAY')

      AND isNotNull(
          if(
              upper({{String(side)}}) = 'HOME',
              ah_home,
              ah_away
          )
      )

      AND if(
          upper({{String(side)}}) = 'HOME',
          ah_home,
          ah_away
      ) >= {{Float64(range_min)}}

      AND if(
          upper({{String(side)}}) = 'HOME',
          ah_home,
          ah_away
      ) <= {{Float64(range_max)}}

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}

) AS custom_data

{% end %}
{% end %}
{% end %}
{% end %}


/* ============================================================
   ORDER
   ============================================================ */

ORDER BY

    CASE
        WHEN section = 'GENERAL' THEN 0
        WHEN section = 'ODDS_BAND' THEN 1
        WHEN section = 'CUSTOM' THEN 2
        ELSE 9
    END,

    line,

    CASE
        WHEN side = 'HOME' THEN 1
        WHEN side = 'AWAY' THEN 2
        ELSE 0
    END,

    band_order

TYPE ENDPOINT
