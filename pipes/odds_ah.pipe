DESCRIPTION >
    Asian Handicap odds distribution API.

    Supported lines:
    -1.5
    -2.5
    -3.5

    Supported sides:
    HOME
    AWAY

    Filters:
    country
    league
    season

    Custom range:
    range_min
    range_max

    has_odds is fixed to 'True' and is not an API parameter.


NODE odds_ah_query
SQL >

%

/* ============================================================
   GENERAL
   ============================================================ */

SELECT
    'GENERAL' AS section,

    {{Float32(line, -1.5)}} AS line,

    upper({{String(side, 'HOME')}}) AS side,

    'ALL' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,

    toFloat64(100.00) AS percentage,

    round(avg(ah_odds), 2) AS avg_odds,

    min(ah_odds) AS min_odds,

    max(ah_odds) AS max_odds,

    toFloat64(0) AS range_min,

    toFloat64(0) AS range_max

FROM
(
    SELECT
        if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
        ) AS ah_odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'

      AND ah_line IS NOT NULL

      AND ah_line = {{Float32(line, -1.5)}}

      AND upper({{String(side, 'HOME')}})
          IN ('HOME', 'AWAY')

      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) IS NOT NULL

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}

) AS general_data


UNION ALL


/* ============================================================
   ODDS BANDS
   ============================================================ */

SELECT
    'ODDS_BAND' AS section,

    {{Float32(line, -1.5)}} AS line,

    upper({{String(side, 'HOME')}}) AS side,

    odds_band,

    band_order,

    matches,

    percentage,

    avg_odds,

    min_odds,

    max_odds,

    toFloat64(0) AS range_min,

    toFloat64(0) AS range_max

FROM
(
    SELECT

        /* ----------------------------------------------------
           ODDS BAND
           ---------------------------------------------------- */

        multiIf(

            /* =========================
               -1.5
               ========================= */

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.20,
                '<1.20',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.40,
                '1.20-1.39',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.60,
                '1.40-1.59',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.80,
                '1.60-1.79',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.00,
                '1.80-1.99',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.20,
                '2.00-2.19',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.40,
                '2.20-2.39',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.60,
                '2.40-2.59',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.80,
                '2.60-2.79',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 3.00,
                '2.80-2.99',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 3.50,
                '3.00-3.49',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 4.00,
                '3.50-3.99',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 5.00,
                '4.00-4.99',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 6.00,
                '5.00-5.99',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 8.00,
                '6.00-7.99',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 10.00,
                '8.00-9.99',

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 15.00,
                '10.00-14.99',

            {{Float32(line, -1.5)}} = -1.5,
                '>=15',


            /* =========================
               -2.5
               ========================= */

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.20,
                '<1.20',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.40,
                '1.20-1.39',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.60,
                '1.40-1.59',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.80,
                '1.60-1.79',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 2.00,
                '1.80-1.99',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 2.40,
                '2.00-2.39',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 3.00,
                '2.40-2.99',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 4.00,
                '3.00-3.99',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 5.00,
                '4.00-4.99',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 6.00,
                '5.00-5.99',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 8.00,
                '6.00-7.99',

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 10.00,
                '8.00-9.99',

            {{Float32(line, -1.5)}} = -2.5,
                '>=10',


            /* =========================
               -3.5
               ========================= */

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.20,
                '<1.20',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.40,
                '1.20-1.39',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.60,
                '1.40-1.59',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.80,
                '1.60-1.79',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 2.00,
                '1.80-1.99',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 2.40,
                '2.00-2.39',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 3.00,
                '2.40-2.99',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 4.00,
                '3.00-3.99',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 6.00,
                '4.00-5.99',

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 10.00,
                '6.00-9.99',

            {{Float32(line, -1.5)}} = -3.5,
                '>=10',

            'UNKNOWN'

        ) AS odds_band,


        /* ----------------------------------------------------
           BAND ORDER
           ---------------------------------------------------- */

        multiIf(

            /* -1.5 */

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.20, 1,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.40, 2,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.60, 3,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 1.80, 4,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.00, 5,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.20, 6,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.40, 7,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.60, 8,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 2.80, 9,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 3.00, 10,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 3.50, 11,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 4.00, 12,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 5.00, 13,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 6.00, 14,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 8.00, 15,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 10.00, 16,

            {{Float32(line, -1.5)}} = -1.5
            AND ah_odds < 15.00, 17,

            {{Float32(line, -1.5)}} = -1.5, 18,


            /* -2.5 */

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.20, 1,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.40, 2,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.60, 3,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 1.80, 4,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 2.00, 5,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 2.40, 6,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 3.00, 7,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 4.00, 8,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 5.00, 9,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 6.00, 10,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 8.00, 11,

            {{Float32(line, -1.5)}} = -2.5
            AND ah_odds < 10.00, 12,

            {{Float32(line, -1.5)}} = -2.5, 13,


            /* -3.5 */

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.20, 1,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.40, 2,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.60, 3,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 1.80, 4,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 2.00, 5,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 2.40, 6,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 3.00, 7,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 4.00, 8,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 6.00, 9,

            {{Float32(line, -1.5)}} = -3.5
            AND ah_odds < 10.00, 10,

            {{Float32(line, -1.5)}} = -3.5, 11,

            0

        ) AS band_order,

        ah_odds

    FROM
    (
        SELECT
            if(
                upper({{String(side, 'HOME')}}) = 'HOME',
                ah_home,
                ah_away
            ) AS ah_odds

        FROM betexplorer_matches

        WHERE has_odds = 'True'

          AND ah_line IS NOT NULL

          AND ah_line = {{Float32(line, -1.5)}}

          AND upper({{String(side, 'HOME')}})
              IN ('HOME', 'AWAY')

          AND if(
                upper({{String(side, 'HOME')}}) = 'HOME',
                ah_home,
                ah_away
              ) IS NOT NULL

{% if defined(country) %}
          AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
          AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
          AND season = {{String(season)}}
{% end %}

    ) AS source_data

) AS classified_data

GROUP BY
    odds_band,
    band_order

ORDER BY
    band_order


{% if defined(range_min) and defined(range_max) %}

UNION ALL


/* ============================================================
   CUSTOM RANGE
   ============================================================ */

SELECT
    'CUSTOM' AS section,

    {{Float32(line, -1.5)}} AS line,

    upper({{String(side, 'HOME')}}) AS side,

    'CUSTOM_RANGE' AS odds_band,

    toUInt8(0) AS band_order,

    count() AS matches,

    toFloat64(100.00) AS percentage,

    round(avg(ah_odds), 2) AS avg_odds,

    min(ah_odds) AS min_odds,

    max(ah_odds) AS max_odds,

    {{Float32(range_min)}} AS range_min,

    {{Float32(range_max)}} AS range_max

FROM
(
    SELECT
        if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
        ) AS ah_odds

    FROM betexplorer_matches

    WHERE has_odds = 'True'

      AND ah_line IS NOT NULL

      AND ah_line = {{Float32(line, -1.5)}}

      AND upper({{String(side, 'HOME')}})
          IN ('HOME', 'AWAY')

      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) IS NOT NULL

{% if defined(country) %}
      AND country = {{String(country)}}
{% end %}

{% if defined(league) %}
      AND league = {{String(league)}}
{% end %}

{% if defined(season) %}
      AND season = {{String(season)}}
{% end %}

      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) >= {{Float32(range_min)}}

      AND if(
            upper({{String(side, 'HOME')}}) = 'HOME',
            ah_home,
            ah_away
          ) <= {{Float32(range_max)}}

) AS custom_data

{% end %}


TYPE ENDPOINT
