DESCRIPTION >
  Asian Handicap oran band analizi.

  Kaynak:
  betexplorer_matches

  AH line:
  -1.5
  -2.5
  -3.5

  Her line icin:
  - HOME
  - AWAY

  Standart filtreler:
  - country
  - league
  - season

  Manuel filtreler:
  - ah_line
  - market
  - range_min
  - range_max

  has_odds = 'True' SQL icinde sabittir.

  Genel sonuc:
  - oran araligi
  - mac sayisi
  - yuzde
  - ortalama oran
  - minimum oran
  - maksimum oran

  Siralama:
  - line ASC
  - HOME
  - AWAY
  - band_order ASC
  - CUSTOM son


NODE odds_ah_query
SQL >
%

WITH filtered AS
(
    /* ============================================================
       HOME
       ============================================================ */

    SELECT
        ah_line,
        ah_home AS odds,
        'HOME' AS market

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_line)
      AND isNotNull(ah_home)
      AND toFloat64(ah_line) IN (-1.5, -2.5, -3.5)

    {% if defined(country) %}
      AND country = {{String(country)}}
    {% end %}

    {% if defined(league) %}
      AND league = {{String(league)}}
    {% end %}

    {% if defined(season) %}
      AND season = {{String(season)}}
    {% end %}


    UNION ALL


    /* ============================================================
       AWAY
       ============================================================ */

    SELECT
        ah_line,
        ah_away AS odds,
        'AWAY' AS market

    FROM betexplorer_matches

    WHERE has_odds = 'True'
      AND isNotNull(ah_line)
      AND isNotNull(ah_away)
      AND toFloat64(ah_line) IN (-1.5, -2.5, -3.5)

    {% if defined(country) %}
      AND country = {{String(country)}}
    {% end %}

    {% if defined(league) %}
      AND league = {{String(league)}}
    {% end %}

    {% if defined(season) %}
      AND season = {{String(season)}}
    {% end %}
)


/* ================================================================
   GENEL ORAN DAGILIMI
   ================================================================ */

SELECT

    'ODDS_BAND' AS section,

    market,

    toFloat64(ah_line) AS line,


    /* ============================================================
       ORAN ARALIGI
       ============================================================ */

    multiIf(

        /* --------------------------------------------------------
           -1.5
           -------------------------------------------------------- */

        toFloat64(ah_line) = -1.5
            AND odds < 1.20,
            '<1.20',

        toFloat64(ah_line) = -1.5
            AND odds < 1.40,
            '1.20-1.39',

        toFloat64(ah_line) = -1.5
            AND odds < 1.60,
            '1.40-1.59',

        toFloat64(ah_line) = -1.5
            AND odds < 1.80,
            '1.60-1.79',

        toFloat64(ah_line) = -1.5
            AND odds < 2.00,
            '1.80-1.99',

        toFloat64(ah_line) = -1.5
            AND odds < 2.20,
            '2.00-2.19',

        toFloat64(ah_line) = -1.5
            AND odds < 2.40,
            '2.20-2.39',

        toFloat64(ah_line) = -1.5
            AND odds < 2.60,
            '2.40-2.59',

        toFloat64(ah_line) = -1.5
            AND odds < 2.80,
            '2.60-2.79',

        toFloat64(ah_line) = -1.5
            AND odds < 3.00,
            '2.80-2.99',

        toFloat64(ah_line) = -1.5
            AND odds < 3.50,
            '3.00-3.49',

        toFloat64(ah_line) = -1.5
            AND odds < 4.00,
            '3.50-3.99',

        toFloat64(ah_line) = -1.5
            AND odds < 5.00,
            '4.00-4.99',

        toFloat64(ah_line) = -1.5
            AND odds < 6.00,
            '5.00-5.99',

        toFloat64(ah_line) = -1.5
            AND odds < 8.00,
            '6.00-7.99',

        toFloat64(ah_line) = -1.5
            AND odds < 10.00,
            '8.00-9.99',

        toFloat64(ah_line) = -1.5
            AND odds < 15.00,
            '10.00-14.99',

        toFloat64(ah_line) = -1.5,
            '>=15',


        /* --------------------------------------------------------
           -2.5
           -------------------------------------------------------- */

        toFloat64(ah_line) = -2.5
            AND odds < 1.20,
            '<1.20',

        toFloat64(ah_line) = -2.5
            AND odds < 1.40,
            '1.20-1.39',

        toFloat64(ah_line) = -2.5
            AND odds < 1.60,
            '1.40-1.59',

        toFloat64(ah_line) = -2.5
            AND odds < 1.80,
            '1.60-1.79',

        toFloat64(ah_line) = -2.5
            AND odds < 2.00,
            '1.80-1.99',

        toFloat64(ah_line) = -2.5
            AND odds < 2.40,
            '2.00-2.39',

        toFloat64(ah_line) = -2.5
            AND odds < 3.00,
            '2.40-2.99',

        toFloat64(ah_line) = -2.5
            AND odds < 4.00,
            '3.00-3.99',

        toFloat64(ah_line) = -2.5
            AND odds < 5.00,
            '4.00-4.99',

        toFloat64(ah_line) = -2.5
            AND odds < 6.00,
            '5.00-5.99',

        toFloat64(ah_line) = -2.5
            AND odds < 8.00,
            '6.00-7.99',

        toFloat64(ah_line) = -2.5
            AND odds < 10.00,
            '8.00-9.99',

        toFloat64(ah_line) = -2.5,
            '>=10',


        /* --------------------------------------------------------
           -3.5
           -------------------------------------------------------- */

        toFloat64(ah_line) = -3.5
            AND odds < 1.20,
            '<1.20',

        toFloat64(ah_line) = -3.5
            AND odds < 1.40,
            '1.20-1.39',

        toFloat64(ah_line) = -3.5
            AND odds < 1.60,
            '1.40-1.59',

        toFloat64(ah_line) = -3.5
            AND odds < 1.80,
            '1.60-1.79',

        toFloat64(ah_line) = -3.5
            AND odds < 2.00,
            '1.80-1.99',

        toFloat64(ah_line) = -3.5
            AND odds < 2.40,
            '2.00-2.39',

        toFloat64(ah_line) = -3.5
            AND odds < 3.00,
            '2.40-2.99',

        toFloat64(ah_line) = -3.5
            AND odds < 4.00,
            '3.00-3.99',

        toFloat64(ah_line) = -3.5
            AND odds < 6.00,
            '4.00-5.99',

        toFloat64(ah_line) = -3.5
            AND odds < 10.00,
            '6.00-9.99',

        '>=10'
    ) AS odds_band,


    /* ============================================================
       BAND ORDER
       ============================================================ */

    multiIf(

        /* --------------------------------------------------------
           -1.5
           -------------------------------------------------------- */

        toFloat64(ah_line) = -1.5 AND odds < 1.20, 1,
        toFloat64(ah_line) = -1.5 AND odds < 1.40, 2,
        toFloat64(ah_line) = -1.5 AND odds < 1.60, 3,
        toFloat64(ah_line) = -1.5 AND odds < 1.80, 4,
        toFloat64(ah_line) = -1.5 AND odds < 2.00, 5,
        toFloat64(ah_line) = -1.5 AND odds < 2.20, 6,
        toFloat64(ah_line) = -1.5 AND odds < 2.40, 7,
        toFloat64(ah_line) = -1.5 AND odds < 2.60, 8,
        toFloat64(ah_line) = -1.5 AND odds < 2.80, 9,
        toFloat64(ah_line) = -1.5 AND odds < 3.00, 10,
        toFloat64(ah_line) = -1.5 AND odds < 3.50, 11,
        toFloat64(ah_line) = -1.5 AND odds < 4.00, 12,
        toFloat64(ah_line) = -1.5 AND odds < 5.00, 13,
        toFloat64(ah_line) = -1.5 AND odds < 6.00, 14,
        toFloat64(ah_line) = -1.5 AND odds < 8.00, 15,
        toFloat64(ah_line) = -1.5 AND odds < 10.00, 16,
        toFloat64(ah_line) = -1.5 AND odds < 15.00, 17,
        toFloat64(ah_line) = -1.5, 18,


        /* --------------------------------------------------------
           -2.5
           -------------------------------------------------------- */

        toFloat64(ah_line) = -2.5 AND odds < 1.20, 1,
        toFloat64(ah_line) = -2.5 AND odds < 1.40, 2,
        toFloat64(ah_line) = -2.5 AND odds < 1.60, 3,
        toFloat64(ah_line) = -2.5 AND odds < 1.80, 4,
        toFloat64(ah_line) = -2.5 AND odds < 2.00, 5,
        toFloat64(ah_line) = -2.5 AND odds < 2.40, 6,
        toFloat64(ah_line) = -2.5 AND odds < 3.00, 7,
        toFloat64(ah_line) = -2.5 AND odds < 4.00, 8,
        toFloat64(ah_line) = -2.5 AND odds < 5.00, 9,
        toFloat64(ah_line) = -2.5 AND odds < 6.00, 10,
        toFloat64(ah_line) = -2.5 AND odds < 8.00, 11,
        toFloat64(ah_line) = -2.5 AND odds < 10.00, 12,
        toFloat64(ah_line) = -2.5, 13,


        /* --------------------------------------------------------
           -3.5
           -------------------------------------------------------- */

        toFloat64(ah_line) = -3.5 AND odds < 1.20, 1,
        toFloat64(ah_line) = -3.5 AND odds < 1.40, 2,
        toFloat64(ah_line) = -3.5 AND odds < 1.60, 3,
        toFloat64(ah_line) = -3.5 AND odds < 1.80, 4,
        toFloat64(ah_line) = -3.5 AND odds < 2.00, 5,
        toFloat64(ah_line) = -3.5 AND odds < 2.40, 6,
        toFloat64(ah_line) = -3.5 AND odds < 3.00, 7,
        toFloat64(ah_line) = -3.5 AND odds < 4.00, 8,
        toFloat64(ah_line) = -3.5 AND odds < 6.00, 9,
        toFloat64(ah_line) = -3.5 AND odds < 10.00, 10,
        toFloat64(ah_line) = -3.5, 11,

        0

    ) AS band_order,


    /* ============================================================
       ISTATISTIKLER
       ============================================================ */

    count() AS matches,

    round(
        count() * 100.0
        /
        sum(count()) OVER
        (
            PARTITION BY ah_line, market
        ),
        2
    ) AS percentage,

    round(avg(odds), 2) AS avg_odds,

    min(odds) AS min_odds,

    max(odds) AS max_odds


FROM filtered

WHERE odds IS NOT NULL

{% if defined(ah_line) %}
  AND toFloat64(ah_line) = {{Float64(ah_line)}}
{% end %}

{% if defined(market) %}
  AND market = upper({{String(market)}})
{% end %}

GROUP BY
    ah_line,
    market,
    odds_band,
    band_order


/* ================================================================
   MANUEL ORAN ARALIGI
   ================================================================ */

{% if defined(ah_line) and defined(market) and defined(range_min) and defined(range_max) %}

UNION ALL

SELECT

    'CUSTOM' AS section,

    upper({{String(market)}}) AS market,

    {{Float64(ah_line)}} AS line,

    'CUSTOM_RANGE' AS odds_band,

    0 AS band_order,

    count() AS matches,

    round(
        count() * 100.0
        /
        (
            SELECT count()
            FROM filtered AS total_rows
            WHERE toFloat64(total_rows.ah_line)
                    = {{Float64(ah_line)}}

              AND total_rows.market
                    = upper({{String(market)}})

              AND total_rows.odds IS NOT NULL
        ),
        2
    ) AS percentage,

    round(avg(odds), 2) AS avg_odds,

    min(odds) AS min_odds,

    max(odds) AS max_odds


FROM filtered

WHERE toFloat64(ah_line)
        = {{Float64(ah_line)}}

  AND market
        = upper({{String(market)}})

  AND odds >= {{Float64(range_min)}}

  AND odds <= {{Float64(range_max)}}

{% end %}


/* ================================================================
   FINAL SIRALAMA
   ================================================================ */

ORDER BY

    /* Önce normal bantlar, sonra CUSTOM */
    multiIf(
        section = 'ODDS_BAND', 1,
        section = 'CUSTOM', 2,
        3
    ) ASC,

    /* -1.5 -> -2.5 -> -3.5 */
    line ASC,

    /* HOME -> AWAY */
    multiIf(
        market = 'HOME', 1,
        market = 'AWAY', 2,
        3
    ) ASC,

    /* Oran bantlarının kendi sırası */
    band_order ASC


TYPE ENDPOINT
