DESCRIPTION >
    Lig bazında HT/FT sürpriz maçlarını getirir.

    Sadece:
    - H/A = ilk yarı ev sahibi önde,
            maç sonunda deplasman kazanmış
            (1/2)

    - A/H = ilk yarı deplasman önde,
            maç sonunda ev sahibi kazanmış
            (2/1)

    Maçın kapanış oranlarını da döndürür.

    Dönen bilgiler:
    - Tarih
    - Saat
    - Ülke
    - Lig
    - Sezon
    - Ev sahibi
    - Deplasman
    - İlk yarı skoru
    - Maç sonu skoru
    - HT/FT
    - 1X2 oranları
    - O/U 1.5
    - O/U 2.5
    - O/U 3.5
    - O/U 4.5
    - BTTS
    - Asian Handicap

    Filtreler:
    country
    league
    season

    Limit:
    Gösterilecek maksimum maç sayısı.
    Varsayılan 20'dir.


NODE league_htft_surprises_query
SQL >
    %

    SELECT

        /* =====================================================
           MAÇ BİLGİLERİ
           ===================================================== */

        toString(date) AS date,

        toString(time) AS time,

        country,
        league,
        season,

        home_team,
        away_team,


        /* =====================================================
           İLK YARI
           ===================================================== */

        ht_home,
        ht_away,


        /* =====================================================
           MAÇ SONU
           ===================================================== */

        ft_home,
        ft_away,


        /* =====================================================
           HT / FT
           ===================================================== */

        ht_ft,


        /* =====================================================
           1X2
           ===================================================== */

        home_odds,
        draw_odds,
        away_odds,


        /* =====================================================
           OVER / UNDER 1.5
           ===================================================== */

        ou1_5_over,
        ou1_5_under,


        /* =====================================================
           OVER / UNDER 2.5
           ===================================================== */

        ou2_5_over,
        ou2_5_under,


        /* =====================================================
           OVER / UNDER 3.5
           ===================================================== */

        ou3_5_over,
        ou3_5_under,


        /* =====================================================
           OVER / UNDER 4.5
           ===================================================== */

        ou4_5_over,
        ou4_5_under,


        /* =====================================================
           BTTS
           ===================================================== */

        btts_yes,
        btts_no,


        /* =====================================================
           ASIAN HANDICAP
           ===================================================== */

        ah_line,
        ah_home,
        ah_away


    FROM betexplorer_matches


    WHERE

        /* =====================================================
           LİG FİLTRESİ
           ===================================================== */

        country = {{String(country)}}

        AND league = {{String(league)}}


        /* =====================================================
           TAMAMLANMIŞ MAÇ
           ===================================================== */

        AND ft_home IS NOT NULL
        AND ft_away IS NOT NULL

        AND ht_home IS NOT NULL
        AND ht_away IS NOT NULL


        /* =====================================================
           ORANLI MAÇLAR
           ===================================================== */

        AND has_odds = 'True'


        /* =====================================================
           HT / FT SÜRPRİZLERİ

           H/A = 1/2
           A/H = 2/1
           ===================================================== */

        AND ht_ft IN ('H/A', 'A/H')


        /* =====================================================
           OPSİYONEL SEZON
           ===================================================== */

        {% if defined(season) %}
        AND season = {{String(season)}}
        {% end %}


    ORDER BY

        date DESC,
        time DESC


    LIMIT
        {{Int32(limit, 20)}}


TYPE ENDPOINT
