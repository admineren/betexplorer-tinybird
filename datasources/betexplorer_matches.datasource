SCHEMA >
    `match_id` String,
    `country` String,
    `league` String,
    `season` String,
    `home_team` String,
    `away_team` String,
    `date` Date,
    `time` String,
    `ht_home` Nullable(Int16),
    `ht_away` Nullable(Int16),
    `ft_home` Int16,
    `ft_away` Int16,
    `ht_total_goals` Nullable(Int16),
    `ft_total_goals` Int16,
    `goal_diff` Int16,
    `result` String,
    `ht_ft` Nullable(String),
    `has_odds` String,
    `bookmaker_1x2` Nullable(String),
    `home_odds` Nullable(Float32),
    `draw_odds` Nullable(Float32),
    `away_odds` Nullable(Float32),
    `bookmaker_ou1_5` Nullable(String),
    `ou1_5_over` Nullable(Float32),
    `ou1_5_under` Nullable(Float32),
    `bookmaker_ou2_5` Nullable(String),
    `ou2_5_over` Nullable(Float32),
    `ou2_5_under` Nullable(Float32),
    `bookmaker_ou3_5` Nullable(String),
    `ou3_5_over` Nullable(Float32),
    `ou3_5_under` Nullable(Float32),
    `bookmaker_ou4_5` Nullable(String),
    `ou4_5_over` Nullable(Float32),
    `ou4_5_under` Nullable(Float32),
    `bookmaker_btts` Nullable(String),
    `btts_yes` Nullable(Float32),
    `btts_no` Nullable(Float32),
    `bookmaker_ah` Nullable(String),
    `ah_line` Nullable(Float32),
    `ah_home` Nullable(Float32),
    `ah_away` Nullable(Float32)

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(date)"
ENGINE_SORTING_KEY "country, league, season, date, match_id"

FORWARD_QUERY >
    SELECT
        match_id,
        country,
        league,
        CAST(season, 'String') AS season,
        home_team,
        away_team,
        date,
        time,
        ht_home,
        ht_away,
        ft_home,
        ft_away,
        ht_total_goals,
        ft_total_goals,
        goal_diff,
        result,
        ht_ft,
        has_odds,
        bookmaker_1x2,
        home_odds,
        draw_odds,
        away_odds,
        bookmaker_ou1_5,
        ou1_5_over,
        ou1_5_under,
        bookmaker_ou2_5,
        ou2_5_over,
        ou2_5_under,
        bookmaker_ou3_5,
        ou3_5_over,
        ou3_5_under,
        bookmaker_ou4_5,
        ou4_5_over,
        ou4_5_under,
        bookmaker_btts,
        btts_yes,
        btts_no,
        bookmaker_ah,
        ah_line,
        ah_home,
        ah_away
