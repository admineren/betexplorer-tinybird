SCHEMA >
    `match_id` String,
    `country` String,
    `league` String,
    `season` Int32,
    `home_team` String,
    `away_team` String,
    `date` Date,
    `time` String,
    `ht_home` Nullable(Int16),
    `ht_away` Nullable(Int16),
    `ft_home` Int16,
    `ft_away` Int16,
    `ht_total_goals` Nullable(Int16),
    `ft_total_goals` Int16,
    `goal_diff` Int16,
    `result` String,
    `ht_ft` Nullable(String),
    `has_odds` String,
    `bookmaker_1x2` Nullable(String),
    `home_odds` Nullable(Float32),
    `draw_odds` Nullable(Float32),
    `away_odds` Nullable(Float32),
    `bookmaker_ou1.5` Nullable(String),
    `ou1.5_over` Nullable(Float32),
    `ou1.5_under` Nullable(Float32),
    `bookmaker_ou2.5` Nullable(String),
    `ou2.5_over` Nullable(Float32),
    `ou2.5_under` Nullable(Float32),
    `bookmaker_ou3.5` Nullable(String),
    `ou3.5_over` Nullable(Float32),
    `ou3.5_under` Nullable(Float32),
    `bookmaker_ou4.5` Nullable(String),
    `ou4.5_over` Nullable(Float32),
    `ou4.5_under` Nullable(Float32),
    `bookmaker_btts` Nullable(String),
    `btts_yes` Nullable(Float32),
    `btts_no` Nullable(Float32),
    `bookmaker_ah` Nullable(String),
    `ah_line` Nullable(Float32),
    `ah_home` Nullable(Float32),
    `ah_away` Nullable(Float32)

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(date)"
ENGINE_SORTING_KEY "country, league, season, date, match_id"
